+    rebuild_entity_projections,
+    rebuild_profile_projections,
+    record_effective_access,
+    record_retrieval,
+    retry_pending_mutations,
+    sync_memory_catalog,
+)
+from models import (
+    EntityAliasProjection,
+    EntityProjection,
+    MemoryAccess,
+    MemoryActivity,
+    MemoryCandidate,
+    MemoryCatalog,
+    MemoryFeedback,
+    MemoryMutation,
+    MemoryOperation,
+    MemoryRelation,
+    ProfileProjection,
+    RetrievalEvent,
+    Settings,
+    User,
+)
+from platform_service import (
+    assert_project_access,
+    detect_memory_conflicts,
+    hybrid_search,
+    protect_sensitive_value,
+    scan_sensitive_text,
+    scope_filters_for_user,
+)
+from pydantic import BaseModel, Field, field_validator
+from server_state import get_memory_instance
+from sqlalchemy import func, select, text
+from sqlalchemy.orm import Session
+
+
+@asynccontextmanager
+async def governance_lifespan(_app):
+    await start_dream_scheduler()
+    try:
+        yield
+    finally:
+        await stop_dream_scheduler()
+
+
+router = APIRouter(
+    prefix="/governance",
+    tags=["memory-governance"],
+    lifespan=governance_lifespan,
+)
+SCAN_LIMIT = 5000
+OPERATION_TTL_MINUTES = 30
+DREAM_SCHEDULER_LOCK = "mem0-dream-scheduler"
+try:
+    DREAM_POLL_SECONDS = max(60, int(os.getenv("MEM0_DREAM_POLL_SECONDS", "300")))
+except ValueError:
+    DREAM_POLL_SECONDS = 300
+    logging.warning("MEM0_DREAM_POLL_SECONDS 无效，已使用 300 秒")
+DREAM_SCHEDULER_TASK: asyncio.Task[None] | None = None
+RESERVED_PAYLOAD_FIELDS = {
+    "id",
+    "memory",
+    "data",
+    "user_id",
+    "agent_id",
+    "run_id",
+    "actor_id",
+    "role",
+    "hash",
+    "created_at",
+    "updated_at",
+    "expiration_date",
+    "text_lemmatized",
+    "score",
+    "metadata",
+}
+
+
+def _utcnow() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def _actor_id(user: User) -> uuid.UUID | None:
+    return None if user.id.int == 0 else user.id
+
+
+def _parse_datetime(value: str | None) -> datetime | None:
+    if not value:
+        return None
+    try:
+        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    if parsed.tzinfo is None:
+        parsed = parsed.replace(tzinfo=timezone.utc)
+    return parsed.astimezone(timezone.utc)
+
+
+def _memory_version(item: dict[str, Any]) -> str:
+    payload = {
+        "id": item.get("id"),
+        "memory": item.get("memory") or item.get("data"),
+        "metadata": _metadata(item),
+        "expiration_date": item.get("expiration_date"),
+        "created_at": item.get("created_at"),
+        "updated_at": item.get("updated_at"),
+    }
+    encoded = json.dumps(payload, ensure_ascii=False, sort_keys=True, default=str, separators=(",", ":"))
+    return hashlib.sha256(encoded.encode("utf-8")).hexdigest()
+
+
+def _metadata(item: dict[str, Any]) -> dict[str, Any]:
+    value = item.get("metadata")
+    metadata = dict(value) if isinstance(value, dict) else {}
+    for key, item_value in item.items():
+        if key not in RESERVED_PAYLOAD_FIELDS:
+            metadata.setdefault(key, item_value)
+    return metadata
+
+
+def _serialize_row(row: Any) -> dict[str, Any]:
+    payload = dict(getattr(row, "payload", None) or {})
+    metadata = {key: value for key, value in payload.items() if key not in RESERVED_PAYLOAD_FIELDS}
+    return {
+        "id": str(getattr(row, "id", "")),
+        "memory": payload.get("data", ""),
+        "user_id": payload.get("user_id"),
+        "agent_id": payload.get("agent_id"),
+        "run_id": payload.get("run_id"),
+        "actor_id": payload.get("actor_id"),
+        "role": payload.get("role"),
+        "hash": payload.get("hash"),
+        "expiration_date": payload.get("expiration_date"),
+        "created_at": payload.get("created_at"),
+        "updated_at": payload.get("updated_at"),
+        "metadata": metadata,
+    }
+
+
+def _list_rows(limit: int = SCAN_LIMIT) -> list[Any]:
+    listed = get_memory_instance().vector_store.list(top_k=limit)
+    if listed and isinstance(listed, (list, tuple)) and isinstance(listed[0], (list, tuple)):
+        return list(listed[0])
+    return list(listed or [])
+
+
+def _get_memory(memory_id: str) -> dict[str, Any] | None:
+    item = get_memory_instance().get(memory_id)
+    return item if isinstance(item, dict) else None
+
+
+@contextmanager
+def _memory_lock(memory_id: str):
+    from db import SessionLocal
+
+    with SessionLocal() as lock_db, lock_db.begin():
+        lock_db.execute(
+            text("SELECT pg_advisory_xact_lock(hashtextextended(:memory_id, 0))"),
+            {"memory_id": memory_id},
+        )
+        yield
+
+
+def _metadata_matches(actual: dict[str, Any], expected: dict[str, Any]) -> bool:
+    for key, condition in expected.items():
+        value = actual.get(key)
+        if isinstance(condition, dict):
+            for operator, operand in condition.items():
+                if operator == "eq" and value != operand:
+                    return False
+                if operator == "ne" and value == operand:
+                    return False
+                if operator == "contains":
+                    if isinstance(value, list) and operand not in value:
+                        return False
+                    if isinstance(value, str) and str(operand) not in value:
+                        return False
+                    if not isinstance(value, (list, str)):
+                        return False
+                if operator == "icontains" and str(operand).casefold() not in str(value or "").casefold():
+                    return False
+                if operator == "in" and value not in operand:
+                    return False
+                if operator == "nin" and value in operand:
+                    return False
+        elif value != condition:
+            return False
+    return True
+
