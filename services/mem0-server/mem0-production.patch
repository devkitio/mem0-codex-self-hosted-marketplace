+def _utcnow() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def _actor_id(user: User | None) -> uuid.UUID | None:
+    if user is None or not isinstance(user.id, uuid.UUID) or user.id.int == 0:
+        return None
+    return user.id
+
+
+def serialize_memory_row(row: Any) -> dict[str, Any]:
+    payload = dict(getattr(row, "payload", None) or {})
+    return {
+        "id": str(getattr(row, "id", "")),
+        "memory": payload.get("data", ""),
+        "user_id": payload.get("user_id"),
+        "agent_id": payload.get("agent_id"),
+        "run_id": payload.get("run_id"),
+        "expiration_date": payload.get("expiration_date"),
+        "metadata": {key: value for key, value in payload.items() if key not in _RESERVED_PAYLOAD_KEYS},
+        "created_at": payload.get("created_at"),
+        "updated_at": payload.get("updated_at"),
+    }
+
+
+def list_memory_items(limit: int = MAX_BACKUP_ITEMS) -> list[dict[str, Any]]:
+    listed = get_memory_instance().vector_store.list(top_k=min(max(limit, 1), MAX_BACKUP_ITEMS + 1))
+    rows = (
+        listed[0] if listed and isinstance(listed, (list, tuple)) and isinstance(listed[0], (list, tuple)) else listed
+    )
+    return [serialize_memory_row(row) for row in rows or []]
+
+
+def _search_item_from_output(row: Any) -> dict[str, Any]:
+    item = serialize_memory_row(row)
+    item["score"] = float(getattr(row, "score", 0.0) or 0.0)
+    return item
+
+
+def _is_expired(item: dict[str, Any]) -> bool:
+    raw_expiration = item.get("expiration_date")
+    if not raw_expiration:
+        return False
+    try:
+        expiration = datetime.fromisoformat(str(raw_expiration).replace("Z", "+00:00"))
+    except ValueError:
+        return False
+    if expiration.tzinfo is None:
+        expiration = expiration.replace(tzinfo=timezone.utc)
+    return expiration.astimezone(timezone.utc) <= _utcnow()
+
+
+def _pure_vector_results(
+    query: str,
+    filters: dict[str, Any],
+    limit: int,
+    threshold: float,
+    *,
+    show_expired: bool,
+) -> list[dict[str, Any]]:
+    memory = get_memory_instance()
+    vector = memory.embedding_model.embed(query, "search")
+    output = memory.vector_store.search(query=query, vectors=vector, top_k=limit, filters=filters) or []
+    results: list[dict[str, Any]] = []
+    for row in output:
+        item = _search_item_from_output(row)
+        semantic_score = float(item.get("score") or 0.0)
+        if semantic_score < threshold or (not show_expired and _is_expired(item)):
+            continue
+        item["semantic_score"] = semantic_score
+        results.append(item)
+    return results
+
+
+def _pure_keyword_results(
+    query: str,
+    filters: dict[str, Any],
+    limit: int,
+    *,
+    show_expired: bool,
+) -> list[dict[str, Any]]:
+    memory = get_memory_instance()
+    keyword_method = getattr(memory.vector_store, "keyword_search", None)
+    if not callable(keyword_method):
+        return []
+    output = keyword_method(lemmatize_for_bm25(query), top_k=limit, filters=filters) or []
+    results = []
+    for row in output:
+        item = _search_item_from_output(row)
+        if not show_expired and _is_expired(item):
+            continue
+        item["keyword_score"] = float(item.get("score") or 0.0)
+        results.append(item)
+    return results
+
