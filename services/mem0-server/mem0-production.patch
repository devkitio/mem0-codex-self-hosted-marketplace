+    if dataset.is_baseline and case_count < MIN_BASELINE_CASES:
+        raise HTTPException(
+            status_code=409,
+            detail=f"基线评测数据集至少需要 {MIN_BASELINE_CASES} 条用例",
+        )
+    if body.baseline_run_id:
+        baseline = db.get(SearchEvaluationRun, body.baseline_run_id)
+        if baseline is None or baseline.status != "completed":
+            raise HTTPException(status_code=409, detail="基线评测运行不存在或未完成")
+        if baseline.dataset_id != body.dataset_id or baseline.mode != body.mode:
+            raise HTTPException(status_code=409, detail="基线与当前运行必须使用相同数据集版本和检索模式")
+    row = SearchEvaluationRun(
