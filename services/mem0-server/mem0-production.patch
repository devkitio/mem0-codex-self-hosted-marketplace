+def rebuild_profile_projections(memory_getter) -> int:
+    with SessionLocal() as db:
+        rows = db.scalars(
+            select(MemoryCatalog).where(
+                MemoryCatalog.status == "active",
+                MemoryCatalog.profile_key.is_not(None),
+            )
+        ).all()
+        grouped: dict[tuple[str, str], list[MemoryCatalog]] = {}
+        for row in rows:
+            scope_key = row.project_id or "__global__"
+            grouped.setdefault((scope_key, str(row.profile_key)), []).append(row)
+        db.query(ProfileProjection).delete()
+        for (scope_key, profile_key), entries in grouped.items():
+            entries.sort(key=lambda value: (value.valid_from or value.updated_at, value.memory_id))
+            source_ids = [entry.memory_id for entry in entries]
+            memories = []
+            for memory_id in source_ids:
+                try:
+                    item = memory_getter(memory_id)
+                except Exception:
+                    continue
+                if isinstance(item, dict):
+                    memories.append(str(item.get("memory") or ""))
+            latest = entries[-1]
+            db.add(
+                ProfileProjection(
+                    scope_key=scope_key,
+                    project_id=latest.project_id,
+                    profile_key=profile_key,
+                    value={"current": memories[-1] if memories else "", "history": memories},
+                    source_memory_ids=source_ids,
+                    confidence=max((entry.confidence or 0.0 for entry in entries), default=None),
+                    valid_from=latest.valid_from,
+                    valid_to=latest.valid_to,
+                )
+            )
+        db.commit()
+        return len(grouped)
+
