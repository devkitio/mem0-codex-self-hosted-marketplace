diff --git a/server/config.py b/server/config.py
new file mode 100644
index 0000000000000000000000000000000000000000..feba608d9ffbad09fdb881fdc23110538fe1f7b4
--- /dev/null
+++ b/server/config.py
@@ -0,0 +1,96 @@
+import json
+import os
+from pathlib import Path
+
+from dotenv import load_dotenv
+
+load_dotenv()
+
+
+def _required_value(name: str) -> str:
+    file_path = os.environ.get(f"{name}_FILE", "").strip()
+    if file_path:
+        try:
+            value = Path(file_path).read_text(encoding="utf-8")
+        except OSError as exc:
+            raise RuntimeError(f"无法读取 {name} 的 secret 文件") from exc
+        if len(value) > 8192:
+            raise RuntimeError(f"{name} 的 secret 文件超过大小限制")
+        value = value.strip()
+    else:
+        value = os.environ.get(name, "").strip()
+    if not value:
+        raise RuntimeError(f"缺少必需配置 {name}")
+    return value
+
+
+def _boolean_value(name: str, default: bool = False) -> bool:
+    value = os.environ.get(name)
+    if value is None or not value.strip():
+        return default
+    normalized = value.strip().casefold()
+    if normalized in {"1", "true", "yes", "on"}:
+        return True
+    if normalized in {"0", "false", "no", "off"}:
+        return False
+    raise RuntimeError(f"{name} 必须是 true 或 false")
+
+
+def _fts_field_weights() -> dict[str, str]:
+    default = {
+        "text_lemmatized": "A",
+        "data": "B",
+        "categories": "C",
+        "memory_type": "D",
+    }
+    raw = os.environ.get("PGVECTOR_FTS_FIELD_WEIGHTS", "").strip()
+    if not raw:
+        return default
+    try:
+        parsed = json.loads(raw)
+    except json.JSONDecodeError as exc:
+        raise RuntimeError("PGVECTOR_FTS_FIELD_WEIGHTS 必须是 JSON 对象") from exc
+    if not isinstance(parsed, dict) or not parsed:
+        raise RuntimeError("PGVECTOR_FTS_FIELD_WEIGHTS 必须是非空 JSON 对象")
+    return {str(field): str(weight) for field, weight in parsed.items()}
+
+
+embedding_dims = int(os.getenv("EMBEDDING_DIMS", "1024"))
+
+config = {
+    "vector_store": {
+        "provider": "pgvector",
+        "config": {
+            "host": os.getenv("POSTGRES_HOST", "postgres"),
+            "port": int(os.getenv("POSTGRES_PORT", "5432")),
+            "dbname": os.getenv("POSTGRES_DB", "postgres"),
+            "user": os.getenv("POSTGRES_USER", "postgres"),
+            "password": _required_value("POSTGRES_PASSWORD"),
+            "collection_name": os.getenv("POSTGRES_COLLECTION_NAME", "memories_qwen37_1024"),
+            "embedding_model_dims": embedding_dims,
+            "hnsw": True,
+            "fts_language": os.getenv("PGVECTOR_FTS_LANGUAGE", "simple"),
+            "fts_phrase_search": _boolean_value("PGVECTOR_FTS_PHRASE_SEARCH"),
+            "fts_field_weights": _fts_field_weights(),
+        },
+    },
+    "llm": {
+        "provider": "openai",
+        "config": {
+            "model": os.getenv("LLM_MODEL", "gpt-5.4-mini"),
+            "api_key": _required_value("LLM_API_KEY"),
+            "openai_base_url": _required_value("LLM_API_BASE"),
+            "temperature": 0.1,
+            "max_tokens": 2000,
+        },
+    },
+    "embedder": {
+        "provider": "openai",
+        "config": {
+            "model": os.getenv("EMBEDDING_MODEL", "qwen3.7-text-embedding"),
+            "api_key": _required_value("EMBEDDING_API_KEY"),
+            "openai_base_url": _required_value("EMBEDDING_API_BASE"),
+            "embedding_dims": embedding_dims,
+        },
+    },
+}
