+@router.post("/memories/{memory_id}/restore")
+def restore_history_version(
+    memory_id: str,
+    body: RestoreHistoryRequest,
+    user: User = Depends(require_admin),
+):
+    memory = get_memory_instance()
+    with _memory_lock(memory_id):
+        history = memory.history(memory_id=memory_id)
+        selected = next((item for item in history if str(item.get("id")) == body.history_id), None)
+        if selected is None:
+            raise HTTPException(status_code=404, detail="历史版本不存在")
+        target_text = selected.get("new_memory") or selected.get("old_memory")
+        if not isinstance(target_text, str) or not target_text.strip():
+            raise HTTPException(status_code=409, detail="该历史节点没有可恢复的正文")
+        current = memory.get(memory_id)
+        if isinstance(current, dict):
+            memory.update(memory_id=memory_id, data=target_text)
+            restored_id = memory_id
+            recreated = False
+        else:
+            if not any([body.user_id, body.agent_id, body.run_id]):
+                raise HTTPException(status_code=409, detail="已删除记忆需要提供原 User、Agent 或 Run ID 才能重新建立")
+            result = memory.add(
+                messages=[{"role": "user", "content": target_text}],
+                user_id=body.user_id,
+                agent_id=body.agent_id,
+                run_id=body.run_id,
+                metadata={"restored_from_memory_id": memory_id, "restored_from_history_id": body.history_id},
+                infer=False,
+            )
+            restored_id = str(result["results"][0]["id"])
+            recreated = True
+    log_memory_activity(
+        "restore",
+        user=user,
+        memory_id=restored_id,
+        details={"来源记忆": memory_id, "历史节点": body.history_id, "重新建立": recreated},
+    )
+    return {"memory_id": restored_id, "recreated": recreated, "message": "历史版本已恢复"}
+
