+def assert_project_access(user: User, project_id: str | None, *, write: bool) -> None:
+    if user.role == "admin":
+        return
+    if not project_id:
+        raise HTTPException(status_code=403, detail="非管理员只能访问明确归属项目的记忆。")
+    role = project_roles(user).get(project_id)
+    if role is None or (write and role != "editor"):
+        raise HTTPException(status_code=403, detail="当前账户没有此项目的访问权限。")
+
+
+def scope_filters_for_user(user: User, filters: dict[str, Any], *, write: bool = False) -> dict[str, Any]:
+    scoped = dict(filters)
+    if user.role == "admin":
+        return scoped
+    roles = project_roles(user)
+    allowed = [project_id for project_id, role in roles.items() if not write or role == "editor"]
+    requested = scoped.get("project_id")
+    if requested:
+        if not isinstance(requested, str) or requested not in allowed:
+            raise HTTPException(status_code=403, detail="当前账户没有此项目的访问权限。")
+    elif not allowed:
+        raise HTTPException(status_code=403, detail="当前账户尚未分配任何可访问项目。")
+    else:
+        scoped["project_id"] = {"in": allowed}
+    return scoped
+
+
+def assert_memory_access(user: User, memory: dict[str, Any] | None, *, write: bool) -> None:
+    if memory is None:
+        if user.role != "admin":
+            raise HTTPException(status_code=404, detail="记忆不存在或当前账户无权访问。")
+        return
+    metadata = memory.get("metadata") if isinstance(memory.get("metadata"), dict) else {}
+    project_id = metadata.get("project_id") or memory.get("project_id")
+    assert_project_access(user, str(project_id) if project_id else None, write=write)
