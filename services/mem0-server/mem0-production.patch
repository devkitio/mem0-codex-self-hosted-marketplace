+@router.post("/dream/{operation_id}/execute")
+def execute_dream(
+    operation_id: uuid.UUID,
+    body: ExecuteOperationRequest,
+    user: User = Depends(require_admin),
+    db: Session = Depends(get_db),
+):
+    operation = db.scalar(
+        select(MemoryOperation).where(MemoryOperation.id == operation_id).with_for_update()
+    )
+    if operation is None or operation.kind != "dream":
+        raise HTTPException(status_code=404, detail="Dream 提案不存在")
+    if operation.status == "executing" and operation.expires_at < _utcnow():
+        operation.status = "partial"
+        operation.result = operation.result or {"执行中断": True}
+        db.commit()
+        raise HTTPException(status_code=409, detail="上次 Dream 执行已中断，请重新扫描并核对实际结果")
+    if operation.status != "preview":
+        raise HTTPException(status_code=409, detail="该 Dream 提案已处理")
+    if operation.expires_at < _utcnow():
+        operation.status = "expired"
+        db.commit()
+        raise HTTPException(status_code=409, detail="Dream 提案已过期")
+    if operation.preview_hash != body.preview_hash:
+        raise HTTPException(status_code=409, detail="预览校验码不匹配")
+    versions = dict(operation.targets.get("versions") or {})
+    current: dict[str, dict[str, Any]] = {}
+    for memory_id, version in versions.items():
+        item = _get_memory(memory_id)
+        if item is None or _memory_version(item) != version:
+            operation.status = "cancelled"
+            operation.result = {"冲突记忆": memory_id}
+            db.commit()
+            raise HTTPException(status_code=409, detail="记忆在扫描后已变化，请重新扫描")
+        current[memory_id] = item
+    operation.status = "executing"
+    mutation = db.get(MemoryMutation, operation.id)
+    if mutation is None:
+        mutation = MemoryMutation(id=operation.id, kind="dream")
+        db.add(mutation)
+    mutation.status = "pending"
+    mutation.source_memory_ids = list(versions)
+    mutation.reason = f"Dream operation {operation.id}"
+    mutation.before_payload = {"memories": current}
+    mutation.after_payload = None
+    mutation.error = None
+    db.commit()
+
+    succeeded = []
+    failed = []
+    for proposal in operation.request_data.get("proposals", []):
+        keep_id = proposal["keep_id"]
+        group = proposal["memory_ids"]
+        resolution = str(proposal.get("resolution") or "pending")
+        if proposal.get("type") == "conflict" and keep_id in body.resolutions:
+            selected = body.resolutions[keep_id]
+            resolution = "supersede" if selected == "replace" else selected
+        condition = body.conditions.get(keep_id)
+        try:
+            if any(_dream_protected(current[memory_id]) for memory_id in group):
+                raise RuntimeError("受保护记忆禁止自动替代")
+            if resolution in {"pending", "coexist"}:
+                relation_type = "conflicts" if proposal["type"] == "conflict" else "supports"
+                for memory_id in group:
+                    if memory_id == keep_id:
+                        continue
+                    exists = db.scalar(
+                        select(MemoryRelation).where(
+                            MemoryRelation.source_memory_id == keep_id,
+                            MemoryRelation.target_memory_id == memory_id,
+                            MemoryRelation.relation_type == relation_type,
+                        )
+                    )
+                    if exists is None:
+                        db.add(
+                            MemoryRelation(
+                                source_memory_id=keep_id,
+                                target_memory_id=memory_id,
+                                relation_type=relation_type,
+                                operation_id=operation_id,
+                                details={
+                                    "resolution": resolution,
+                                    "condition": condition,
+                                    "reason": proposal.get("reason"),
+                                },
+                            )
+                        )
+                succeeded.append(
+                    {"keep_id": keep_id, "merged": 0, "type": proposal["type"], "resolution": resolution}
+                )
+                continue
+            suggested_text = str(proposal.get("suggested_text") or "").strip()
+            with _memory_lock(keep_id):
+                locked_keeper = _get_memory(keep_id)
+                if locked_keeper is None or _memory_version(locked_keeper) != versions[keep_id]:
+                    raise RuntimeError("保留记忆在执行前发生变化")
+                keeper_metadata = _metadata(locked_keeper)
+                get_memory_instance().update(
+                    memory_id=keep_id,
+                    data=suggested_text or str(locked_keeper.get("memory") or ""),
+                    metadata={
+                        **keeper_metadata,
+                        "status": "active",
+                        "dream_operation_id": str(operation_id),
+                        "merged_from": [memory_id for memory_id in group if memory_id != keep_id],
+                    },
+                )
+            keeper = _get_memory(keep_id)
+            if keeper is None:
+                raise RuntimeError("新版本写入后无法读取")
+            sync_memory_catalog(keeper, status="active")
+            for memory_id in group:
+                if memory_id == keep_id:
+                    continue
+                with _memory_lock(memory_id):
+                    locked_item = _get_memory(memory_id)
+                    if locked_item is None or _memory_version(locked_item) != versions[memory_id]:
+                        raise RuntimeError("待合并记忆在执行前发生变化")
+                    loser_metadata = _metadata(locked_item)
+                    get_memory_instance().update(
+                        memory_id=memory_id,
+                        metadata={
+                            **loser_metadata,
+                            "status": "superseded",
+                            "superseded_by": keep_id,
+                            "supersedes_id": keep_id,
+                            "dream_operation_id": str(operation_id),
+                        },
+                    )
+                    superseded = _get_memory(memory_id)
+                    if superseded is None:
+                        raise RuntimeError("软替代后无法读取记忆")
+                    sync_memory_catalog(superseded, status="superseded")
+                    exists = db.scalar(
+                        select(MemoryRelation).where(
+                            MemoryRelation.source_memory_id == keep_id,
+                            MemoryRelation.target_memory_id == memory_id,
+                            MemoryRelation.relation_type == "supersedes",
+                        )
+                    )
+                    if exists is None:
+                        db.add(
+                            MemoryRelation(
+                                source_memory_id=keep_id,
+                                target_memory_id=memory_id,
+                                relation_type="supersedes",
+                                operation_id=operation_id,
+                                details={"proposal_type": proposal["type"], "reason": proposal.get("reason")},
+                            )
+                        )
+                log_memory_activity(
+                    "dream_merge",
+                    user=user,
+                    memory_id=memory_id,
+                    source="dream",
+                    details={"保留记忆": keep_id, "提案类型": proposal["type"]},
+                )
+            succeeded.append(
+                {
+                    "keep_id": keep_id,
+                    "merged": len(group) - 1,
+                    "type": proposal["type"],
+                    "resolution": "supersede",
+                }
+            )
+        except Exception as exc:
+            failed.append({"keep_id": keep_id, "error_type": type(exc).__name__})
+        if failed:
+            break
+    operation = db.get(MemoryOperation, operation_id)
+    auto_restored: list[str] = []
+    auto_restore_failed: list[dict[str, str]] = []
+    if failed:
+        auto_restored, auto_restore_failed = _restore_dream_snapshots(mutation, db)
+        if not auto_restore_failed:
+            _delete_dream_relations(operation_id, db)
+    operation.status = "partial" if failed else "completed"
+    operation.result = {
+        "succeeded": succeeded,
+        "failed": failed,
+        "auto_rollback": {
+            "restored": auto_restored,
+            "failed": auto_restore_failed,
+            "complete": bool(failed) and not auto_restore_failed,
+        } if failed else None,
+    }
+    mutation = db.get(MemoryMutation, operation_id)
+    mutation.status = "failed" if failed else "completed"
+    mutation.after_payload = {
+        "memories": {
+            memory_id: _get_memory(memory_id)
+            for memory_id in versions
+        }
+    }
+    mutation.error = json.dumps(
+        {"execution": failed, "auto_rollback": auto_restore_failed}, ensure_ascii=False
+    ) if failed else None
+    db.commit()
+    try:
+        rebuild_profile_projections(_get_memory)
+        rebuild_entity_projections(_get_memory)
+    except Exception:
+        logging.exception("Dream 完成后重建治理投影失败")
+    return {"status": operation.status, **operation.result}
+
+
+def _restore_dream_snapshots(
+    mutation: MemoryMutation,
+    db: Session,
+) -> tuple[list[str], list[dict[str, str]]]:
+    before = (mutation.before_payload or {}).get("memories")
+    if not isinstance(before, dict):
+        raise HTTPException(status_code=409, detail="Dream 操作缺少回滚快照")
+    restored = []
+    failed = []
+    for memory_id, snapshot in before.items():
+        try:
+            if not isinstance(snapshot, dict):
+                raise RuntimeError("回滚快照无效")
+            current_item = _get_memory(memory_id)
+            if current_item is None:
+                raise RuntimeError("软替代记忆已被物理删除，无法原位回滚")
+            metadata = _metadata(snapshot)
+            get_memory_instance().update(
+                memory_id=memory_id,
+                data=str(snapshot.get("memory") or ""),
+                metadata=metadata,
+                expiration_date=snapshot.get("expiration_date"),
+            )
+            refreshed = _get_memory(memory_id)
+            if refreshed is None:
+                raise RuntimeError("回滚后无法读取记忆")
+            sync_memory_catalog(
+                refreshed,
+                status=str(metadata.get("status") or "active"),
+                session=db,
+            )
+            restored.append(memory_id)
+        except Exception as exc:
+            failed.append({"memory_id": memory_id, "error_type": type(exc).__name__})
+    return restored, failed
+
+
+def _delete_dream_relations(operation_id: uuid.UUID, db: Session) -> None:
+    relations = db.scalars(
+        select(MemoryRelation).where(MemoryRelation.operation_id == operation_id)
+    ).all()
+    for relation in relations:
+        db.delete(relation)
+
+
+@router.post("/dream/{operation_id}/rollback")
+def rollback_dream(
+    operation_id: uuid.UUID,
+    user: User = Depends(require_admin),
+    db: Session = Depends(get_db),
+):
+    operation = db.scalar(
+        select(MemoryOperation).where(MemoryOperation.id == operation_id).with_for_update()
+    )
+    mutation = db.get(MemoryMutation, operation_id)
+    if operation is None or operation.kind != "dream" or mutation is None:
+        raise HTTPException(status_code=404, detail="Dream 操作不存在")
+    if operation.status not in {"completed", "partial"}:
+        raise HTTPException(status_code=409, detail="当前 Dream 状态不能回滚")
+    restored, failed = _restore_dream_snapshots(mutation, db)
+    if not failed:
+        _delete_dream_relations(operation_id, db)
+        operation.status = "rolled_back"
+        mutation.status = "rolled_back"
+    else:
+        operation.status = "partial"
+        mutation.status = "failed"
+        mutation.error = json.dumps(failed, ensure_ascii=False)
+    operation.result = {**(operation.result or {}), "rollback": {"restored": restored, "failed": failed}}
+    db.commit()
+    try:
+        rebuild_profile_projections(_get_memory)
+        rebuild_entity_projections(_get_memory)
+    except Exception:
+        logging.exception("Dream 回滚后重建治理投影失败")
+    log_memory_activity(
+        "dream_rollback",
+        user=user,
+        source="dream",
+        success=not failed,
+        details={"操作 ID": str(operation_id), "恢复数量": len(restored), "失败数量": len(failed)},
+    )
+    return {"status": operation.status, "restored": restored, "failed": failed}
+
+
+@router.post("/dream/{operation_id}/retry")
+def retry_dream(
+    operation_id: uuid.UUID,
+    user: User = Depends(require_admin),
+    db: Session = Depends(get_db),
+):
+    operation = db.scalar(
+        select(MemoryOperation).where(MemoryOperation.id == operation_id).with_for_update()
+    )
+    mutation = db.get(MemoryMutation, operation_id)
+    if operation is None or operation.kind != "dream" or mutation is None:
+        raise HTTPException(status_code=404, detail="Dream 操作不存在")
+    if operation.status != "partial":
+        raise HTTPException(status_code=409, detail="只有部分失败的 Dream 操作可以重试")
+
+    restored, failed = _restore_dream_snapshots(mutation, db)
+    if failed:
+        operation.result = {
+            **(operation.result or {}),
+            "retry": {"prepared": False, "restored": restored, "failed": failed},
+        }
+        mutation.status = "failed"
+        mutation.error = json.dumps(failed, ensure_ascii=False)
+        db.commit()
+        log_memory_activity(
+            "dream_retry",
+            user=user,
+            source="dream",
+            success=False,
+            details={"操作 ID": str(operation_id), "恢复失败数量": len(failed)},
+        )
+        return {"status": "partial", "prepared": False, "restored": restored, "failed": failed}
+
+    _delete_dream_relations(operation_id, db)
+    refreshed = {
+        memory_id: _get_memory(memory_id)
+        for memory_id in mutation.source_memory_ids
+    }
+    missing_ids = [memory_id for memory_id, item in refreshed.items() if item is None]
+    if missing_ids:
+        operation.result = {
+            **(operation.result or {}),
+            "retry": {"prepared": False, "missing_ids": missing_ids},
+        }
+        mutation.status = "failed"
+        mutation.error = json.dumps({"missing_ids": missing_ids}, ensure_ascii=False)
+        db.commit()
+        raise HTTPException(status_code=409, detail="Dream 重试准备后存在无法读取的记忆")
+
+    versions = {
+        memory_id: _memory_version(item)
+        for memory_id, item in refreshed.items()
+        if item is not None
+    }
+    preview_hash = memory_versions_hash(versions)
+    previous_result = operation.result
+    operation.targets = {**(operation.targets or {}), "versions": versions}
+    operation.preview_hash = preview_hash
+    operation.status = "preview"
+    operation.expires_at = _utcnow() + timedelta(minutes=OPERATION_TTL_MINUTES)
+    operation.result = {
+        "retry": {
+            "prepared": True,
+            "restored": restored,
+            "previous_result": previous_result,
+        }
+    }
+    mutation.status = "pending"
+    mutation.before_payload = {"memories": refreshed}
+    mutation.after_payload = None
+    mutation.error = None
+    db.commit()
+    log_memory_activity(
+        "dream_retry",
+        user=user,
+        source="dream",
+        details={"操作 ID": str(operation_id), "恢复数量": len(restored)},
+    )
+    return {
+        "operation_id": str(operation_id),
+        "status": "preview",
+        "prepared": True,
+        "preview_hash": preview_hash,
+        "expires_at": operation.expires_at,
+        "count": len(operation.request_data.get("proposals", [])),
+        "proposals": operation.request_data.get("proposals", []),
+    }
