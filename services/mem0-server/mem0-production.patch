+def _create_job(
+    db: Session,
+    user: User | None,
+    *,
+    kind: str,
+    summary: str,
+    status: str = "queued",
+    request_data: dict[str, Any] | None = None,
+    digest: str | None = None,
+) -> BackgroundJob:
+    job = BackgroundJob(
+        kind=kind,
+        status=status,
+        progress=0,
+        summary=summary,
+        request_data=request_data or {},
+        preview_hash=digest,
+        created_by=_actor_id(user) if user else None,
+    )
+    db.add(job)
+    db.commit()
