+@router.get("/evaluations/runs/{run_id}/compare")
+def compare_evaluation_runs_v2(
+    run_id: uuid.UUID,
+    baseline_run_id: uuid.UUID | None = None,
+    _user: User = Depends(require_admin),
+    db: Session = Depends(get_db),
+):
+    current = db.get(SearchEvaluationRun, run_id)
+    if current is None or current.status != "completed":
+        raise HTTPException(status_code=409, detail="当前评测运行不存在或未完成")
+    baseline_id = baseline_run_id or current.baseline_run_id
+    baseline = db.get(SearchEvaluationRun, baseline_id) if baseline_id else None
+    if baseline is None or baseline.status != "completed":
+        raise HTTPException(status_code=409, detail="基线评测运行不存在或未完成")
+    if baseline.dataset_id != current.dataset_id or baseline.mode != current.mode:
+        raise HTTPException(status_code=409, detail="只能比较相同数据集版本和检索模式的运行")
+    metric_names = (
+        "recall_at_k", "precision_at_k", "mrr", "ndcg_at_k", "p95_latency_ms",
+        "ordinary_p95_latency_ms", "complex_p95_latency_ms", "error_rate",
+        "write_false_accept_rate", "cross_session_duplicate_rate",
+    )
+    current_metrics = current.metrics or {}
+    baseline_metrics = baseline.metrics or {}
+    project_metric_names = ("recall_at_k", "mrr", "ndcg_at_k")
+    current_projects = current_metrics.get("projects") if isinstance(current_metrics.get("projects"), dict) else {}
+    baseline_projects = baseline_metrics.get("projects") if isinstance(baseline_metrics.get("projects"), dict) else {}
+    all_projects = sorted(set(baseline_projects) | set(current_projects))
+    project_delta = {
+        project_id: {
+            name: round(
+                float(current_projects.get(project_id, {}).get(name, 0))
+                - float(values.get(name, 0)),
+                6,
+            )
+            for name in project_metric_names
+        }
+        for project_id in all_projects
+        for values in [baseline_projects.get(project_id, {})]
+        if isinstance(values, dict)
+    }
+
+    def relative_gain(name: str) -> float:
+        previous = float(baseline_metrics.get(name, 0))
+        value = float(current_metrics.get(name, 0))
+        if previous <= 0:
+            return 0.0 if value <= 0 else 1.0
+        return (value - previous) / previous
+
+    project_regressions = [
+        {
+            "project_id": project_id,
+            "metric": name,
+            "relative_change": round(
+                (
+                    float(current_projects.get(project_id, {}).get(name, 0))
+                    - float(values.get(name, 0))
+                )
+                / float(values.get(name, 0)),
+                6,
+            ),
+        }
+        for project_id, values in baseline_projects.items()
+        if isinstance(values, dict)
+        for name in project_metric_names
+        if float(values.get(name, 0)) > 0
+        and float(current_projects.get(project_id, {}).get(name, 0)) < float(values.get(name, 0)) * 0.95
+    ]
+    baseline_p95 = float(baseline_metrics.get("p95_latency_ms", 0))
+    current_p95 = float(current_metrics.get("p95_latency_ms", 0))
+    latency_limit = baseline_p95 + max(baseline_p95 * 0.20, 250.0)
+    baseline_ordinary_p95 = float(baseline_metrics.get("ordinary_p95_latency_ms", baseline_p95))
+    current_ordinary_p95 = float(current_metrics.get("ordinary_p95_latency_ms", current_p95))
+    ordinary_latency_limit = baseline_ordinary_p95 + max(baseline_ordinary_p95 * 0.20, 250.0)
+    current_complex_p95 = float(current_metrics.get("complex_p95_latency_ms", current_p95))
+    write_sample_count = int(current_metrics.get("write_quality_sample_count", 0))
+    gates = {
+        "recall_at_10_relative_gain": relative_gain("recall_at_k") >= 0.10,
+        "mrr_relative_gain": relative_gain("mrr") >= 0.05,
+        "active_projects_no_regression_over_5_percent": not project_regressions,
+        "p95_increment_within_limit": current_p95 <= latency_limit,
+        "ordinary_query_p95_increment_within_limit": current_ordinary_p95 <= ordinary_latency_limit,
+        "complex_query_p95_within_3_seconds": current_complex_p95 <= 3000,
+        "retrieval_error_rate_is_zero": float(current_metrics.get("error_rate", 1)) == 0,
+        "write_quality_samples_present": write_sample_count > 0,
+        "write_false_accept_rate_at_most_2_percent": float(current_metrics.get("write_false_accept_rate", 1)) <= 0.02,
+        "critical_error_direct_count_is_zero": int(current_metrics.get("critical_error_direct_count", 1)) == 0,
+        "cross_session_duplicate_rate_at_most_2_percent": float(
+            current_metrics.get("cross_session_duplicate_rate", 1)
+        ) <= 0.02,
+    }
+    return {
+        "run": _evaluation_run_item(current),
+        "baseline": _evaluation_run_item(baseline),
+        "delta": {
+            name: round(float(current_metrics.get(name, 0)) - float(baseline_metrics.get(name, 0)), 6)
+            for name in metric_names
+        },
+        "relative_gain": {
+            "recall_at_k": round(relative_gain("recall_at_k"), 6),
+            "mrr": round(relative_gain("mrr"), 6),
+        },
+        "project_delta": project_delta,
+        "project_regressions": project_regressions,
+        "latency_limit_ms": round(latency_limit, 3),
+        "ordinary_latency_limit_ms": round(ordinary_latency_limit, 3),
+        "gates": gates,
+        "passed": all(gates.values()),
+    }
+
