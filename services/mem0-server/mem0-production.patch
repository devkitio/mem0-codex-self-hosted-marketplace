+class BatchPreviewRequest(BaseModel):
+    memory_ids: list[str] = Field(..., min_length=1, max_length=500)
+    changes: BatchChanges
+
+    @field_validator("memory_ids")
+    @classmethod
+    def unique_ids(cls, value: list[str]) -> list[str]:
+        normalized = list(dict.fromkeys(item.strip() for item in value if item.strip()))
+        if not normalized:
+            raise ValueError("至少选择一条记忆")
+        return normalized
+
+
+def _batch_request_data(changes: BatchChanges) -> dict[str, Any]:
+    fields = changes.model_fields_set
+    return {
+        "text_find": changes.text_find,
+        "text_replace": changes.text_replace or "",
+        "metadata_patch": changes.metadata_patch,
+        "expiration_date_set": "expiration_date" in fields,
+        "expiration_date": changes.expiration_date,
+        "project_id_set": "project_id" in fields,
+        "project_id": changes.project_id,
+    }
+
+
+def _preview_change(item: dict[str, Any], changes: dict[str, Any]) -> dict[str, Any]:
+    before_text = str(item.get("memory") or "")
+    after_text = before_text
+    if changes.get("text_find") is not None:
+        after_text = before_text.replace(str(changes["text_find"]), str(changes.get("text_replace") or ""))
+    changed_fields: list[str] = []
+    if after_text != before_text:
+        changed_fields.append("正文")
+    if changes.get("metadata_patch") is not None:
+        changed_fields.append("metadata")
+    if changes.get("expiration_date_set"):
+        changed_fields.append("过期时间")
+    if changes.get("project_id_set"):
+        changed_fields.append("项目范围")
+    return {
+        "memory_id": item["id"],
+        "before_text": before_text,
+        "after_text": after_text,
+        "changed_fields": changed_fields,
+        "version": _memory_version(item),
+    }
+
