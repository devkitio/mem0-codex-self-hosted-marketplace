+++ b/server/routers/exports.py
@@ -0,0 +1,137 @@
+import csv
+import io
+import json
+from datetime import datetime, timezone
+from typing import Any, Literal
+
+from auth import require_admin
+from fastapi import APIRouter, Depends, Query, Response
+from server_state import get_memory_instance
+
+router = APIRouter(prefix="/exports", tags=["exports"])
+MAX_EXPORT_LIMIT = 5000
+_RESERVED_PAYLOAD_KEYS = {
+    "data",
+    "user_id",
+    "agent_id",
+    "run_id",
+    "hash",
+    "created_at",
+    "updated_at",
+    "expiration_date",
+}
+ExportFormat = Literal["json", "csv", "pydantic"]
+
+
+def _serialize_memory(row: Any) -> dict[str, Any]:
+    payload = getattr(row, "payload", None) or {}
+    return {
+        "id": str(getattr(row, "id", "")),
+        "memory": payload.get("data"),
+        "user_id": payload.get("user_id"),
+        "agent_id": payload.get("agent_id"),
+        "run_id": payload.get("run_id"),
+        "hash": payload.get("hash"),
+        "expiration_date": payload.get("expiration_date"),
+        "metadata": {key: value for key, value in payload.items() if key not in _RESERVED_PAYLOAD_KEYS},
+        "created_at": payload.get("created_at"),
+        "updated_at": payload.get("updated_at"),
+    }
+
+
+def _list_memories(limit: int) -> list[dict[str, Any]]:
+    results = get_memory_instance().vector_store.list(top_k=limit)
+    rows = results[0] if results and isinstance(results, list) and isinstance(results[0], list) else results or []
+    return [_serialize_memory(row) for row in rows]
+
+
+def _render_json(memories: list[dict[str, Any]]) -> bytes:
+    payload = {
+        "schema_version": "mem0-self-hosted-export-v1",
+        "exported_at": datetime.now(timezone.utc).isoformat(),
+        "total": len(memories),
+        "memories": memories,
+    }
+    return json.dumps(payload, ensure_ascii=False, indent=2, default=str).encode("utf-8")
+
+
+def _render_csv(memories: list[dict[str, Any]]) -> bytes:
+    output = io.StringIO(newline="")
+    fields = [
+        "id",
+        "memory",
+        "user_id",
+        "agent_id",
+        "run_id",
+        "hash",
+        "expiration_date",
+        "metadata",
+        "created_at",
+        "updated_at",
+    ]
+    writer = csv.DictWriter(output, fieldnames=fields)
+    writer.writeheader()
+    for memory in memories:
+        row = dict(memory)
+        row["metadata"] = json.dumps(row.get("metadata") or {}, ensure_ascii=False, separators=(",", ":"))
+        writer.writerow(row)
+    return output.getvalue().encode("utf-8-sig")
+
+
+def _render_pydantic_schema() -> bytes:
+    schema = """from typing import Any
+
+from pydantic import BaseModel, Field
+
+
+class MemoryExportItem(BaseModel):
+    id: str
+    memory: str | None = None
+    user_id: str | None = None
+    agent_id: str | None = None
+    run_id: str | None = None
+    hash: str | None = None
+    expiration_date: str | None = None
+    metadata: dict[str, Any] = Field(default_factory=dict)
+    created_at: str | None = None
+    updated_at: str | None = None
+
+
+class Mem0Export(BaseModel):
+    schema_version: str
+    exported_at: str
+    total: int
+    memories: list[MemoryExportItem]
+"""
+    return schema.encode("utf-8")
+
+
+@router.get("/memories")
+def export_memories(
+    format: ExportFormat = Query(default="json"),
+    limit: int = Query(default=MAX_EXPORT_LIMIT, ge=1, le=MAX_EXPORT_LIMIT),
+    _auth=Depends(require_admin),
+):
+    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+    if format == "pydantic":
+        body = _render_pydantic_schema()
+        extension = "py"
+        media_type = "text/x-python; charset=utf-8"
+    else:
+        memories = _list_memories(limit)
+        if format == "csv":
+            body = _render_csv(memories)
+            extension = "csv"
+            media_type = "text/csv; charset=utf-8"
+        else:
+            body = _render_json(memories)
+            extension = "json"
+            media_type = "application/json; charset=utf-8"
+    return Response(
+        content=body,
+        media_type=media_type,
+        headers={
+            "Content-Disposition": f'attachment; filename="mem0-memories-{timestamp}.{extension}"',
+            "Cache-Control": "no-store",
+        },
+    )
