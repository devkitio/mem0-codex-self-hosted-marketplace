+++ b/server/routers/categories.py
@@ -0,0 +1,235 @@
+import uuid
+from collections import defaultdict
+from datetime import datetime
+from typing import Any
+
+from auth import require_admin
+from db import get_db
+from fastapi import APIRouter, Depends, HTTPException
+from models import Category, User
+from pydantic import BaseModel, Field, field_validator
+from server_state import get_memory_instance
+from sqlalchemy import func, select
+from sqlalchemy.orm import Session
+
+router = APIRouter(prefix="/categories", tags=["categories"])
+SCAN_LIMIT = 5000
+_RESERVED_FIELDS = {
+    "id",
+    "memory",
+    "data",
+    "user_id",
+    "agent_id",
+    "run_id",
+    "hash",
+    "expiration_date",
+    "created_at",
+    "updated_at",
+    "score",
+    "metadata",
+}
+
+
+def _normalize_category_name(value: str) -> str:
+    normalized = " ".join(value.split())
+    if not normalized:
+        raise ValueError("分类名称不能为空")
+    if len(normalized) > 80:
+        raise ValueError("分类名称不能超过 80 个字符")
+    if "/" in normalized or "\\" in normalized:
+        raise ValueError("分类名称不能包含斜杠")
+    return normalized
+
+
+class CategoryCreate(BaseModel):
+    name: str = Field(..., min_length=1, max_length=80)
+
+    @field_validator("name")
+    @classmethod
+    def validate_name(cls, value: str) -> str:
+        return _normalize_category_name(value)
+
+
+class CategoryItem(BaseModel):
+    id: uuid.UUID | None
+    name: str
+    memory_count: int
+    created_at: datetime | None
+
+
+class CategoryDeleteResponse(BaseModel):
+    message: str
+    updated_memories: int
+
+
+class CategoryAssignmentResponse(BaseModel):
+    memory_id: str
+    categories: list[str]
+
+
+def _rows() -> list[Any]:
+    results = get_memory_instance().vector_store.list(top_k=SCAN_LIMIT)
+    return results[0] if results and isinstance(results, list) and isinstance(results[0], list) else results or []
+
+
+def _normalize_categories(payload: dict[str, Any]) -> list[str]:
+    values: list[str] = []
+    categories = payload.get("categories")
+    if isinstance(categories, (list, tuple, set)):
+        values.extend(str(value).strip() for value in categories if str(value).strip())
+    legacy = payload.get("category")
+    if isinstance(legacy, str) and legacy.strip():
+        values.append(legacy.strip())
+    unique: dict[str, str] = {}
+    for value in values:
+        unique.setdefault(value.casefold(), value)
+    return list(unique.values())
+
+
+def _memory_payload(memory: dict[str, Any]) -> dict[str, Any]:
+    payload = dict(memory)
+    metadata = memory.get("metadata")
+    if isinstance(metadata, dict):
+        payload.update(metadata)
+    return payload
+
+
+def _set_memory_categories(memory_id: str, payload: dict[str, Any], categories: list[str]) -> None:
+    metadata = {key: value for key, value in payload.items() if key not in _RESERVED_FIELDS}
+    metadata["categories"] = categories or None
+    metadata["category"] = None
+    get_memory_instance().update(memory_id=memory_id, metadata=metadata)
+
+
+@router.get("", response_model=list[CategoryItem])
+def list_categories(user: User = Depends(require_admin), db: Session = Depends(get_db)):
+    definitions = (
+        db.execute(select(Category).where(Category.created_by == user.id).order_by(Category.name.asc())).scalars().all()
+    )
+    counts: dict[str, int] = defaultdict(int)
+    display_names: dict[str, str] = {}
+    for row in _rows():
+        payload = getattr(row, "payload", None) or {}
+        for name in _normalize_categories(payload):
+            key = name.casefold()
+            counts[key] += 1
+            display_names.setdefault(key, name)
+
+    items: list[CategoryItem] = []
+    known: set[str] = set()
+    for category in definitions:
+        key = category.name.casefold()
+        known.add(key)
+        items.append(
+            CategoryItem(
+                id=category.id,
+                name=category.name,
+                memory_count=counts.get(key, 0),
+                created_at=category.created_at,
+            )
+        )
+    for key in sorted(set(counts) - known):
+        items.append(CategoryItem(id=None, name=display_names[key], memory_count=counts[key], created_at=None))
+    return items
+
+
+@router.post("", response_model=CategoryItem, status_code=201)
+def create_category(body: CategoryCreate, user: User = Depends(require_admin), db: Session = Depends(get_db)):
+    if db.get(User, user.id) is None:
+        raise HTTPException(status_code=409, detail="请先完成管理员账户初始化")
+    existing = db.scalar(
+        select(Category).where(Category.created_by == user.id, func.lower(Category.name) == body.name.lower())
+    )
+    if existing is not None:
+        raise HTTPException(status_code=409, detail="该分类已经存在")
+    category = Category(name=body.name, created_by=user.id)
+    db.add(category)
+    db.commit()
+    db.refresh(category)
+    return CategoryItem(id=category.id, name=category.name, memory_count=0, created_at=category.created_at)
+
+
+@router.delete("/{category_name}", response_model=CategoryDeleteResponse)
+def delete_category(category_name: str, user: User = Depends(require_admin), db: Session = Depends(get_db)):
+    try:
+        normalized_name = _normalize_category_name(category_name)
+    except ValueError as exc:
+        raise HTTPException(status_code=422, detail=str(exc)) from exc
+    normalized = normalized_name.casefold()
+    category = db.scalar(
+        select(Category).where(
+            Category.created_by == user.id,
+            func.lower(Category.name) == normalized_name.lower(),
+        )
+    )
+    updated = 0
+    for row in _rows():
+        payload = getattr(row, "payload", None) or {}
+        categories = _normalize_categories(payload)
+        if normalized not in {value.casefold() for value in categories}:
+            continue
+        remaining = [value for value in categories if value.casefold() != normalized]
+        _set_memory_categories(str(getattr(row, "id", "")), payload, remaining)
+        updated += 1
+    if category is None and updated == 0:
+        raise HTTPException(status_code=404, detail="分类不存在")
+    if category is not None:
+        db.delete(category)
+        db.commit()
+    return CategoryDeleteResponse(message="分类已删除", updated_memories=updated)
+
+
+@router.put("/{category_name}/memories/{memory_id}", response_model=CategoryAssignmentResponse)
+def assign_category(
+    category_name: str,
+    memory_id: str,
+    user: User = Depends(require_admin),
+    db: Session = Depends(get_db),
+):
+    try:
+        normalized_name = _normalize_category_name(category_name)
+    except ValueError as exc:
+        raise HTTPException(status_code=422, detail=str(exc)) from exc
+    try:
+        memory = get_memory_instance().get(memory_id)
+    except ValueError as exc:
+        raise HTTPException(status_code=404, detail="记忆不存在") from exc
+    if not isinstance(memory, dict):
+        raise HTTPException(status_code=404, detail="记忆不存在")
+
+    category = db.scalar(
+        select(Category).where(
+            Category.created_by == user.id,
+            func.lower(Category.name) == normalized_name.lower(),
+        )
+    )
+    if category is None:
+        category = Category(name=normalized_name, created_by=user.id)
+        db.add(category)
+        db.commit()
+        db.refresh(category)
+
+    payload = _memory_payload(memory)
+    categories = _normalize_categories(payload)
+    if category.name.casefold() not in {value.casefold() for value in categories}:
+        categories.append(category.name)
+        _set_memory_categories(memory_id, payload, categories)
+    return CategoryAssignmentResponse(memory_id=memory_id, categories=categories)
+
+
+@router.delete("/{category_name}/memories/{memory_id}", response_model=CategoryAssignmentResponse)
+def unassign_category(category_name: str, memory_id: str, _user: User = Depends(require_admin)):
+    try:
+        memory = get_memory_instance().get(memory_id)
+    except ValueError as exc:
+        raise HTTPException(status_code=404, detail="记忆不存在") from exc
+    if not isinstance(memory, dict):
+        raise HTTPException(status_code=404, detail="记忆不存在")
+    try:
+        normalized = _normalize_category_name(category_name).casefold()
+    except ValueError as exc:
+        raise HTTPException(status_code=422, detail=str(exc)) from exc
+    payload = _memory_payload(memory)
+    categories = [value for value in _normalize_categories(payload) if value.casefold() != normalized]
+    _set_memory_categories(memory_id, payload, categories)
+    return CategoryAssignmentResponse(memory_id=memory_id, categories=categories)
