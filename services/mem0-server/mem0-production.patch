+import hashlib
+import re
+
+MCP_SCOPE_VERSION = "v1"
+MCP_IDENTITY_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")
+
+
+def validate_mcp_identity(value: str, name: str) -> str:
+    value = value.strip()
+    if not MCP_IDENTITY_PATTERN.fullmatch(value):
+        raise ValueError(f"{name} 必须是有效且非空的内部身份")
+    return value
+
+
+def derive_mcp_agent_id(owner: str, project_id: str | None) -> str:
+    owner = validate_mcp_identity(owner, "MCP owner")
+    scope = f"project:{project_id}" if project_id else "global"
+    digest = hashlib.sha256(f"{owner}\0{scope}".encode("utf-8")).hexdigest()[:32]
+    return f"mcp-scope-{MCP_SCOPE_VERSION}-{digest}"
