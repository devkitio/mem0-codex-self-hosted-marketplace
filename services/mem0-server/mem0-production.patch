+def _normalized_alias(value: str) -> str:
+    return re.sub(r"[^\w\u4e00-\u9fff]+", "", value.casefold())[:256]
+
+
+def rebuild_entity_projections(memory_getter) -> dict[str, int]:
+    """从正式记忆重建实体与别名投影，投影本身不修改原始事实。"""
+    with SessionLocal() as db:
+        rows = db.scalars(select(MemoryCatalog).where(MemoryCatalog.status == "active")).all()
+        entities: dict[tuple[str, str, str], dict[str, Any]] = {}
+        aliases: dict[tuple[str, str], dict[str, Any]] = {}
+        for row in rows:
+            scope_key = row.project_id or "__global__"
+            try:
+                item = memory_getter(row.memory_id)
+            except Exception:
+                continue
+            if not isinstance(item, dict):
+                continue
+            metadata = _metadata(item)
+            discovered: list[dict[str, Any]] = []
+            for entity_type, entity_key in (
+                ("user", row.user_id),
+                ("agent", row.agent_id),
+                ("run", row.run_id),
+                ("project", row.project_id),
+            ):
+                if entity_key:
+                    discovered.append({"type": entity_type, "key": entity_key, "name": entity_key, "aliases": []})
+            raw_entities = metadata.get("entities")
+            if isinstance(raw_entities, list):
+                for value in raw_entities[:100]:
+                    if isinstance(value, str) and value.strip():
+                        discovered.append({"type": "entity", "key": value.strip(), "name": value.strip(), "aliases": []})
+                    elif isinstance(value, dict):
+                        key = str(value.get("key") or value.get("id") or value.get("name") or "").strip()
+                        if key:
+                            discovered.append(
+                                {
+                                    "type": str(value.get("type") or "entity")[:32],
+                                    "key": key[:256],
+                                    "name": str(value.get("name") or key)[:256],
+                                    "aliases": value.get("aliases") if isinstance(value.get("aliases"), list) else [],
+                                }
+                            )
+            explicit_key = str(metadata.get("entity_key") or "").strip()
+            if explicit_key:
+                discovered.append(
+                    {
+                        "type": str(metadata.get("entity_type") or "entity")[:32],
+                        "key": explicit_key[:256],
+                        "name": str(metadata.get("entity_name") or explicit_key)[:256],
+                        "aliases": metadata.get("aliases") if isinstance(metadata.get("aliases"), list) else [],
+                    }
+                )
+            for entity in discovered:
+                entity_type = str(entity["type"])[:32]
+                entity_key = str(entity["key"])[:256]
+                key = (scope_key, entity_type, entity_key)
+                projection = entities.setdefault(
+                    key,
+                    {
+                        "project_id": row.project_id,
+                        "display_name": str(entity.get("name") or entity_key)[:256],
+                        "source_memory_ids": [],
+                    },
+                )
+                if row.memory_id not in projection["source_memory_ids"]:
+                    projection["source_memory_ids"].append(row.memory_id)
+                for raw_alias in entity.get("aliases") or []:
+                    alias = str(raw_alias).strip()[:256]
+                    normalized = _normalized_alias(alias)
+                    if not normalized:
+                        continue
+                    alias_row = aliases.setdefault(
+                        (scope_key, normalized),
+                        {
+                            "project_id": row.project_id,
+                            "alias": alias,
+                            "target_entity_type": entity_type,
+                            "target_entity_key": entity_key,
+                            "source_memory_ids": [],
+                        },
+                    )
+                    if row.memory_id not in alias_row["source_memory_ids"]:
+                        alias_row["source_memory_ids"].append(row.memory_id)
+        db.query(EntityAliasProjection).delete()
+        db.query(EntityProjection).delete()
+        for (scope_key, entity_type, entity_key), value in entities.items():
+            db.add(
+                EntityProjection(
+                    scope_key=scope_key,
+                    project_id=value["project_id"],
+                    entity_type=entity_type,
+                    entity_key=entity_key,
+                    display_name=value["display_name"],
+                    attributes={},
+                    source_memory_ids=value["source_memory_ids"],
+                )
+            )
+        for (scope_key, alias_normalized), value in aliases.items():
+            db.add(
+                EntityAliasProjection(
+                    scope_key=scope_key,
+                    project_id=value["project_id"],
+                    alias=value["alias"],
+                    alias_normalized=alias_normalized,
+                    target_entity_type=value["target_entity_type"],
+                    target_entity_key=value["target_entity_key"],
+                    source_memory_ids=value["source_memory_ids"],
+                )
+            )
+        db.commit()
+        return {"entities": len(entities), "aliases": len(aliases)}
+
+
+def archive_expired_candidates() -> int:
+    with SessionLocal() as db:
+        rows = db.scalars(
+            select(MemoryCandidate).where(
+                MemoryCandidate.status == "pending",
+                MemoryCandidate.expires_at < _utcnow(),
+            )
+        ).all()
+        for row in rows:
+            row.status = "archived"
+        db.commit()
+        return len(rows)
+
