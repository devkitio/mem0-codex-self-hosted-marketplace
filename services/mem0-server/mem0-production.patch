+            params["run_id"] = request.run_id
+        if request.expiration_date is not None:
+            params["expiration_date"] = request.expiration_date
+        lock = _mcp_scope_operation_lock(agent_id) if request.infer else nullcontext()
+        memory = get_memory_instance()
+        with lock:
+            response = memory.add(
+                messages=messages,
+                **params,
+            )
+        added_rows = _validated_result_rows(response, "新增记忆")
+        rows: List[Dict[str, Any]] = []
+        seen_ids: set[str] = set()
+        for item in added_rows:
+            memory_id = item.get("id")
+            if not isinstance(memory_id, str) or not memory_id or memory_id in seen_ids:
+                raise RuntimeError("Mem0 新增记忆返回无效 ID")
+            seen_ids.add(memory_id)
+            current = memory.get(memory_id)
+            if (
+                not isinstance(current, dict)
+                or current.get("id") != memory_id
+                or not _matches_managed_scope(current, request.project_id)
+                or current.get("run_id") != request.run_id
+            ):
+                raise RuntimeError("Mem0 新增记忆返回越界结果")
+            rows.append(current)
+            operation_id = begin_mutation("add", memory_id=memory_id, reason="MCP 写入")
+            try:
+                complete_mutation(operation_id, current)
+            except Exception as sync_error:
+                fail_mutation(operation_id, sync_error)
+                raise RuntimeError("记忆已写入向量库，但质量目录同步失败") from sync_error
+            log_memory_activity(
+                "create",
+                memory_id=memory_id,
+                source="mcp",
+                details={"项目": request.project_id or "全局", "推断提取": request.infer},
+            )
+        if metadata_findings or content_findings or conflicts:
+            log_memory_activity(
+                "write_protection",
+                source="mcp",
+                details={
+                    "敏感信息数量": len(metadata_findings) + len(content_findings),
+                    "冲突数量": len(conflicts),
+                },
+            )
+        return {**response, "results": rows, "status": "ok"}
+    except HTTPException:
+        raise
+    except (ValueError, Mem0ValidationError) as exc:
+        raise _client_error(exc)
+    except Exception as exc:
+        log_memory_activity("create", source="mcp", success=False, details={"错误类型": type(exc).__name__})
+        raise upstream_error()
+
