+@contextmanager
+def _memory_operation_lock(memory_id: str):
+    deadline = time.monotonic() + 5.0
+    with SessionLocal() as lock_db, lock_db.begin():
+        while not bool(
+            lock_db.scalar(
+                text("SELECT pg_try_advisory_xact_lock(hashtextextended(:memory_id, 0))"),
+                {"memory_id": memory_id},
+            )
+        ):
+            if time.monotonic() >= deadline:
+                raise HTTPException(status_code=409, detail="记忆正在被其他请求处理，请稍后重试")
+            time.sleep(0.05)
+        yield
+
+
+@contextmanager
+def _mcp_scope_operation_lock(agent_id: str):
+    lock_key = f"mcp-add:{agent_id}"
+    deadline = time.monotonic() + 5.0
+    with SessionLocal() as lock_db, lock_db.begin():
+        while not bool(
+            lock_db.scalar(
+                text("SELECT pg_try_advisory_xact_lock(hashtextextended(:scope, 0))"),
+                {"scope": lock_key},
+            )
+        ):
+            if time.monotonic() >= deadline:
+                raise HTTPException(status_code=409, detail="MCP 作用域正在处理，请稍后重试")
+            time.sleep(0.05)
+        yield
+
+
+def _validate_internal_metadata_changes(value: Optional[Dict[str, Any]]) -> Dict[str, Any]:
+    if value is None:
+        return {}
+    if not isinstance(value, dict):
+        raise HTTPException(status_code=400, detail="metadata 格式无效")
+    try:
+        encoded = json.dumps(
+            value,
+            ensure_ascii=False,
+            separators=(",", ":"),
+            allow_nan=False,
+        ).encode("utf-8")
+    except (TypeError, ValueError) as exc:
+        raise HTTPException(status_code=400, detail="metadata 格式无效") from exc
+    if len(encoded) > 32768:
+        raise HTTPException(status_code=400, detail="metadata 超过大小限制")
+
+    def walk(item: Any, depth: int) -> None:
+        if depth > 4:
+            raise HTTPException(status_code=400, detail="metadata 嵌套层级过深")
+        if isinstance(item, dict):
+            for key, child in item.items():
+                if not isinstance(key, str) or not key or key in _INTERNAL_RESERVED_METADATA:
+                    raise HTTPException(status_code=400, detail="metadata 字段为保留字段或格式无效")
+                walk(child, depth + 1)
+        elif isinstance(item, list):
+            for child in item:
+                walk(child, depth + 1)
+        elif item is not None and not isinstance(item, (str, int, float, bool)):
+            raise HTTPException(status_code=400, detail="metadata 包含不支持的值")
+
+    walk(value, 0)
+    return json.loads(encoded)
+
+
+def _merge_managed_metadata(
+    current: Dict[str, Any],
+    project_id: Optional[str],
+    changes: Dict[str, Any],
+) -> Dict[str, Any]:
+    metadata = {
+        key: value
+        for key, value in _internal_metadata(current).items()
+        if key not in _INTERNAL_RESERVED_METADATA
+    }
+    for key, value in changes.items():
+        if value is None:
+            metadata.pop(key, None)
+        else:
+            metadata[key] = value
+    metadata.update(
+        {
+            "mcp_owner": INTERNAL_OWNER,
+            "scope": "project" if project_id else "global",
+            "source": "codex-mcp",
+        }
+    )
+    if project_id:
+        metadata["project_id"] = project_id
+    return metadata
+
+
+def _clean_history(history: Any) -> List[Dict[str, Any]]:
+    allowed = {
+        "id",
+        "memory_id",
+        "old_memory",
+        "new_memory",
+        "event",
+        "created_at",
+        "updated_at",
+        "is_deleted",
+        "before_payload",
+        "after_payload",
+        "operation_id",
+        "reason",
+        "source_type",
+        "source_id",
+        "source_message_id",
+        "status",
+        "payload_version",
+    }
+    if not isinstance(history, list) or any(not isinstance(item, dict) for item in history):
+        raise RuntimeError("Mem0 历史返回无效响应")
+    return [
+        {key: value for key, value in item.items() if key in allowed}
+        for item in history
+    ]
+
+
+def _delete_scope_hash(deletion: InternalMemoryDelete) -> str:
+    scope = {
+        "project_id": deletion.project_id,
+        "run_id": deletion.run_id,
+        "cutoff": deletion.cutoff,
+        "expected_hash": deletion.expected_hash,
+        "expected_count": deletion.expected_count,
+        "operation_expires_at": deletion.operation_expires_at,
+    }
+    encoded = json.dumps(scope, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def _decode_string_list(value: str) -> List[str]:
+    try:
+        decoded = json.loads(value)
+    except (TypeError, json.JSONDecodeError) as exc:
+        raise RuntimeError("批量删除状态包含无效列表") from exc
+    if (
+        not isinstance(decoded, list)
+        or any(not isinstance(item, str) or not item for item in decoded)
+        or len(set(decoded)) != len(decoded)
+    ):
+        raise RuntimeError("批量删除状态包含无效列表")
+    return decoded
+
+
+def _decode_target_versions(value: str) -> Dict[str, str]:
+    try:
+        decoded = json.loads(value)
+    except (TypeError, json.JSONDecodeError) as exc:
+        raise RuntimeError("批量删除状态包含无效目标") from exc
+    if not isinstance(decoded, dict) or any(
+        not isinstance(key, str)
+        or not key
+        or not isinstance(item, str)
+        for key, item in decoded.items()
+    ):
+        raise RuntimeError("批量删除状态包含无效目标")
+    return decoded
+
+
+def _validate_delete_operation(operation: MCPDeletionOperation) -> None:
+    targets = _decode_target_versions(operation.target_ids)
+    pending = _decode_string_list(operation.pending_ids)
+    failed = _decode_string_list(operation.failed_ids)
+    target_ids = set(targets)
+    pending_ids = set(pending)
+    failed_ids = set(failed)
+    if (
+        operation.status not in {"in_progress", "partial", "completed"}
+        or not pending_ids.issubset(target_ids)
+        or not failed_ids.issubset(pending_ids)
+        or operation.deleted != len(targets) - len(pending)
+        or operation.deleted < 0
+        or operation.status == "completed" and (pending or failed)
+        or operation.status == "partial" and (not failed or pending_ids != failed_ids)
+    ):
+        raise RuntimeError("批量删除持久化状态不一致")
+
+
+def _operation_response(operation: MCPDeletionOperation, *, replayed: bool) -> Dict[str, Any]:
+    _validate_delete_operation(operation)
+    return {
+        "status": operation.status,
+        "deleted": operation.deleted,
+        "failed_ids": _decode_string_list(operation.failed_ids),
+        "result_hash": operation.expected_hash,
+        "replayed": replayed,
+    }
+
+
+def _prune_expired_delete_operations(limit: int = 100) -> int:
+    cutoff = datetime.now(timezone.utc) - timedelta(seconds=MCP_DELETE_AUDIT_RETENTION_SECONDS)
+    with SessionLocal() as db, db.begin():
+        expired = list(
+            db.scalars(
+                select(MCPDeletionOperation)
+                .where(MCPDeletionOperation.expires_at < cutoff)
+                .order_by(MCPDeletionOperation.expires_at)
+                .limit(limit)
+            )
+        )
+        for operation in expired:
+            db.delete(operation)
+    return len(expired)
+
+
+def _claim_existing_operation(
+    deletion: InternalMemoryDelete,
+    lease_owner: str,
+) -> Optional[tuple[MCPDeletionOperation, bool]]:
+    now = datetime.now(timezone.utc)
+    scope_hash = _delete_scope_hash(deletion)
+    with SessionLocal() as db, db.begin():
+        operation = db.scalar(
+            select(MCPDeletionOperation)
+            .where(MCPDeletionOperation.jti == deletion.operation_id)
+            .with_for_update()
+        )
+        if operation is None:
+            return None
+        _validate_delete_operation(operation)
+        if operation.scope_hash != scope_hash or operation.expected_hash != deletion.expected_hash:
+            raise HTTPException(status_code=409, detail="删除操作范围不匹配")
+        if operation.status == "completed":
+            return operation, True
+        if operation.expires_at < now:
+            raise HTTPException(status_code=409, detail="删除操作已过期")
+        if operation.lease_until and operation.lease_until > now:
+            raise HTTPException(status_code=409, detail="删除操作正在执行")
+        operation.status = "in_progress"
+        operation.lease_owner = lease_owner
+        operation.lease_until = now + timedelta(seconds=MCP_DELETE_LEASE_SECONDS)
+        operation.updated_at = now
+        return operation, True
+
+
+def _create_delete_operation(
+    deletion: InternalMemoryDelete,
+    rows: List[Dict[str, Any]],
+    lease_owner: str,
+) -> tuple[MCPDeletionOperation, bool]:
+    now = datetime.now(timezone.utc)
+    expires_at = datetime.fromtimestamp(deletion.operation_expires_at, timezone.utc)
+    if expires_at <= now or expires_at > now + timedelta(minutes=15):
+        raise HTTPException(status_code=409, detail="删除操作过期时间无效")
+    targets = {
+        str(item["id"]): _memory_version(item)
+        for item in rows
+        if isinstance(item.get("id"), str) and item.get("id")
+    }
+    if len(targets) != deletion.expected_count:
+        raise HTTPException(status_code=409, detail="删除候选集合无效")
+    operation = MCPDeletionOperation(
+        jti=deletion.operation_id,
+        scope_hash=_delete_scope_hash(deletion),
+        expected_hash=deletion.expected_hash,
+        target_ids=json.dumps(targets, sort_keys=True, separators=(",", ":")),
+        pending_ids=json.dumps(list(targets), separators=(",", ":")),
+        failed_ids="[]",
+        deleted=0,
+        status="in_progress",
+        expires_at=expires_at,
+        lease_until=now + timedelta(seconds=MCP_DELETE_LEASE_SECONDS),
+        lease_owner=lease_owner,
+        updated_at=now,
+    )
+    try:
+        with SessionLocal() as db:
+            db.add(operation)
+            db.commit()
+    except IntegrityError:
+        existing = _claim_existing_operation(deletion, lease_owner)
+        if existing is None:
+            raise HTTPException(status_code=409, detail="删除操作发生冲突")
+        return existing
+    return operation, False
+
+
+def _save_delete_progress(
+    operation_id: uuid.UUID,
+    lease_owner: str,
+    pending: List[str],
+    failed: List[str],
+    target_count: int,
+    *,
+    finished: bool,
+) -> MCPDeletionOperation:
+    now = datetime.now(timezone.utc)
+    with SessionLocal() as db, db.begin():
+        operation = db.scalar(
+            select(MCPDeletionOperation)
+            .where(MCPDeletionOperation.jti == operation_id)
+            .with_for_update()
+        )
+        if operation is None or operation.lease_owner != lease_owner:
+            raise HTTPException(status_code=409, detail="删除操作执行权已失效")
+        operation.pending_ids = json.dumps(pending, separators=(",", ":"))
+        operation.failed_ids = json.dumps(failed, separators=(",", ":"))
+        operation.deleted = target_count - len(pending)
+        operation.updated_at = now
+        if finished:
+            operation.status = "partial" if pending else "completed"
+            operation.lease_owner = None
+            operation.lease_until = None
+        else:
+            operation.status = "in_progress"
+            operation.lease_until = now + timedelta(seconds=MCP_DELETE_LEASE_SECONDS)
+        return operation
+
+
+def _delete_item_still_matches(
+    item: Dict[str, Any],
+    deletion: InternalMemoryDelete,
+    expected_version: str,
+) -> bool:
+    if not _matches_managed_scope(item, deletion.project_id):
+        return False
+    if deletion.run_id and item.get("run_id") != deletion.run_id:
+        return False
+    cutoff = _parse_cutoff(deletion.cutoff)
+    created_at = _item_datetime(item.get("created_at"))
+    if cutoff and (created_at is None or created_at > cutoff):
+        return False
+    return hmac.compare_digest(_memory_version(item), expected_version)
