+@router.post("/batch/preview")
+def preview_batch(
+    body: BatchPreviewRequest,
+    user: User = Depends(require_admin),
+    db: Session = Depends(get_db),
+):
+    changes = _batch_request_data(body.changes)
+    if not any(
+        [
+            changes.get("text_find") is not None,
+            changes.get("metadata_patch") is not None,
+            changes.get("expiration_date_set"),
+            changes.get("project_id_set"),
+        ]
+    ):
+        raise HTTPException(status_code=422, detail="至少提供一种维护操作")
+    previews = []
+    versions = {}
+    for memory_id in body.memory_ids:
+        item = _get_memory(memory_id)
+        if item is None:
+            raise HTTPException(status_code=404, detail=f"记忆不存在：{memory_id}")
+        _metadata_for_update(item, changes)
+        preview = _preview_change(item, changes)
+        previews.append(preview)
+        versions[memory_id] = preview["version"]
+    preview_hash = memory_versions_hash(versions)
+    operation = MemoryOperation(
+        kind="batch",
+        status="preview",
+        request_data=changes,
+        targets={"versions": versions, "previews": previews},
+        preview_hash=preview_hash,
+        created_by=_actor_id(user),
+        expires_at=_utcnow() + timedelta(minutes=OPERATION_TTL_MINUTES),
+    )
+    db.add(operation)
+    db.commit()
+    db.refresh(operation)
+    log_memory_activity("batch_preview", user=user, details={"候选数量": len(previews)})
+    return {
+        "operation_id": str(operation.id),
+        "preview_hash": preview_hash,
+        "expires_at": operation.expires_at,
+        "count": len(previews),
+        "results": previews,
+    }
