diff --git a/openresty/api-proxy.conf b/openresty/api-proxy.conf
new file mode 100644
index 0000000000000000000000000000000000000000..cf9bac9225a01e75b145302939b7d42d4803f5c1
--- /dev/null
+++ b/openresty/api-proxy.conf
@@ -0,0 +1,74 @@
+location = /internal {
+    return 404;
+}
+
+location ^~ /internal/ {
+    return 404;
+}
+
+location = /api/health {
+    include /etc/nginx/mem0/cloudflare_real_ip.inc;
+    proxy_pass http://127.0.0.1:8888/api/readyz;
+    proxy_http_version 1.1;
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $remote_addr;
+    proxy_set_header X-Forwarded-Proto $scheme;
+    proxy_set_header Connection "";
+    proxy_connect_timeout 5s;
+    proxy_read_timeout 5s;
+    proxy_send_timeout 5s;
+    proxy_next_upstream off;
+    limit_req_status 429;
+    limit_req zone=mem0_api_perip burst=5 nodelay;
+    limit_conn_status 429;
+    limit_conn perip 4;
+}
+
+location = /auth/login {
+    include /etc/nginx/mem0/cloudflare_real_ip.inc;
+    proxy_pass http://127.0.0.1:8888;
+    proxy_http_version 1.1;
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $remote_addr;
+    proxy_set_header X-Forwarded-Proto $scheme;
+    proxy_set_header Connection "";
+    proxy_connect_timeout 5s;
+    proxy_read_timeout 15s;
+    proxy_send_timeout 15s;
+    proxy_next_upstream off;
+    client_max_body_size 64k;
+    limit_req_status 429;
+    limit_req zone=mem0_login_perip burst=5 nodelay;
+    limit_conn_status 429;
+    limit_conn perip 4;
+}
+
+location ^~ / {
+    include /etc/nginx/mem0/cloudflare_real_ip.inc;
+    proxy_pass http://127.0.0.1:8888;
+    proxy_http_version 1.1;
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $remote_addr;
+    proxy_set_header REMOTE-HOST $remote_addr;
+    proxy_set_header X-Forwarded-Proto $scheme;
+    proxy_set_header X-Forwarded-Port $server_port;
+    proxy_set_header Connection "";
+    proxy_connect_timeout 5s;
+    proxy_read_timeout 75s;
+    proxy_send_timeout 15s;
+    proxy_next_upstream off;
+    client_max_body_size 1m;
+    limit_req_status 429;
+    limit_req zone=mem0_api_perip burst=40 nodelay;
+    limit_conn_status 429;
+    limit_conn perip 16;
+    limit_conn perserver 64;
+    add_header X-Cache $upstream_cache_status;
+    proxy_ssl_server_name off;
+    proxy_ssl_name $proxy_host;
+    add_header Strict-Transport-Security "max-age=31536000" always;
+    add_header Alt-Svc 'h3=":443"; ma=2592000';
+}
