+@router.post("/search")
+def search_workbench(body: WorkbenchSearch, user: User = Depends(require_reader)):
+    started_at = time.perf_counter()
+    memory = get_memory_instance()
+    filters = {
+        key: value
+        for key, value in {
+            "user_id": body.user_id,
+            "agent_id": body.agent_id,
+            "run_id": body.run_id,
+            "project_id": body.project_id,
+        }.items()
+        if value
+    }
+    filters = scope_filters_for_user(user, filters)
+    candidate_limit = min(max(body.top_k * 5, 50), 500)
+    created_from = body.created_from
+    created_to = body.created_to
+    if created_from and created_from.tzinfo is None:
+        created_from = created_from.replace(tzinfo=timezone.utc)
+    if created_to and created_to.tzinfo is None:
+        created_to = created_to.replace(tzinfo=timezone.utc)
+    pushdown_fields = list(filters)
+    post_filter_fields: list[str] = []
+    if created_from or created_to:
+        created_condition = {}
+        if created_from:
+            created_condition["gte"] = created_from.astimezone(timezone.utc).isoformat()
+        if created_to:
+            created_condition["lte"] = created_to.astimezone(timezone.utc).isoformat()
+        filters["created_at"] = created_condition
+        pushdown_fields.append("created_at")
+    if body.memory_type:
+        filters["memory_type"] = body.memory_type
+        pushdown_fields.append("memory_type")
+    if body.category:
+        filters["$or"] = [
+            {"category": {"icontains": body.category}},
+            {"categories": {"contains": body.category}},
+        ]
+        pushdown_fields.append("category/categories")
+    supported_metadata_operators = {"eq", "ne", "contains", "icontains", "in", "nin", "gt", "gte", "lt", "lte"}
+    for key, condition in body.metadata.items():
+        if isinstance(condition, dict) and not set(condition).issubset(supported_metadata_operators):
+            post_filter_fields.append(f"metadata.{key}")
+            continue
+        filters[key] = condition
+        pushdown_fields.append(f"metadata.{key}")
+    try:
+        settings = get_governance_settings()
+        if body.search_mode == "hybrid" and settings.get("hybrid_search_enabled"):
+            candidates = hybrid_search(
+                body.query,
+                filters,
+                body.top_k,
+                body.threshold,
+                explain=body.explain,
+                show_expired=body.show_expired,
+                rerank=body.rerank,
+                final_score_threshold=body.final_score_threshold,
+                result_limit=candidate_limit,
+                filter_pushdown_fields=pushdown_fields,
+                post_filter_fields=post_filter_fields,
+            )
+        else:
+            candidates = memory._search_vector_store(
+                body.query,
+                filters,
+                candidate_limit,
+                body.threshold,
+                explain=body.explain,
+                show_expired=body.show_expired,
+            )
+        filtered: list[dict[str, Any]] = []
+        for item in candidates:
+            metadata = _metadata(item)
+            created_at = _parse_datetime(item.get("created_at"))
+            categories = metadata.get("categories") or metadata.get("category") or []
+            if isinstance(categories, str):
+                categories = [categories]
+            if created_from and (created_at is None or created_at < created_from):
+                continue
+            if created_to and (created_at is None or created_at > created_to):
+                continue
+            if body.memory_type and metadata.get("memory_type") != body.memory_type:
+                continue
+            if body.category and body.category.casefold() not in {str(item).casefold() for item in categories}:
+                continue
+            if body.metadata and not _metadata_matches(metadata, body.metadata):
+                continue
+            filtered.append(item)
+        if body.search_mode == "vector":
+            filtered = apply_feedback_ranking(
+                filtered, factors_enabled=bool(settings.get("feedback_ranking_enabled"))
+            )
+            filtered = apply_memory_decay(filtered)
+        reranked = bool(body.rerank and memory.reranker and filtered)
+        for index, item in enumerate(filtered):
+            item["reranked"] = reranked
+            item["rerank_position"] = index + 1
+        filtered = filtered[: body.top_k]
+        for index, item in enumerate(filtered):
+            item["final_position"] = index + 1
+        ids = [str(item["id"]) for item in filtered if item.get("id")]
+        retrieval_id = record_retrieval(
+            query=body.query,
+            results=filtered,
+            mode=body.search_mode,
+            project_id=body.project_id,
+            latency_ms=(time.perf_counter() - started_at) * 1000,
+            source="workbench",
+            actor_id=_actor_id(user),
+            status="ok" if filtered else "no_results",
+        )
+        log_memory_activity(
+            "search",
+            user=user,
+            source="workbench",
+            details={
+                "结果数量": len(ids),
+                "启用重排": body.rerank,
+                "启用衰减": True,
+                "检索模式": body.search_mode,
+            },
+        )
+        return {
+            "results": filtered,
+            "count": len(filtered),
+            "retrieval_id": retrieval_id,
+            "retrieval_mode": body.search_mode,
+            "status": "ok" if filtered else "no_results",
+            "error": None,
+        }
+    except HTTPException as exc:
+        record_retrieval(
+            query=body.query,
+            results=[],
+            mode=body.search_mode,
+            project_id=body.project_id,
+            latency_ms=(time.perf_counter() - started_at) * 1000,
+            source="workbench",
+            actor_id=_actor_id(user),
+            status="error",
+            error_type=f"HTTP_{exc.status_code}",
+        )
+        raise
+    except Exception as exc:
+        record_retrieval(
+            query=body.query,
+            results=[],
+            mode=body.search_mode,
+            project_id=body.project_id,
+            latency_ms=(time.perf_counter() - started_at) * 1000,
+            source="workbench",
+            actor_id=_actor_id(user),
+            status="error",
+            error_type=type(exc).__name__,
+        )
+        log_memory_activity(
+            "search", user=user, source="workbench", success=False, details={"错误类型": type(exc).__name__}
+        )
+        logging.exception("检索工作台执行失败")
+        raise HTTPException(status_code=502, detail="检索服务暂时不可用") from exc
+
