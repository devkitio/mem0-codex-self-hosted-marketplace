+        )
+        self.assertEqual(preview["after_text"], "用户喜欢新主题")
+        self.assertEqual(preview["changed_fields"], ["正文", "项目范围"])
+
+    def test_dream_canonicalization_and_preview_hash_are_stable(self):
+        self.assertEqual(governance_router._canonical_memory("  用户-喜欢 深色！"), "用户喜欢深色")
+        first = memory_versions_hash({"b": "2", "a": "1"})
+        second = memory_versions_hash({"a": "1", "b": "2"})
+        self.assertEqual(first, second)
+
+    def test_dream_llm_proposals_reject_overlapping_targets(self):
+        memory = MagicMock()
+        memory.llm.generate_response.return_value = json.dumps(
+            {
+                "proposals": [
+                    {
+                        "type": "duplicate",
+                        "memory_ids": ["a", "b"],
+                        "keep_id": "a",
+                        "reason": "重复",
+                        "suggested_text": "保留 a",
+                    },
+                    {
+                        "type": "conflict",
+                        "memory_ids": ["b", "c"],
+                        "keep_id": "c",
+                        "reason": "冲突",
+                        "suggested_text": "保留 c",
+                    },
+                    {
+                        "type": "profile",
+                        "memory_ids": ["c", "c"],
+                        "keep_id": "c",
+                        "reason": "无效重复 ID",
+                        "suggested_text": "保留 c",
+                    },
+                ]
+            }
+        )
+        rows = [
+            {"id": "a", "memory": "A"},
+            {"id": "b", "memory": "B"},
+            {"id": "c", "memory": "C"},
+        ]
+        with (
+            patch.object(governance_router, "get_memory_instance", return_value=memory),
+            patch.object(
+                governance_router,
+                "get_governance_settings",
+                return_value={"sensitive_data_types": ["email", "phone"]},
+            ),
+        ):
+            proposals = governance_router._llm_dream_proposals(rows)
+        self.assertEqual([proposal["memory_ids"] for proposal in proposals], [["a", "b"]])
+
+    def test_dream_due_check_uses_global_lock_and_respects_disabled_setting(self):
+        db = MagicMock()
+        db.scalar.return_value = True
+        user = MagicMock()
+        with patch.object(
+            governance_router,
+            "get_governance_settings",
+            return_value={"dream_enabled": False},
+        ):
+            result = governance_router._run_due_dream_if_due(user, db)
+        self.assertFalse(result["due"])
+        db.scalar.assert_called_once()
+        db.execute.assert_called_once()
+        db.commit.assert_called_once_with()
+
+
+if __name__ == "__main__":
+    unittest.main()
