+++ b/tests/test_memory_contract_v2.py
@@ -0,0 +1,78 @@
+import json
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from mem0.memory.main import _canonicalize_memory_payload, _validated_linked_memory_ids
+from mem0.memory.storage import SQLiteManager
+
+
+FIXTURE_PATH = Path(__file__).parent / "fixtures" / "memory_contract_v2.json"
+
+
+class MemoryContractV2Tests(unittest.TestCase):
+    def test_python_payload_matches_shared_contract(self):
+        fixture = json.loads(FIXTURE_PATH.read_text(encoding="utf-8"))
+        payload = _canonicalize_memory_payload(
+            {
+                **fixture["python_metadata"],
+                "data": fixture["data"],
+                "created_at": fixture["created_at"],
+                "updated_at": fixture["updated_at"],
+            },
+            fixture["data"],
+            fixture["memory_id"],
+        )
+        for key, value in fixture["expected"].items():
+            self.assertEqual(payload[key], value)
+
+    def test_python_history_persists_complete_payload(self):
+        fixture = json.loads(FIXTURE_PATH.read_text(encoding="utf-8"))
+        with TemporaryDirectory() as directory:
+            database_path = str(Path(directory) / "history.db")
+            manager = SQLiteManager(database_path)
+            manager.add_history(
+                fixture["memory_id"],
+                None,
+                fixture["data"],
+                "ADD",
+                created_at=fixture["created_at"],
+                updated_at=fixture["updated_at"],
+                actor_id="actor-1",
+                role="user",
+                after_payload=fixture["expected"],
+                operation_id="operation-1",
+                reason="黄金契约测试",
+                source_type="user_statement",
+                source_id="conversation-1",
+                source_message_id="message-1",
+                status="active",
+                payload_version=fixture["expected"]["payload_version"],
+            )
+            manager.close()
+
+            reopened = SQLiteManager(database_path)
+            history = reopened.get_history(fixture["memory_id"])
+            reopened.close()
+
+        self.assertEqual(len(history), 1)
+        self.assertIsNone(history[0]["old_memory"])
+        self.assertEqual(history[0]["new_memory"], fixture["data"])
+        self.assertEqual(history[0]["event"], "ADD")
+        self.assertEqual(history[0]["actor_id"], "actor-1")
+        self.assertEqual(history[0]["role"], "user")
+        self.assertEqual(history[0]["after_payload"], fixture["expected"])
+        self.assertEqual(history[0]["payload_version"], fixture["expected"]["payload_version"])
+
+    def test_model_linked_ids_must_exist_in_current_mapping(self):
+        self.assertEqual(
+            _validated_linked_memory_ids(
+                ["0", "unknown", "1", "0"],
+                {"0": "memory-a", "1": "memory-b"},
+            ),
+            ["memory-a", "memory-b"],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
