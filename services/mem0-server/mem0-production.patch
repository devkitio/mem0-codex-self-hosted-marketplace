+@app.post("/internal/mcp/feedback", include_in_schema=False)
+def internal_mcp_feedback(
+    request: InternalFeedback,
+    _internal=Depends(_verify_internal_request),
+):
+    memory_id = str(request.memory_id)
+    current = get_memory_instance().get(memory_id)
+    if not isinstance(current, dict) or not _matches_managed_scope(current, request.project_id):
+        raise HTTPException(status_code=404, detail="受管记忆不存在")
+    metadata = _internal_metadata(current)
+    with SessionLocal() as db:
+        catalog = db.get(MemoryCatalog, memory_id)
+        payload_version = catalog.payload_version if catalog else memory_payload_version(current)
+        row = db.scalar(
+            select(MemoryFeedback).where(
+                MemoryFeedback.memory_id == memory_id,
+                MemoryFeedback.payload_version == payload_version,
+                MemoryFeedback.actor_key == request.actor_key,
+            )
+        )
+        if row is None:
+            row = MemoryFeedback(
+                memory_id=memory_id,
+                payload_version=payload_version,
+                actor_key=request.actor_key,
+                project_id=request.project_id,
+            )
+            db.add(row)
+        row.verdict = request.verdict
+        row.reason = request.reason.strip() if request.reason and request.reason.strip() else None
+        db.commit()
+    record_effective_access(
+        [memory_id],
+        event_type="feedback",
+        retrieval_id=request.retrieval_id,
+        project_id=request.project_id,
+        source="mcp",
+    )
+    log_memory_activity(
+        "feedback",
+        memory_id=memory_id,
+        source="mcp",
+        details={"审查结论": request.verdict, "项目": metadata.get("project_id") or "全局"},
+    )
+    return {"ok": True, "memory_id": memory_id, "payload_version": payload_version, "verdict": request.verdict}
