+def _memory_payload(item: dict[str, Any], existing: Any = None) -> dict[str, Any]:
+    metadata = dict(item.get("metadata") or {})
+    for key in ("user_id", "agent_id", "run_id", "expiration_date"):
+        if item.get(key) is not None:
+            metadata[key] = item[key]
+    data = str(item.get("memory") or "")
+    now = _utcnow().isoformat()
+    existing_payload = dict(getattr(existing, "payload", None) or {})
+    metadata.update(
+        {
+            "data": data,
+            "hash": hashlib.md5(data.encode()).hexdigest(),  # 兼容 Mem0 既有内容哈希
+            "text_lemmatized": lemmatize_for_bm25(data),
+            "created_at": item.get("created_at") or existing_payload.get("created_at") or now,
+            "updated_at": now,
+        }
+    )
+    return metadata
