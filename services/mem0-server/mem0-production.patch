+def _update_job(job_id: uuid.UUID, **values: Any) -> None:
+    with SessionLocal() as db:
+        job = db.get(BackgroundJob, job_id)
+        if job is None:
+            return
+        for key, value in values.items():
+            setattr(job, key, value)
+        db.commit()
+
+
+def _claim_job(job_id: uuid.UUID) -> bool:
+    with SessionLocal() as db:
+        result = db.execute(
+            update(BackgroundJob)
+            .where(BackgroundJob.id == job_id, BackgroundJob.status == "queued")
+            .values(status="running", progress=1, started_at=_utcnow(), error=None)
+        )
+        db.commit()
+        return result.rowcount == 1
+
+
+def _run_job(job_id: uuid.UUID, handler: Callable[[uuid.UUID], dict[str, Any]]) -> None:
+    if not _claim_job(job_id):
+        return
+    try:
+        result = handler(job_id)
+    except Exception as exc:
+        logging.exception("后台任务执行失败：%s", job_id)
+        _update_job(
+            job_id,
+            status="failed",
+            progress=100,
+            error=f"{type(exc).__name__}: {str(exc)[:1000]}",
+            finished_at=_utcnow(),
+        )
+        return
+    _update_job(job_id, status="completed", progress=100, result=result, finished_at=_utcnow())
+
+
+def queue_background_job(job_id: uuid.UUID) -> None:
+    with _JOB_SUBMIT_LOCK, SessionLocal() as db:
+        job = db.get(BackgroundJob, job_id)
+        if job is None or job.status not in {"preview", "queued"}:
+            raise HTTPException(status_code=409, detail="任务当前状态不能执行。")
+        handlers = {
+            "backup": _execute_backup,
+            "restore": _execute_restore,
+            "import": _execute_import,
+            "evaluation": _execute_evaluation,
+        }
+        handler = handlers[job.kind]
+        job.status = "queued"
+        job.progress = 0
+        db.commit()
+    _JOB_EXECUTOR.submit(_run_job, job_id, handler)
+
+
+def recover_interrupted_jobs() -> None:
+    with SessionLocal() as db:
+        jobs = db.scalars(select(BackgroundJob).where(BackgroundJob.status.in_(["queued", "running"]))).all()
+        for job in jobs:
+            job.status = "failed"
+            job.progress = 100
+            job.error = "服务重启时任务尚未完成，请重新提交。"
+            job.finished_at = _utcnow()
+        db.commit()
+        runs = db.scalars(
+            select(SearchEvaluationRun).where(SearchEvaluationRun.status.in_(["queued", "running"]))
+        ).all()
+        for run in runs:
+            run.status = "failed"
+            run.error = "服务重启时评测尚未完成，请重新提交。"
+            run.finished_at = _utcnow()
+        db.commit()
+
