+def verify_restart_state() -> None:
+    deletion = main.InternalMemoryDelete.model_validate_json(
+        RESTART_STATE_PATH.read_text(encoding="utf-8")
+    )
+    try:
+        claimed, replayed = main._claim_existing_operation(deletion, "restarted-process")
+        if not replayed or claimed.status != "in_progress":
+            raise AssertionError("重启后未能接管过期租约")
+        completed = main._save_delete_progress(
+            deletion.operation_id,
+            "restarted-process",
+            [],
+            [],
+            1,
+            finished=True,
+        )
+        if completed.status != "completed" or completed.deleted != 1:
+            raise AssertionError("重启后操作未收敛")
+        print("跨进程租约恢复通过")
+    finally:
+        with main.SessionLocal() as db:
+            stored = db.get(MCPDeletionOperation, deletion.operation_id)
+            if stored is not None:
+                db.delete(stored)
+                db.commit()
+        RESTART_STATE_PATH.unlink(missing_ok=True)
