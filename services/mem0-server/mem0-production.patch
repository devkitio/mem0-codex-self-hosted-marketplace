+  const [metadataPatch, setMetadataPatch] = useState("{}");
+  const [expirationEnabled, setExpirationEnabled] = useState(false);
+  const [expirationDate, setExpirationDate] = useState("");
+  const [projectEnabled, setProjectEnabled] = useState(false);
+  const [projectId, setProjectId] = useState("");
+  const [previewing, setPreviewing] = useState(false);
+  const [executing, setExecuting] = useState(false);
+  const [preview, setPreview] = useState<BatchPreviewResponse | null>(null);
+  const [visibleCount, setVisibleCount] = useState(BATCH_PAGE_SIZE);
+
+  const filtered = useMemo(() => {
+    const needle = filter.trim().toLowerCase();
+    if (!needle) return memories;
+    return memories.filter((memory) =>
+      [
+        memory.memory,
+        memory.id,
+        memory.user_id,
+        memory.agent_id,
+        memory.run_id,
+        JSON.stringify(memory.metadata ?? {}),
+      ].some((value) =>
+        String(value ?? "")
+          .toLowerCase()
+          .includes(needle),
+      ),
+    );
+  }, [filter, memories]);
+  const visibleMemories = filtered.slice(0, visibleCount);
+
+  useEffect(() => {
+    setVisibleCount(BATCH_PAGE_SIZE);
+  }, [filter, memories]);
+
+  const toggle = (memoryId: string, checked: boolean) => {
+    if (
+      checked &&
+      !selected.has(memoryId) &&
+      selected.size >= MAX_BATCH_SELECTION
+    ) {
+      toast({
+        title: `单次最多选择 ${MAX_BATCH_SELECTION} 条记忆`,
+        variant: "destructive",
+      });
+      return;
+    }
+    setSelected((current) => {
+      const next = new Set(current);
+      if (checked) next.add(memoryId);
+      else next.delete(memoryId);
+      return next;
+    });
+  };
+
+  const selectFiltered = () => {
+    const remaining = MAX_BATCH_SELECTION - selected.size;
+    if (remaining <= 0) {
+      toast({
+        title: `已达到 ${MAX_BATCH_SELECTION} 条上限`,
+        variant: "destructive",
+      });
+      return;
+    }
+    const candidates = filtered
+      .map((memory) => memory.id)
+      .filter((memoryId) => !selected.has(memoryId));
+    setSelected(
+      (current) => new Set([...current, ...candidates.slice(0, remaining)]),
+    );
+    if (candidates.length > remaining) {
+      toast({
+        title: `已选择前 ${MAX_BATCH_SELECTION} 条匹配记忆`,
+        description: "批量维护接口单次最多处理 500 条，请分批执行其余结果。",
+      });
+    }
