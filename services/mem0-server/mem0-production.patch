+load_dotenv()
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from mcp_scope import derive_mcp_agent_id, validate_mcp_identity  # noqa: E402
+
+TABLE_PATTERN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,62}$")
+PROJECT_ID_PATTERN = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
+MIGRATION_LOCK = "mem0:mcp-scope-backfill:v1"
+MIGRATION_LOCK_TIMEOUT_SECONDS = 5.0
+ROW_LOCK_TIMEOUT = "5s"
