+def _run_due_backup() -> None:
+    from db import SessionLocal
+
+    with SessionLocal() as db:
+        settings = get_governance_settings(db)
+        if not settings.get("backup_enabled"):
+            return
+        locked = db.scalar(
+            text("SELECT pg_try_advisory_xact_lock(hashtextextended(:name, 0))"),
+            {"name": BACKUP_SCHEDULER_LOCK},
+        )
+        if not locked:
+            return
+        active = db.scalar(
+            select(func.count(BackgroundJob.id)).where(
+                BackgroundJob.kind == "backup",
+                BackgroundJob.status.in_(["queued", "running"]),
+            )
+        )
+        if active:
+            return
+        last_raw = settings.get("backup_last_run_at")
+        last = None
+        if isinstance(last_raw, str):
+            try:
+                last = datetime.fromisoformat(last_raw.replace("Z", "+00:00"))
+            except ValueError:
+                last = None
+        interval = timedelta(hours=max(1, min(int(settings.get("backup_interval_hours", 24)), 720)))
+        if last is not None and _utcnow() - last.astimezone(timezone.utc) < interval:
+            return
+        job = _create_job(db, None, kind="backup", summary="自动备份")
+    queue_background_job(job.id)
+
+
+async def _backup_scheduler_loop() -> None:
+    while True:
+        await asyncio.to_thread(_run_due_backup)
+        await asyncio.sleep(BACKUP_POLL_SECONDS)
+
+
+@asynccontextmanager
+async def platform_lifespan(_app):
+    global BACKUP_SCHEDULER_TASK
+    recover_interrupted_jobs()
+    if BACKUP_SCHEDULER_TASK is None or BACKUP_SCHEDULER_TASK.done():
+        BACKUP_SCHEDULER_TASK = asyncio.create_task(_backup_scheduler_loop(), name="mem0-backup-scheduler")
+    try:
+        yield
+    finally:
+        if BACKUP_SCHEDULER_TASK is not None:
+            BACKUP_SCHEDULER_TASK.cancel()
+            with suppress(asyncio.CancelledError):
+                await BACKUP_SCHEDULER_TASK
+            BACKUP_SCHEDULER_TASK = None
