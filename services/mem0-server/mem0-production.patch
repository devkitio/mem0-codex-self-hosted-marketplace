+def _upsert_memory_items(items: list[dict[str, Any]], mode: str, job_id: uuid.UUID) -> dict[str, Any]:
+    memory = get_memory_instance()
+    created = updated = skipped = failed = 0
+    errors: list[dict[str, str]] = []
+    total = max(len(items), 1)
+    for index, item in enumerate(items):
+        try:
+            data = str(item.get("memory") or "").strip()
+            if not data:
+                raise ValueError("记忆正文为空")
+            raw_id = str(item.get("id") or "")
+            try:
+                memory_id = str(uuid.UUID(raw_id)) if raw_id else str(uuid.uuid4())
+            except ValueError:
+                memory_id = str(uuid.uuid4())
+            existing = memory.vector_store.get(memory_id)
+            if existing is not None and mode == "skip":
+                skipped += 1
+                continue
+            payload = _memory_payload(item, existing)
+            vector = memory.embedding_model.embed(data, memory_action="add")
+            if existing is None:
+                memory.vector_store.insert(vectors=[vector], ids=[memory_id], payloads=[payload])
+                memory.db.add_history(
+                    memory_id, None, data, "ADD", created_at=payload["created_at"], updated_at=payload["updated_at"]
+                )
+                created += 1
+            else:
+                old_data = str(getattr(existing, "payload", {}).get("data") or "")
+                memory.vector_store.update(vector_id=memory_id, vector=vector, payload=payload)
+                memory.db.add_history(
+                    memory_id,
+                    old_data,
+                    data,
+                    "UPDATE",
+                    created_at=payload["created_at"],
+                    updated_at=payload["updated_at"],
+                )
+                updated += 1
+        except Exception as exc:
+            failed += 1
+            if len(errors) < 50:
+                errors.append({"id": str(item.get("id") or index), "error": str(exc)[:300]})
+        if index % 10 == 0:
+            _update_job(job_id, progress=min(95, 5 + int((index + 1) / total * 90)))
+    return {"created": created, "updated": updated, "skipped": skipped, "failed": failed, "errors": errors}
+
+
+def _replace_memory_items(
+    items: list[dict[str, Any]],
+    job_id: uuid.UUID,
+    *,
+    record_history: bool = True,
+) -> dict[str, Any]:
+    if len(items) > MAX_BACKUP_ITEMS:
+        raise RuntimeError(f"恢复内容超过 {MAX_BACKUP_ITEMS} 条记忆限制。")
+    memory = get_memory_instance()
+    replace_all = getattr(memory.vector_store, "replace_all", None)
+    if not callable(replace_all):
+        raise RuntimeError("当前向量存储不支持原子替换恢复。")
+    history_records: list[dict[str, Any]] = []
+    total = max(len(items), 1)
+
+    def rows():
+        for index, item in enumerate(items):
+            data = str(item.get("memory") or "").strip()
+            if not data:
+                raise ValueError(f"第 {index + 1} 条记忆正文为空")
+            raw_id = str(item.get("id") or "")
+            try:
+                memory_id = str(uuid.UUID(raw_id)) if raw_id else str(uuid.uuid4())
+            except ValueError:
+                memory_id = str(uuid.uuid4())
+            payload = _memory_payload({**item, "memory": data})
+            vector = memory.embedding_model.embed(data, memory_action="add")
+            history_records.append(
+                {
+                    "memory_id": memory_id,
+                    "old_memory": None,
+                    "new_memory": data,
+                    "event": "ADD",
+                    "created_at": payload["created_at"],
+                    "updated_at": payload["updated_at"],
+                    "actor_id": payload.get("actor_id"),
+                    "role": payload.get("role"),
+                }
+            )
+            if index % 10 == 0:
+                _update_job(job_id, progress=min(90, 5 + int((index + 1) / total * 85)))
+            yield memory_id, vector, payload
+
+    replace_all(rows())
+    entity_store = getattr(memory, "_entity_store", None)
+    if entity_store is not None:
+        try:
+            entity_store.reset()
+        except Exception:
+            logging.warning("恢复后重置实体存储失败", exc_info=True)
+        memory._entity_store = None
+    if record_history and history_records:
+        memory.db.batch_add_history(history_records)
+    return {"created": len(history_records), "updated": 0, "skipped": 0, "failed": 0, "errors": []}
+
+
+def _execute_restore(job_id: uuid.UUID) -> dict[str, Any]:
+    with SessionLocal() as db:
+        job = db.get(BackgroundJob, job_id)
+        request = dict(job.request_data)
+    payload = load_backup(str(request["filename"]))
+    if request.get("backup_hash") != preview_hash(payload):
+        raise RuntimeError("备份文件在预览后发生变化，请重新生成恢复预览。")
+    mode = str(request.get("mode") or "merge")
+    safety_backup = None
+    if mode == "replace":
+        safety_backup = _execute_backup(job_id)
+        safety_payload = load_backup(str(safety_backup["filename"]))
+        try:
+            result = _replace_memory_items(payload["memories"], job_id)
+        except Exception as restore_error:
+            try:
+                _replace_memory_items(safety_payload["memories"], job_id, record_history=False)
+            except Exception as rollback_error:
+                raise RuntimeError("替换恢复失败，且安全备份自动回滚失败。") from rollback_error
+            raise RuntimeError("替换恢复失败，已从安全备份自动回滚。") from restore_error
+    else:
+        result = _upsert_memory_items(payload["memories"], "update", job_id)
+    with SessionLocal() as db:
+        owner_id = db.get(BackgroundJob, job_id).created_by
+        if owner_id:
+            existing_names = set(db.scalars(select(Category.name).where(Category.created_by == owner_id)).all())
+            for name in payload.get("categories") or []:
+                if isinstance(name, str) and name not in existing_names:
+                    db.add(Category(name=name[:80], created_by=owner_id))
+        governance = (payload.get("settings") or {}).get("memory_governance")
+        if isinstance(governance, dict):
+            save_governance_settings(governance, db)
+        else:
+            db.commit()
+    result.update(
+        {
+            "filename": request["filename"],
+            "mode": mode,
+            "safety_backup": safety_backup,
+        }
+    )
+    return result
+
+
+def parse_import_content(format_name: str, content: str) -> list[dict[str, Any]]:
+    if len(content.encode("utf-8")) > MAX_IMPORT_BYTES:
+        raise HTTPException(status_code=413, detail="导入文件超过 8 MB 限制。")
+    if format_name == "csv":
+        rows = []
+        for row in csv.DictReader(io.StringIO(content)):
+            metadata_raw = row.get("metadata") or "{}"
+            try:
+                metadata = json.loads(metadata_raw)
+            except json.JSONDecodeError as exc:
+                raise HTTPException(status_code=422, detail="CSV 中的 metadata 不是有效 JSON。") from exc
+            rows.append({**row, "metadata": metadata})
+    else:
+        try:
+            payload = json.loads(content)
+        except json.JSONDecodeError as exc:
+            raise HTTPException(status_code=422, detail="JSON 文件格式无效。") from exc
+        if isinstance(payload, list):
+            rows = payload
+        elif isinstance(payload, dict) and payload.get("schema_version") in {EXPORT_SCHEMA, BACKUP_SCHEMA}:
+            rows = payload.get("memories")
+        else:
+            raise HTTPException(status_code=422, detail="只支持 Mem0 导出、备份格式或记忆数组。")
+    if not isinstance(rows, list) or not 1 <= len(rows) <= MAX_JOB_ITEMS:
+        raise HTTPException(status_code=422, detail=f"单次导入必须包含 1 到 {MAX_JOB_ITEMS} 条记忆。")
+    output = []
+    for index, row in enumerate(rows):
+        if not isinstance(row, dict) or not str(row.get("memory") or "").strip():
+            raise HTTPException(status_code=422, detail=f"第 {index + 1} 条记忆缺少正文。")
+        metadata = row.get("metadata") or {}
+        if not isinstance(metadata, dict):
+            raise HTTPException(status_code=422, detail=f"第 {index + 1} 条记忆的 metadata 必须是对象。")
+        output.append(
+            {
+                key: row.get(key)
+                for key in (
+                    "id",
+                    "memory",
+                    "user_id",
+                    "agent_id",
+                    "run_id",
+                    "expiration_date",
+                    "metadata",
+                    "created_at",
+                    "updated_at",
+                )
+            }
+        )
+    return output
+
+
+def _execute_import(job_id: uuid.UUID) -> dict[str, Any]:
+    with SessionLocal() as db:
+        job = db.get(BackgroundJob, job_id)
+        request = dict(job.request_data)
+    return _upsert_memory_items(list(request["items"]), str(request.get("mode") or "skip"), job_id)
+
+
+def _evaluation_results(query: str, project_id: str | None, top_k: int, mode: str) -> list[dict[str, Any]]:
+    filters = {"project_id": project_id} if project_id else {}
+    memory = get_memory_instance()
+    if mode == "keyword":
+        keyword = getattr(memory.vector_store, "keyword_search", None)
+        return [_search_item_from_output(row) for row in (keyword(query, top_k=top_k, filters=filters) or [])]
+    if mode == "vector":
+        return memory._search_vector_store(query, filters, top_k, 0.0, explain=False)
+    return hybrid_search(query, filters, top_k, 0.0, explain=False)
+
+
+def _execute_evaluation(job_id: uuid.UUID) -> dict[str, Any]:
+    with SessionLocal() as db:
+        job = db.get(BackgroundJob, job_id)
+        request = dict(job.request_data)
+        case_ids = [uuid.UUID(value) for value in request["case_ids"]]
+        cases = db.scalars(select(SearchEvaluationCase).where(SearchEvaluationCase.id.in_(case_ids))).all()
+    mode = str(request.get("mode") or "hybrid")
+    details = []
+    reciprocal_rank_sum = 0.0
+    hits = 0
+    for index, case in enumerate(cases):
+        results = _evaluation_results(case.query, case.project_id, case.top_k, mode)
+        rank = None
+        for result_index, result in enumerate(results, start=1):
+            id_match = case.expected_memory_id and str(result.get("id")) == case.expected_memory_id
+            text_match = (
+                case.expected_text and case.expected_text.casefold() in str(result.get("memory") or "").casefold()
+            )
+            if id_match or text_match:
+                rank = result_index
+                break
+        if rank is not None:
+            hits += 1
+            reciprocal_rank_sum += 1.0 / rank
+        details.append({"case_id": str(case.id), "name": case.name, "hit": rank is not None, "rank": rank})
+        _update_job(job_id, progress=min(95, 5 + int((index + 1) / max(len(cases), 1) * 90)))
+    total = len(cases)
+    return {
+        "mode": mode,
+        "total": total,
+        "hits": hits,
+        "hit_rate": round(hits / total, 6) if total else 0.0,
+        "mrr": round(reciprocal_rank_sum / total, 6) if total else 0.0,
+        "details": details,
+    }
+
+
+def _relevance_for_result(result: dict[str, Any], relevant: list[dict[str, Any]]) -> tuple[str | None, float]:
+    result_id = str(result.get("id") or "")
+    result_text = str(result.get("memory") or "").casefold()
+    for item in relevant:
+        memory_id = str(item.get("memory_id") or "")
+        text_value = str(item.get("text") or "").strip().casefold()
+        if (memory_id and result_id == memory_id) or (text_value and text_value in result_text):
+            try:
+                grade = max(float(item.get("relevance", 1)), 0.0)
+            except (TypeError, ValueError):
+                grade = 1.0
+            return memory_id or text_value, grade
+    return None, 0.0
+
+
+def _case_metrics(results: list[dict[str, Any]], relevant: list[dict[str, Any]], top_k: int) -> tuple[dict[str, float], dict[str, int]]:
+    valid_relevant: list[dict[str, Any]] = []
+    seen_targets: set[str] = set()
+    for item in relevant:
+        if not isinstance(item, dict):
+            continue
+        memory_id = str(item.get("memory_id") or "").strip()
+        text_value = str(item.get("text") or "").strip()
+        if not memory_id and not text_value:
+            continue
+        try:
+            grade = float(item.get("relevance", 1) or 0)
+        except (TypeError, ValueError):
+            continue
+        if not math.isfinite(grade) or grade <= 0:
+            continue
+        target_key = f"id:{memory_id}" if memory_id else f"text:{text_value.casefold()}"
+        if target_key in seen_targets:
+            continue
+        seen_targets.add(target_key)
+        valid_relevant.append({**item, "relevance": grade})
+    matched: set[str] = set()
+    ranks: dict[str, int] = {}
+    gains: list[float] = []
+    first_rank = None
+    for rank, result in enumerate(results[:top_k], start=1):
+        key, grade = _relevance_for_result(result, valid_relevant)
+        gains.append(grade)
+        if key is None:
+            continue
+        matched.add(key)
+        ranks.setdefault(key, rank)
+        first_rank = first_rank or rank
+    recall = len(matched) / len(valid_relevant) if valid_relevant else 0.0
+    precision = len(matched) / max(top_k, 1)
+    reciprocal_rank = 1.0 / first_rank if first_rank else 0.0
+    dcg = sum((math.pow(2.0, grade) - 1.0) / math.log2(rank + 1) for rank, grade in enumerate(gains, start=1))
+    ideal_grades = sorted((float(item.get("relevance", 1) or 0) for item in valid_relevant), reverse=True)[:top_k]
+    ideal_dcg = sum(
+        (math.pow(2.0, grade) - 1.0) / math.log2(rank + 1)
+        for rank, grade in enumerate(ideal_grades, start=1)
+    )
+    return (
+        {
+            "recall_at_k": round(recall, 6),
+            "precision_at_k": round(precision, 6),
+            "mrr": round(reciprocal_rank, 6),
+            "ndcg_at_k": round(dcg / ideal_dcg, 6) if ideal_dcg else 0.0,
+        },
+        ranks,
+    )
+
+
+def _execute_evaluation_v2(run_id: uuid.UUID) -> None:
+    with SessionLocal() as db:
+        run = db.get(SearchEvaluationRun, run_id)
+        if run is None or run.status != "queued":
+            return
+        run.status = "running"
+        db.commit()
+        cases = db.scalars(
+            select(SearchEvaluationCaseV2).where(SearchEvaluationCaseV2.dataset_id == run.dataset_id)
+        ).all()
+        mode = run.mode
+    case_summaries: list[
+        tuple[SearchEvaluationCaseV2, dict[str, Any], dict[str, int], float, str | None, str | None]
+    ] = []
+    try:
+        for case in cases:
+            started_at = time.perf_counter()
+            error_type = None
+            try:
+                results = _evaluation_results(case.query, case.project_id, case.top_k, mode)
+            except Exception as exc:
+                logging.warning("评测用例检索失败：%s", case.id, exc_info=True)
+                results = []
+                error_type = type(exc).__name__
+            latency_ms = (time.perf_counter() - started_at) * 1000
+            metrics, ranks = _case_metrics(results, list(case.relevant or []), case.top_k)
+            if error_type:
+                metrics["error_type"] = error_type
+            actual_write_decision = None
+            if isinstance(case.write_input, dict):
+                write_input = case.write_input
+                assessment = assess_risk_write(
+                    text_value=str(write_input.get("text_value") or write_input.get("text") or ""),
+                    messages=list(write_input.get("messages") or []),
+                    metadata=dict(write_input.get("metadata") or {}),
+                    conflicts=list(write_input.get("conflicts") or []),
+                )
+                actual_write_decision = str(assessment["decision"])
+                metrics["expected_write_decision"] = case.expected_write_decision
+                metrics["actual_write_decision"] = actual_write_decision
+            case_summaries.append((case, metrics, ranks, latency_ms, error_type, actual_write_decision))
+        names = ("recall_at_k", "precision_at_k", "mrr", "ndcg_at_k")
+        totals = {
+            name: round(sum(item[1][name] for item in case_summaries) / len(case_summaries), 6)
+            if case_summaries else 0.0
+            for name in names
+        }
+        def percentile_95(values: list[float]) -> float:
+            ordered = sorted(values)
+            index = max(math.ceil(len(ordered) * 0.95) - 1, 0)
+            return round(ordered[index], 3) if ordered else 0.0
+
+        latencies = [item[3] for item in case_summaries]
+        ordinary_latencies = [
+            item[3] for item in case_summaries
+            if item[0].query_type == "ordinary"
+            or (item[0].query_type == "auto" and not _complex_query(item[0].query))
+        ]
+        complex_latencies = [
+            item[3] for item in case_summaries
+            if item[0].query_type == "complex"
+            or (item[0].query_type == "auto" and _complex_query(item[0].query))
+        ]
+        totals["p95_latency_ms"] = percentile_95(latencies)
+        totals["ordinary_p95_latency_ms"] = percentile_95(ordinary_latencies)
+        totals["complex_p95_latency_ms"] = percentile_95(complex_latencies)
+        totals["case_count"] = len(case_summaries)
+        totals["error_count"] = sum(1 for item in case_summaries if item[4])
+        totals["error_rate"] = round(totals["error_count"] / len(case_summaries), 6) if case_summaries else 0.0
+        write_cases = [item for item in case_summaries if item[0].expected_write_decision and item[5]]
+        false_accepts = sum(
+            1 for item in write_cases
+            if item[5] == "direct" and item[0].expected_write_decision != "direct"
+        )
+        critical_direct = sum(1 for item in write_cases if item[0].critical_error and item[5] == "direct")
+        duplicate_direct: dict[str, set[str]] = {}
+        for case, _metrics, _ranks, _latency, _error, decision in write_cases:
+            if decision == "direct" and case.duplicate_group:
+                duplicate_direct.setdefault(case.duplicate_group, set()).add(case.session_id or str(case.id))
+        cross_session_duplicates = sum(max(len(sessions) - 1, 0) for sessions in duplicate_direct.values())
+        totals["write_quality_sample_count"] = len(write_cases)
+        totals["write_false_accept_rate"] = round(false_accepts / len(write_cases), 6) if write_cases else 0.0
+        totals["critical_error_direct_count"] = critical_direct
+        totals["cross_session_duplicate_rate"] = (
+            round(cross_session_duplicates / len(write_cases), 6) if write_cases else 0.0
+        )
+        projects: dict[str, list[dict[str, float]]] = {}
+        for case, metrics, _ranks, _latency, _error, _decision in case_summaries:
+            projects.setdefault(case.project_id or "__global__", []).append(metrics)
+        totals["projects"] = {
+            project_id: {
+                name: round(sum(item[name] for item in values) / len(values), 6)
+                for name in names
+            }
+            for project_id, values in projects.items()
+        }
+        with SessionLocal() as db:
+            run = db.get(SearchEvaluationRun, run_id)
+            for case, metrics, ranks, latency_ms, _error, _decision in case_summaries:
+                db.add(
+                    SearchEvaluationResult(
+                        run_id=run_id,
+                        case_id=case.id,
+                        ranks=ranks,
+                        metrics=metrics,
+                        latency_ms=latency_ms,
+                    )
+                )
+            run.metrics = totals
+            run.status = "completed"
+            run.finished_at = _utcnow()
+            db.commit()
+    except Exception as exc:
+        logging.exception("v2 检索评测执行失败")
+        with SessionLocal() as db:
+            run = db.get(SearchEvaluationRun, run_id)
+            if run is not None:
+                run.status = "failed"
+                run.error = f"{type(exc).__name__}: {str(exc)[:1000]}"
+                run.finished_at = _utcnow()
+                db.commit()
+
+
+def queue_evaluation_v2(run_id: uuid.UUID) -> None:
+    _JOB_EXECUTOR.submit(_execute_evaluation_v2, run_id)
