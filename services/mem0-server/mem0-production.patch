+        return isinstance(left, bool) and isinstance(right, bool) and left is right
+    return left == right
+
+
+def _filter_and(values: List[Optional[bool]]) -> Optional[bool]:
+    if any(value is False for value in values):
+        return False
+    if any(value is None for value in values):
+        return None
+    return True
+
+
+def _filter_or(values: List[Optional[bool]]) -> Optional[bool]:
+    if any(value is True for value in values):
+        return True
+    if any(value is None for value in values):
+        return None
+    return False
+
+
+def _compare_filter(actual: Any, condition: Any) -> Optional[bool]:
+    # 与 PostgreSQL WHERE 的三值逻辑保持一致：字段缺失或为 null 时结果未知。
+    if actual is _FILTER_MISSING or actual is None:
+        return None
+    if not isinstance(condition, dict):
+        return _json_equal(actual, condition)
+    operator, expected = next(iter(condition.items()))
+    if operator == "eq":
+        return _json_equal(actual, expected)
+    if operator == "ne":
+        return not _json_equal(actual, expected)
+    if operator == "in":
+        return any(_json_equal(actual, item) for item in expected)
+    if operator == "nin":
+        return not any(_json_equal(actual, item) for item in expected)
+    if operator in {"contains", "icontains"}:
+        if isinstance(actual, list):
+            return any(_json_equal(item, expected) for item in actual)
+        if not isinstance(actual, str) or not isinstance(expected, str):
+            return False
+        return expected.lower() in actual.lower() if operator == "icontains" else expected in actual
+    if isinstance(actual, bool) or isinstance(expected, bool):
+        return False
+    try:
+        if operator == "gt":
+            return actual > expected
+        if operator == "gte":
+            return actual >= expected
+        if operator == "lt":
+            return actual < expected
+        if operator == "lte":
+            return actual <= expected
+    except TypeError:
+        return False
+    return False
+
+
+def _evaluate_internal_filter(item: Dict[str, Any], value: Dict[str, Any]) -> Optional[bool]:
+    terms: List[Optional[bool]] = []
+    for key, condition in value.items():
+        if key == "AND":
+            children = condition if isinstance(condition, list) else [condition]
+            terms.append(_filter_and([_evaluate_internal_filter(item, child) for child in children]))
+        elif key == "OR":
+            children = condition if isinstance(condition, list) else [condition]
+            terms.append(_filter_or([_evaluate_internal_filter(item, child) for child in children]))
+        elif key == "NOT":
+            children = condition if isinstance(condition, list) else [condition]
+            child = _filter_or([_evaluate_internal_filter(item, item_filter) for item_filter in children])
+            terms.append(None if child is None else not child)
+        elif key == "metadata":
+            metadata = _internal_metadata(item)
+            terms.append(
+                _filter_and(
+                    [
+                        _compare_filter(metadata.get(name, _FILTER_MISSING), expected)
+                        for name, expected in condition.items()
+                    ]
+                )
+            )
+        else:
+            terms.append(_compare_filter(item.get(key, _FILTER_MISSING), condition))
+    return _filter_and(terms)
+
+
+def _matches_internal_filter(item: Dict[str, Any], value: Dict[str, Any]) -> bool:
+    return _evaluate_internal_filter(item, value) is True
+
+
+def _upstream_internal_filter(value: Dict[str, Any]) -> Dict[str, Any]:
+    terms: List[Dict[str, Any]] = []
+    for key, condition in value.items():
+        if key in _INTERNAL_FILTER_LOGICAL:
+            children = condition if isinstance(condition, list) else [condition]
+            terms.append({key: [_upstream_internal_filter(child) for child in children]})
+        elif key == "metadata":
+            terms.extend({name: expected} for name, expected in condition.items())
+        else:
+            terms.append({key: condition})
+    if len(terms) == 1:
+        return terms[0]
+    return {"AND": terms}
+
+
+def _vector_store_filter(value: Dict[str, Any]) -> Dict[str, Any]:
+    entity_filters = {
+        key: condition
+        for key, condition in value.items()
+        if key in {"user_id", "agent_id", "run_id"}
+    }
+    remaining = {
+        key: condition
+        for key, condition in value.items()
+        if key not in entity_filters
+    }
+
+    def combine_and(terms: List[Dict[str, Any]]) -> Dict[str, Any]:
+        terms = [term for term in terms if term]
+        if not terms:
+            return {}
+        merged: Dict[str, Any] = {}
+        for index, term in enumerate(terms):
+            if merged.keys().isdisjoint(term):
+                merged.update(term)
+                continue
+            negated = [{"$not": [item]} for item in [merged, term, *terms[index + 1 :]]]
+            return {"$not": negated}
+        return merged
+
+    def compile_node(node: Dict[str, Any]) -> Dict[str, Any]:
+        terms: List[Dict[str, Any]] = []
+        for key, condition in node.items():
+            if key == "AND":
+                children = condition if isinstance(condition, list) else [condition]
+                terms.append(combine_and([compile_node(child) for child in children]))
+            elif key == "OR":
+                children = condition if isinstance(condition, list) else [condition]
+                terms.append({"$or": [compile_node(child) for child in children]})
+            elif key == "NOT":
+                children = condition if isinstance(condition, list) else [condition]
+                terms.append({"$not": [compile_node(child) for child in children]})
+            elif key == "metadata" and isinstance(condition, dict):
+                terms.append(combine_and([{name: expected} for name, expected in condition.items()]))
+            else:
+                terms.append({key: condition})
+        return combine_and(terms)
+
+    compiled = compile_node(remaining)
+    if not entity_filters.keys().isdisjoint(compiled):
+        raise HTTPException(status_code=400, detail="实体过滤字段必须位于顶层")
+    return {**entity_filters, **compiled}
+
+
+def _internal_scope_filter(query: InternalMemoryQuery) -> Dict[str, Any]:
+    terms: List[Dict[str, Any]] = [{"mcp_owner": INTERNAL_OWNER}]
+    if not query.all_projects:
+        if query.project_id:
+            if query.include_global:
+                terms.append({"OR": [{"project_id": query.project_id}, {"scope": "global"}]})
+            else:
+                terms.append({"project_id": query.project_id})
+        else:
+            terms.append({"scope": "global"})
+    if query.run_id:
+        terms.append({"run_id": query.run_id})
+    if query.filters:
+        terms.append(_upstream_internal_filter(query.filters))
+    return {"user_id": INTERNAL_USER_ID, "AND": terms}
+
+
+def _validated_rows(rows: Any, operation: str) -> List[Dict[str, Any]]:
+    if not isinstance(rows, list) or any(not isinstance(item, dict) for item in rows):
+        raise RuntimeError(f"Mem0 {operation}返回无效响应")
+    return rows
+
+
+def _validated_result_rows(response: Any, operation: str) -> List[Dict[str, Any]]:
+    if not isinstance(response, dict) or "results" not in response:
+        raise RuntimeError(f"Mem0 {operation}返回无效响应")
+    return _validated_rows(response["results"], operation)
+
+
+def _query_internal_rows(query: InternalMemoryQuery) -> tuple[List[Dict[str, Any]], bool]:
+    if query.all_projects and query.project_id:
+        raise HTTPException(status_code=400, detail="all_projects and project_id are mutually exclusive")
+    if query.filters:
+        _validate_internal_filter(query.filters)
+    cutoff = _parse_cutoff(query.cutoff)
+    response = get_memory_instance().get_all(
+        filters=_vector_store_filter(_internal_scope_filter(query)),
+        top_k=query.scan_limit + 1,
+        show_expired=query.show_expired,
+    )
+    source = _validated_result_rows(response, "内部查询")
+    partial = len(source) > query.scan_limit
+    source = source[: query.scan_limit]
+    rows: List[Dict[str, Any]] = []
+    for item in source:
+        if isinstance(item, dict) and _matches_internal_query(item, query, cutoff):
+            rows.append(item)
+    return rows, partial
+
+
+def _matches_internal_query(
+    item: Dict[str, Any],
+    query: InternalMemoryQuery,
+    cutoff: Optional[datetime],
+) -> bool:
+    if item.get("user_id") not in (None, INTERNAL_USER_ID):
+        return False
+    metadata = _internal_metadata(item)
+    if metadata.get("mcp_owner") != INTERNAL_OWNER:
+        return False
+    item_project = metadata.get("project_id")
+    expected_scope = "project" if item_project not in (None, "") else "global"
+    if metadata.get("scope") != expected_scope:
+        return False
+    if not query.all_projects:
+        if query.project_id:
+            allowed_projects = {query.project_id, None, ""} if query.include_global else {query.project_id}
+            if item_project not in allowed_projects:
+                return False
+        elif item_project not in (None, ""):
+            return False
+    if query.run_id and item.get("run_id") != query.run_id:
+        return False
+    if cutoff:
+        created_at = _item_datetime(item.get("created_at"))
+        if created_at is None or created_at > cutoff:
+            return False
+    return not query.filters or _matches_internal_filter(item, query.filters)
+
+
+def _result_hash(rows: List[Dict[str, Any]]) -> str:
+    versions = sorted(
+        f"{item.get('id', '')}\0{item.get('updated_at') or item.get('created_at') or ''}"
+        for item in rows
+        if item.get("id")
+    )
+    return hashlib.sha256("\n".join(versions).encode("utf-8")).hexdigest()
+
+
+def _memory_version(item: Dict[str, Any]) -> str:
+    return str(item.get("updated_at") or item.get("created_at") or "")
+
+
+def _matches_managed_scope(item: Dict[str, Any], project_id: Optional[str]) -> bool:
+    if item.get("user_id") not in (None, INTERNAL_USER_ID):
+        return False
+    metadata = _internal_metadata(item)
+    if metadata.get("mcp_owner") != INTERNAL_OWNER:
+        return False
+    item_project = metadata.get("project_id")
+    expected_scope = "project" if item_project not in (None, "") else "global"
+    if metadata.get("scope") != expected_scope:
+        return False
+    if project_id:
+        return item_project == project_id
+    return item_project in (None, "")
+
+
+def _internal_scope_agent_id(project_id: Optional[str]) -> str:
+    return derive_mcp_agent_id(INTERNAL_OWNER, project_id)
+
+
+def _validate_internal_messages(messages: List[InternalMessage]) -> List[Dict[str, str]]:
+    total = sum(len(message.content) for message in messages)
+    if total > 50000:
+        raise HTTPException(status_code=400, detail="消息正文超过大小限制")
+    return [message.model_dump() for message in messages]
+
