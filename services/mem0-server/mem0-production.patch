diff --git a/mem0-ts/src/oss/src/storage/MemoryContract.test.ts b/mem0-ts/src/oss/src/storage/MemoryContract.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..562469f57f38b0b401a4cb1a1bb8185be1c863ff
--- /dev/null
+++ b/mem0-ts/src/oss/src/storage/MemoryContract.test.ts
@@ -0,0 +1,69 @@
+import { mkdtempSync, readFileSync, rmSync } from "fs";
+import { tmpdir } from "os";
+import { join, resolve } from "path";
+import { canonicalMemoryPayload } from "../memory";
+import { SQLiteManager } from "./SQLiteManager";
+
+const fixture = JSON.parse(
+  readFileSync(
+    resolve(__dirname, "../../../../../tests/fixtures/memory_contract_v2.json"),
+    "utf8",
+  ),
+);
+
+test("TypeScript payload 与共享黄金契约一致", () => {
+  const payload = canonicalMemoryPayload(
+    fixture.typescript_metadata,
+    fixture.data,
+    fixture.created_at,
+    fixture.updated_at,
+    fixture.memory_id,
+  );
+  for (const [key, value] of Object.entries(fixture.expected)) {
+    expect(payload[key]).toEqual(value);
+  }
+});
+
+test("TypeScript 历史使用统一字段并持久化完整快照", async () => {
+  const directory = mkdtempSync(join(tmpdir(), "mem0-history-"));
+  const databasePath = join(directory, "history.db");
+  try {
+    const manager = new SQLiteManager(databasePath);
+    await manager.addHistory(
+      fixture.memory_id,
+      null,
+      fixture.data,
+      "ADD",
+      fixture.created_at,
+      fixture.updated_at,
+      0,
+      {
+        afterPayload: fixture.expected,
+        operationId: "operation-1",
+        reason: "黄金契约测试",
+        sourceType: "user_statement",
+        sourceId: "conversation-1",
+        sourceMessageId: "message-1",
+        status: "active",
+        payloadVersion: fixture.expected.payload_version,
+        actorId: "actor-1",
+        role: "user",
+      },
+    );
+    manager.close();
+
+    const reopened = new SQLiteManager(databasePath);
+    const [history] = await reopened.getHistory(fixture.memory_id);
+    reopened.close();
+
+    expect(history.old_memory).toBeNull();
+    expect(history.new_memory).toBe(fixture.data);
+    expect(history.event).toBe("ADD");
+    expect(history.actor_id).toBe("actor-1");
+    expect(history.role).toBe("user");
+    expect(history.after_payload).toEqual(fixture.expected);
+    expect(history.payload_version).toBe(fixture.expected.payload_version);
+  } finally {
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
