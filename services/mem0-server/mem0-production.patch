+def _metadata_for_update(item: dict[str, Any], changes: dict[str, Any]) -> dict[str, Any] | None:
+    patch = changes.get("metadata_patch")
+    metadata = dict(_metadata(item)) if isinstance(patch, dict) or changes.get("project_id_set") else None
+    if isinstance(patch, dict):
+        for key, value in patch.items():
+            if key in {"user_id", "agent_id", "run_id", "actor_id"}:
+                raise HTTPException(status_code=422, detail=f"不可修改身份字段：{key}")
+            metadata[key] = value
+    if changes.get("project_id_set"):
+        project_id = changes.get("project_id")
+        metadata["project_id"] = project_id
+        metadata["scope"] = "project" if project_id else "global"
+    return metadata
+
