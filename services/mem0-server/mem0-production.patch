+
+  const createPreview = async () => {
+    if (selected.size === 0) {
+      toast({ title: "请先选择记忆", variant: "destructive" });
+      return;
+    }
+    if (selected.size > MAX_BATCH_SELECTION) {
+      toast({
+        title: `单次最多维护 ${MAX_BATCH_SELECTION} 条记忆`,
+        variant: "destructive",
+      });
+      return;
