@@ -0,0 +1,807 @@
+import hashlib
+import json
+import logging
+import re
+import uuid
+from datetime import datetime, timedelta, timezone
+from typing import Any, Iterable
+
+from db import SessionLocal
+from models import (
+    EntityAliasProjection,
+    EntityProjection,
+    MemoryAccess,
+    MemoryCandidate,
+    MemoryCatalog,
+    MemoryFeedback,
+    MemoryMutation,
+    ProfileProjection,
+    RetrievalEvent,
+    RetrievalSession,
+)
+from sqlalchemy import or_, select
+from sqlalchemy.dialects.postgresql import insert
+
+CANONICAL_SCHEMA_VERSION = 2
+ACTIVE_MEMORY_STATUSES = {"active"}
+DIRECT_CONFIDENCE = 0.85
+MINIMUM_CANDIDATE_CONFIDENCE = 0.50
+CANDIDATE_RETENTION_DAYS = 30
+QUALITY_METADATA_KEYS = {
+    "schema_version",
+    "status",
+    "confidence",
+    "category",
+    "memory_type",
+    "project_id",
+    "session_id",
+    "observed_at",
+    "valid_from",
+    "valid_to",
+    "source_type",
+    "source_id",
+    "source_message_id",
+    "conflict_key",
+    "profile_key",
+    "supersedes_id",
+}
+_DURABLE_TYPES = {
+    "decision",
+    "preference",
+    "fact",
+    "verification",
+    "task_learning",
+    "error_solution",
+    "project_goal",
+    "session_state",
+}
+_DURABLE_SIGNAL = re.compile(
+    r"(?:决定|确认|偏好|必须|约定|验证通过|测试通过|根因|解决方案|以后|记住|完成状态|decision|preference|verified|root cause)",
+    re.IGNORECASE,
+)
+_SECRET_PREVIEW = re.compile(
+    r"(?i)(authorization\s*:\s*bearer\s+|api[_ -]?key\s*[=:]\s*|password\s*[=:]\s*)\S+"
+)
+
+
+def _utcnow() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def _parse_datetime(value: Any) -> datetime | None:
+    if isinstance(value, datetime):
+        return value if value.tzinfo else value.replace(tzinfo=timezone.utc)
+    if not isinstance(value, str) or not value:
+        return None
+    try:
+        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)
+
+
+def _metadata(item: dict[str, Any]) -> dict[str, Any]:
+    nested = item.get("metadata")
+    values = dict(nested) if isinstance(nested, dict) else {}
+    for key in QUALITY_METADATA_KEYS:
+        if key in item:
+            values.setdefault(key, item[key])
+    return values
+
+
+def memory_payload_version(item: dict[str, Any]) -> str:
+    metadata = _metadata(item)
+    explicit = metadata.get("payload_version") or item.get("payload_version")
+    if explicit:
+        return str(explicit)[:128]
+    basis = "\0".join(
+        [
+            str(item.get("id") or ""),
+            str(item.get("updated_at") or item.get("created_at") or ""),
+            str(item.get("memory") or item.get("data") or ""),
+        ]
+    )
+    return hashlib.sha256(basis.encode("utf-8")).hexdigest()
+
+
+def sync_memory_catalog(
+    item: dict[str, Any],
+    *,
+    status: str | None = None,
+    session=None,
+) -> MemoryCatalog:
+    memory_id = str(item.get("id") or "")
+    if not memory_id:
+        raise ValueError("记忆缺少 ID，无法同步目录")
+    text_value = str(item.get("memory") or item.get("data") or "")
+    metadata = _metadata(item)
+    own_session = session is None
+    db = session or SessionLocal()
+    try:
+        row = db.get(MemoryCatalog, memory_id)
+        if row is None:
+            row = MemoryCatalog(
+                memory_id=memory_id,
+                payload_version=memory_payload_version(item),
+                content_hash=hashlib.sha256(text_value.encode("utf-8")).hexdigest(),
+            )
+            db.add(row)
+        row.schema_version = CANONICAL_SCHEMA_VERSION
+        row.status = status or str(metadata.get("status") or row.status or "active")
+        row.payload_version = memory_payload_version(item)
+        row.content_hash = hashlib.sha256(text_value.encode("utf-8")).hexdigest()
+        row.user_id = item.get("user_id") or metadata.get("user_id")
+        row.agent_id = item.get("agent_id") or metadata.get("agent_id")
+        row.run_id = item.get("run_id") or metadata.get("run_id")
+        row.project_id = metadata.get("project_id")
+        row.session_id = metadata.get("session_id")
+        raw_confidence = metadata.get("confidence")
+        row.confidence = float(raw_confidence) if isinstance(raw_confidence, (int, float)) else None
+        row.category = metadata.get("category")
+        row.memory_type = metadata.get("memory_type") or metadata.get("memory_kind") or metadata.get("type")
+        row.observed_at = _parse_datetime(metadata.get("observed_at"))
+        row.valid_from = _parse_datetime(metadata.get("valid_from"))
+        row.valid_to = _parse_datetime(metadata.get("valid_to"))
+        row.source_type = str(metadata.get("source_type") or metadata.get("source") or "legacy")[:32]
+        row.source_id = metadata.get("source_id")
+        row.source_message_id = metadata.get("source_message_id")
+        row.conflict_key = metadata.get("conflict_key")
+        row.profile_key = metadata.get("profile_key")
+        row.supersedes_id = metadata.get("supersedes_id")
+        extra = dict(row.extra or {})
+        extra.update({
+            "evidence_ref": metadata.get("evidence_ref"),
+            "evidence_summary": metadata.get("evidence_summary"),
+            "partial_source": bool(metadata.get("partial_source")),
+            "verification_status": metadata.get("verification_status"),
+        })
+        row.extra = extra
+        if own_session:
+            db.commit()
+            db.refresh(row)
+        return row
+    except Exception:
+        if own_session:
+            db.rollback()
+        raise
+    finally:
+        if own_session:
+            db.close()
+
+
+def begin_mutation(
+    kind: str,
+    *,
+    memory_id: str | None = None,
+    before_payload: dict[str, Any] | None = None,
+    source_memory_ids: list[str] | None = None,
+    reason: str | None = None,
+) -> uuid.UUID:
+    with SessionLocal() as db:
+        row = MemoryMutation(
+            memory_id=memory_id,
+            kind=kind[:24],
+            before_payload=before_payload,
+            source_memory_ids=list(source_memory_ids or []),
+            reason=reason,
+        )
+        db.add(row)
+        db.commit()
+        db.refresh(row)
+        return row.id
+
+
+def complete_mutation(operation_id: uuid.UUID, item: dict[str, Any], *, status: str | None = None) -> None:
+    # 先持久化向量侧已经成功的事实，目录同步失败时才能安全重试。
+    with SessionLocal() as db:
+        row = db.get(MemoryMutation, operation_id)
+        if row is None:
+            raise RuntimeError("记忆变更记录不存在")
+        row.memory_id = str(item.get("id") or row.memory_id or "") or None
+        row.status = "vector_applied"
+        row.after_payload = item
+        row.target_status = status
+        row.error = None
+        row.lease_owner = None
+        row.lease_until = None
+        db.commit()
+    with SessionLocal() as db:
+        row = db.get(MemoryMutation, operation_id)
+        if row is None or not isinstance(row.after_payload, dict):
+            raise RuntimeError("记忆变更缺少可重试的向量快照")
+        sync_memory_catalog(row.after_payload, status=row.target_status, session=db)
+        row.status = "completed"
+        row.next_retry_at = None
+        db.commit()
+
+
+def fail_mutation(operation_id: uuid.UUID, exc: Exception) -> None:
+    with SessionLocal() as db:
+        row = db.get(MemoryMutation, operation_id)
+        if row is None:
+            return
+        row.status = "failed"
+        row.attempt_count = int(row.attempt_count or 0) + 1
+        delay_seconds = min(300, 2 ** min(row.attempt_count, 8))
+        row.next_retry_at = _utcnow() + timedelta(seconds=delay_seconds)
+        row.lease_owner = None
+        row.lease_until = None
+        row.error = f"{type(exc).__name__}: {str(exc)[:1000]}"
+        db.commit()
+
+
+def retry_pending_mutations(
+    *, limit: int = 100, lease_owner: str | None = None, force: bool = False
+) -> dict[str, int]:
+    """领取并幂等重放目录同步事件；不会重复执行向量写入。"""
+    owner = (lease_owner or f"quality-retry-{uuid.uuid4()}")[:128]
+    now = _utcnow()
+    lease_until = now + timedelta(minutes=2)
+    with SessionLocal() as db:
+        conditions = [
+            MemoryMutation.status.in_(("vector_applied", "failed")),
+            MemoryMutation.after_payload.is_not(None),
+            or_(MemoryMutation.lease_until.is_(None), MemoryMutation.lease_until < now),
+        ]
+        if not force:
+            conditions.append(or_(MemoryMutation.next_retry_at.is_(None), MemoryMutation.next_retry_at <= now))
+        rows = db.scalars(
+            select(MemoryMutation)
+            .where(*conditions)
+            .order_by(MemoryMutation.created_at)
+            .limit(max(1, min(limit, 500)))
+            .with_for_update(skip_locked=True)
+        ).all()
+        operation_ids = [row.id for row in rows]
+        for row in rows:
+            row.lease_owner = owner
+            row.lease_until = lease_until
+        db.commit()
+
+    completed = 0
+    failed = 0
+    for operation_id in operation_ids:
+        try:
+            with SessionLocal() as db:
+                row = db.scalar(
+                    select(MemoryMutation).where(
+                        MemoryMutation.id == operation_id,
+                        MemoryMutation.lease_owner == owner,
+                    ).with_for_update()
+                )
+                if row is None or not isinstance(row.after_payload, dict):
+                    continue
+                sync_memory_catalog(row.after_payload, status=row.target_status, session=db)
+                row.status = "completed"
+                row.error = None
+                row.next_retry_at = None
+                row.lease_owner = None
+                row.lease_until = None
+                db.commit()
+                completed += 1
+        except Exception as exc:
+            failed += 1
+            fail_mutation(operation_id, exc)
+    return {"claimed": len(operation_ids), "completed": completed, "failed": failed}
+
+
+def assess_risk_write(
+    *,
+    text_value: str,
+    messages: list[dict[str, Any]],
+    metadata: dict[str, Any],
+    conflicts: list[dict[str, Any]],
+) -> dict[str, Any]:
+    raw_confidence = metadata.get("confidence")
+    confidence = float(raw_confidence) if isinstance(raw_confidence, (int, float)) else 0.5
+    has_user_evidence = any(item.get("role") == "user" for item in messages)
+    verification = str(metadata.get("verification_status") or "").casefold()
+    has_verified_evidence = verification in {"verified", "passed", "confirmed", "已验证", "通过"}
+    partial_source = bool(metadata.get("partial_source"))
+    memory_type = str(
+        metadata.get("memory_type") or metadata.get("memory_kind") or metadata.get("type") or ""
+    ).casefold()
+    durable = memory_type in _DURABLE_TYPES or bool(_DURABLE_SIGNAL.search(text_value))
+    reasons: list[str] = []
+    if has_user_evidence:
+        confidence = min(1.0, confidence + 0.1)
+    if has_verified_evidence:
+        confidence = min(1.0, confidence + 0.1)
+    if partial_source:
+        confidence = max(0.0, confidence - 0.2)
+        reasons.append("来源内容不完整")
+    if not durable:
+        confidence = min(confidence, 0.49)
+        reasons.append("未识别到可长期保存的事实、决定、偏好或验证结果")
+    if conflicts:
+        reasons.append("存在重复或冲突候选")
+    if not has_user_evidence and not has_verified_evidence:
+        reasons.append("缺少用户明确陈述或已验证工具证据")
+    confidence = round(min(max(confidence, 0.0), 1.0), 4)
+    if confidence < MINIMUM_CANDIDATE_CONFIDENCE:
+        decision = "skip"
+    elif (
+        confidence >= DIRECT_CONFIDENCE
+        and (has_user_evidence or has_verified_evidence)
+        and not partial_source
+        and not conflicts
+    ):
+        decision = "direct"
+    else:
+        decision = "candidate"
+    return {
+        "decision": decision,
+        "confidence": confidence,
+        "risk_reasons": reasons,
+        "evidence": {
+            "has_user_evidence": has_user_evidence,
+            "has_verified_evidence": has_verified_evidence,
+            "partial_source": partial_source,
+            "message_count": len(messages),
+        },
+    }
+
+
+def create_candidate(
+    *,
+    text_value: str,
+    messages: list[dict[str, Any]],
+    metadata: dict[str, Any],
+    assessment: dict[str, Any],
+    project_id: str | None,
+    run_id: str | None,
+    created_by: uuid.UUID | None = None,
+) -> MemoryCandidate:
+    with SessionLocal() as db:
+        row = MemoryCandidate(
+            text=text_value[:50000],
+            messages=messages,
+            evidence=dict(assessment.get("evidence") or {}),
+            risk_reasons=list(assessment.get("risk_reasons") or []),
+            confidence=float(assessment["confidence"]),
+            project_id=project_id,
+            run_id=run_id,
+            category=metadata.get("category"),
+            memory_type=metadata.get("memory_type") or metadata.get("memory_kind") or metadata.get("type"),
+            source_type=str(metadata.get("source_type") or metadata.get("source") or "codex_hook")[:32],
+            source_id=metadata.get("source_id") or metadata.get("session_id"),
+            source_message_id=metadata.get("source_message_id"),
+            conflict_key=metadata.get("conflict_key"),
+            profile_key=metadata.get("profile_key"),
+            candidate_metadata=metadata,
+            created_by=created_by,
+            expires_at=_utcnow() + timedelta(days=CANDIDATE_RETENTION_DAYS),
+        )
+        db.add(row)
+        db.commit()
+        db.refresh(row)
+        return row
+
+
+def append_memory_evidence(
+    memory_id: str,
+    *,
+    metadata: dict[str, Any],
+    evidence: dict[str, Any] | None = None,
+) -> bool:
+    """为重复事实补充来源引用，不重复写入向量记忆。"""
+    evidence_ref = {
+        "source_type": metadata.get("source_type") or metadata.get("source") or "unknown",
+        "source_id": metadata.get("source_id") or metadata.get("session_id"),
+        "source_message_id": metadata.get("source_message_id"),
+        "summary": dict(evidence or {}),
+    }
+    with SessionLocal() as db:
+        row = db.get(MemoryCatalog, memory_id)
+        if row is None:
+            return False
+        extra = dict(row.extra or {})
+        evidence_refs = list(extra.get("evidence_refs") or [])
+        if evidence_ref not in evidence_refs:
+            evidence_refs.append(evidence_ref)
+            extra["evidence_refs"] = evidence_refs[-100:]
+            row.extra = extra
+            db.commit()
+        return True
+
+
+def candidate_to_dict(row: MemoryCandidate) -> dict[str, Any]:
+    return {
+        "id": str(row.id),
+        "text": row.text,
+        "evidence": row.evidence,
+        "risk_reasons": row.risk_reasons,
+        "status": row.status,
+        "confidence": row.confidence,
+        "project_id": row.project_id,
+        "run_id": row.run_id,
+        "category": row.category,
+        "memory_type": row.memory_type,
+        "source_type": row.source_type,
+        "conflict_key": row.conflict_key,
+        "profile_key": row.profile_key,
+        "promoted_memory_id": row.promoted_memory_id,
+        "review_reason": row.review_reason,
+        "expires_at": row.expires_at,
+        "reviewed_at": row.reviewed_at,
+        "created_at": row.created_at,
+    }
+
+
+def apply_feedback_ranking(
+    results: list[dict[str, Any]], *, factors_enabled: bool = True
+) -> list[dict[str, Any]]:
+    if not results:
+        return results
+    ids = [str(item.get("id")) for item in results if item.get("id")]
+    with SessionLocal() as db:
+        catalogs = db.scalars(select(MemoryCatalog).where(MemoryCatalog.memory_id.in_(ids))).all()
+        feedback = db.scalars(select(MemoryFeedback).where(MemoryFeedback.memory_id.in_(ids))).all()
+    catalog_by_id = {row.memory_id: row for row in catalogs}
+    feedback_by_key: dict[tuple[str, str], list[str]] = {}
+    for row in feedback:
+        feedback_by_key.setdefault((row.memory_id, row.payload_version), []).append(row.verdict)
+    ranked: list[dict[str, Any]] = []
+    for item in results:
+        memory_id = str(item.get("id") or "")
+        catalog = catalog_by_id.get(memory_id)
+        if catalog is not None and catalog.status not in ACTIVE_MEMORY_STATUSES:
+            continue
+        version = catalog.payload_version if catalog else memory_payload_version(item)
+        verdicts = feedback_by_key.get((memory_id, version), [])
+        if not factors_enabled:
+            factor = 1.0
+        elif "critical_error" in verdicts:
+            factor = 0.0
+        elif "useless" in verdicts:
+            factor = 0.6
+        elif "correct" in verdicts:
+            factor = 1.05
+        else:
+            factor = 1.0
+        if factor == 0:
+            continue
+        enriched = dict(item)
+        raw_score = float(item.get("score") or 0.0)
+        enriched["feedback_factor"] = factor
+        enriched["feedback_score"] = round(raw_score * factor, 6)
+        enriched["score"] = enriched["feedback_score"]
+        enriched["memory_status"] = catalog.status if catalog else "active"
+        enriched["payload_version"] = version
+        ranked.append(enriched)
+    ranked.sort(key=lambda value: (float(value.get("score") or 0), str(value.get("id") or "")), reverse=True)
+    return ranked
+
+
+def _safe_query_preview(query: str) -> str:
+    return _SECRET_PREVIEW.sub(lambda match: f"{match.group(1)}[已脱敏]", query)[:500]
+
+
+def record_retrieval(
+    *,
+    query: str,
+    results: list[dict[str, Any]],
+    mode: str,
+    project_id: str | None,
+    latency_ms: float,
+    source: str,
+    actor_id: uuid.UUID | None = None,
+    status: str = "ok",
+    error_type: str | None = None,
+    config_snapshot: dict[str, Any] | None = None,
+) -> str | None:
+    now = _utcnow()
+    try:
+        with SessionLocal() as db:
+            session = RetrievalSession(
+                query_hash=hashlib.sha256(query.encode("utf-8")).hexdigest(),
+                query_preview=_safe_query_preview(query),
+                project_id=project_id,
+                mode=mode[:24],
+                status=status[:20],
+                error_type=error_type[:80] if error_type else None,
+                latency_ms=max(float(latency_ms), 0.0),
+                config_snapshot=config_snapshot or {},
+                actor_id=actor_id,
+                source=source[:32],
+            )
+            db.add(session)
+            db.flush()
+            for rank, item in enumerate(results, start=1):
+                memory_id = str(item.get("id") or "")
+                if not memory_id:
+                    continue
+                metadata = _metadata(item)
+                db.add(
+                    RetrievalEvent(
+                        session_id=session.id,
+                        memory_id=memory_id,
+                        event_type="exposure",
+                        rank=rank,
+                        scores={
+                            key: item.get(key)
+                            for key in (
+                                "semantic_score", "vector_score", "keyword_score", "hybrid_score",
+                                "rerank_score", "feedback_factor", "decay_factor", "final_score", "score",
+                            )
+                            if item.get(key) is not None
+                        },
+                        project_id=metadata.get("project_id") or project_id,
+                        actor_id=actor_id,
+                        source=source[:32],
+                    )
+                )
+                statement = insert(MemoryAccess).values(
+                    memory_id=memory_id,
+                    access_count=1,
+                    last_accessed_at=now,
+                    exposure_count=1,
+                    last_exposed_at=now,
+                    effective_access_count=0,
+                    updated_at=now,
+                )
+                statement = statement.on_conflict_do_update(
+                    index_elements=[MemoryAccess.memory_id],
+                    set_={
+                        "access_count": MemoryAccess.access_count + 1,
+                        "last_accessed_at": now,
+                        "exposure_count": MemoryAccess.exposure_count + 1,
+                        "last_exposed_at": now,
+                        "updated_at": now,
+                    },
+                )
+                db.execute(statement)
+            db.commit()
+            return str(session.id)
+    except Exception:
+        logging.warning("检索事件记录失败", exc_info=True)
+        return None
+
+
+def record_effective_access(
+    memory_ids: Iterable[str],
+    *,
+    event_type: str = "open",
+    retrieval_id: str | None = None,
+    project_id: str | None = None,
+    source: str = "rest",
+    actor_id: uuid.UUID | None = None,
+) -> None:
+    ids = list(dict.fromkeys(str(item)[:128] for item in memory_ids if item))
+    if not ids or event_type not in {"open", "adopt", "copy", "feedback"}:
+        return
+    session_id = None
+    if retrieval_id:
+        try:
+            session_id = uuid.UUID(retrieval_id)
+        except ValueError:
+            session_id = None
+    now = _utcnow()
+    try:
+        with SessionLocal() as db:
+            for memory_id in ids:
+                db.add(
+                    RetrievalEvent(
+                        session_id=session_id,
+                        memory_id=memory_id,
+                        event_type=event_type,
+                        project_id=project_id,
+                        actor_id=actor_id,
+                        source=source[:32],
+                    )
+                )
+                statement = insert(MemoryAccess).values(
+                    memory_id=memory_id,
+                    access_count=0,
+                    last_accessed_at=now,
+                    exposure_count=0,
+                    effective_access_count=1,
+                    last_effective_accessed_at=now,
+                    updated_at=now,
+                )
+                statement = statement.on_conflict_do_update(
+                    index_elements=[MemoryAccess.memory_id],
+                    set_={
+                        "effective_access_count": MemoryAccess.effective_access_count + 1,
+                        "last_effective_accessed_at": now,
+                        "updated_at": now,
+                    },
+                )
+                db.execute(statement)
+            db.commit()
+    except Exception:
+        logging.warning("记忆有效使用记录失败", exc_info=True)
+
