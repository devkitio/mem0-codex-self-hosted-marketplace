+@router.post("/candidates/{candidate_id}/review")
+def review_candidate(
+    candidate_id: uuid.UUID,
+    body: CandidateReviewRequest,
+    user: User = Depends(require_editor),
+    db: Session = Depends(get_db),
+):
+    row = db.scalar(select(MemoryCandidate).where(MemoryCandidate.id == candidate_id).with_for_update())
+    if row is None:
+        raise HTTPException(status_code=404, detail="候选记忆不存在")
+    _candidate_scope(user, row.project_id)
+    if row.status != "pending":
+        raise HTTPException(status_code=409, detail="候选记忆已处理")
+    if row.expires_at < _utcnow():
+        row.status = "archived"
+        db.commit()
+        raise HTTPException(status_code=409, detail="候选记忆已过期归档")
+    if body.action == "reject":
+        row.status = "rejected"
+        row.review_reason = body.reason
+        row.reviewed_at = _utcnow()
+        db.commit()
+        log_memory_activity(
+            "candidate_reject", user=user, source="governance", details={"候选 ID": str(row.id)}
+        )
+        return candidate_to_dict(row)
+
+    settings = get_governance_settings()
+    text_value = (body.text if body.text is not None else row.text).strip()
+    if not text_value:
+        raise HTTPException(status_code=422, detail="候选正文不能为空")
+    protected_text, findings = protect_sensitive_value(text_value, settings)
+    conflicts = detect_memory_conflicts(
+        str(protected_text),
+        {"project_id": row.project_id} if row.project_id else {},
+        conflict_key=row.conflict_key,
+    )
+    if body.action == "edit":
+        assessment = assess_risk_write(
+            text_value=str(protected_text),
+            messages=list(row.messages or []),
+            metadata=dict(row.candidate_metadata or {}),
+            conflicts=conflicts,
+        )
+        row.text = str(protected_text)
+        row.confidence = float(assessment["confidence"])
+        row.evidence = dict(assessment["evidence"])
+        row.risk_reasons = list(assessment["risk_reasons"])
+        row.review_reason = body.reason
+        db.commit()
+        db.refresh(row)
+        log_memory_activity(
+            "candidate_edit", user=user, source="governance", details={"候选 ID": str(row.id)}
+        )
+        return {**candidate_to_dict(row), "assessment": assessment, "sensitive_findings": len(findings)}
+
+    duplicate = next((item for item in conflicts if item.get("type") == "duplicate"), None)
+    if duplicate:
+        duplicate_memory_id = str(duplicate["memory_id"])
+        catalog = db.get(MemoryCatalog, duplicate_memory_id)
+        if catalog is not None:
+            extra = dict(catalog.extra or {})
+            evidence_refs = list(extra.get("evidence_refs") or [])
+            evidence_ref = {
+                "candidate_id": str(row.id),
+                "source_type": row.source_type,
+                "source_id": row.source_id,
+                "source_message_id": row.source_message_id,
+                "summary": dict(row.evidence or {}),
+            }
+            if evidence_ref not in evidence_refs:
+                evidence_refs.append(evidence_ref)
+            extra["evidence_refs"] = evidence_refs[-100:]
+            catalog.extra = extra
+        row.status = "promoted"
+        row.promoted_memory_id = duplicate_memory_id
+        row.review_reason = body.reason or "确认时识别为已有记忆的重复证据"
+        row.reviewed_at = _utcnow()
+        db.commit()
+        return {**candidate_to_dict(row), "deduplicated": True}
+
+    metadata = dict(row.candidate_metadata or {})
+    user_id = metadata.pop("user_id", None)
+    agent_id = metadata.pop("agent_id", None)
+    run_id = metadata.pop("run_id", None) or row.run_id
+    if not any((user_id, agent_id, run_id)):
+        raise HTTPException(status_code=409, detail="候选缺少 User、Agent 或 Run 作用域，无法晋升")
+    metadata.update(
+        {
+            "source_type": "candidate_review",
+            "source_id": str(row.id),
+            "evidence_ref": str(row.id),
+            "evidence_summary": dict(row.evidence or {}),
+            "confidence": row.confidence,
+            "status": "active",
+        }
+    )
+    response = get_memory_instance().add(
+        messages=[{"role": "user", "content": str(protected_text)}],
+        user_id=user_id,
+        agent_id=agent_id,
+        run_id=run_id,
+        metadata=metadata,
+        infer=False,
+    )
+    results = response.get("results", []) if isinstance(response, dict) else []
+    if not results or not results[0].get("id"):
+        raise HTTPException(status_code=502, detail="候选晋升未返回记忆 ID")
+    memory_id = str(results[0]["id"])
+    current = _get_memory(memory_id)
+    if current is None:
+        raise HTTPException(status_code=502, detail="候选晋升后无法读取记忆")
+    sync_memory_catalog(current)
+    for conflict in conflicts:
+        target = str(conflict.get("memory_id") or "")
+        if target:
+            db.add(
+                MemoryRelation(
+                    source_memory_id=memory_id,
+                    target_memory_id=target,
+                    relation_type="conflicts" if conflict.get("type") != "duplicate" else "supports",
+                    details={"candidate_id": str(row.id), "score": conflict.get("score")},
+                )
+            )
+    row.status = "promoted"
+    row.promoted_memory_id = memory_id
+    row.review_reason = body.reason
+    row.reviewed_at = _utcnow()
+    db.commit()
+    log_memory_activity(
+        "candidate_confirm", user=user, memory_id=memory_id, source="governance", details={"候选 ID": str(row.id)}
+    )
+    return {**candidate_to_dict(row), "memory": current, "sensitive_findings": len(findings)}
