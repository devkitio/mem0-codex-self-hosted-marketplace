+def prepare_restart_state() -> None:
+    now = datetime.now(timezone.utc)
+    deletion = main.InternalMemoryDelete(
+        project_id="restart-state-test",
+        cutoff=now.isoformat(),
+        expected_hash="2" * 64,
+        expected_count=1,
+        operation_id=uuid.uuid4(),
+        operation_expires_at=int(time.time()) + 300,
+    )
+    operation = MCPDeletionOperation(
+        jti=deletion.operation_id,
+        scope_hash=main._delete_scope_hash(deletion),
+        expected_hash=deletion.expected_hash,
+        target_ids=json.dumps({"id-a": "v1"}),
+        pending_ids=json.dumps(["id-a"]),
+        failed_ids="[]",
+        deleted=0,
+        status="in_progress",
+        expires_at=datetime.fromtimestamp(deletion.operation_expires_at, timezone.utc),
+        lease_until=now - timedelta(seconds=1),
+        lease_owner="stale-process",
+        updated_at=now,
+    )
+    with main.SessionLocal() as db:
+        db.add(operation)
+        db.commit()
+    descriptor = os.open(RESTART_STATE_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
+        json.dump(deletion.model_dump(mode="json"), handle)
+    print("跨进程恢复状态已准备")
+
