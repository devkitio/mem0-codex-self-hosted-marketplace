+def _complex_query(query: str) -> bool:
+    separators = re.findall(r"(?:以及|并且|同时|另外|还要|而且|和|与|;|；|\n)", query)
+    return len(query) >= 80 or len(separators) >= 2
+
+
+def _parse_query_plan(response: Any, original: str) -> list[str]:
+    raw = str(response or "").strip()
+    if raw.startswith("```"):
+        raw = re.sub(r"^```(?:json)?\s*|\s*```$", "", raw, flags=re.IGNORECASE)
+    payload = json.loads(raw)
+    values = payload.get("queries") if isinstance(payload, dict) else payload
+    if not isinstance(values, list):
+        raise ValueError("查询规划响应缺少 queries 数组")
+    planned = [original]
+    for value in values:
+        text_value = str(value or "").strip()
+        if text_value and text_value not in planned:
+            planned.append(text_value[:500])
+        if len(planned) >= 4:
+            break
+    if len(planned) < 2:
+        raise ValueError("查询规划未生成互补查询")
+    return planned
+
+
+def plan_search_queries(query: str, settings: dict[str, Any] | None = None) -> tuple[list[str], str | None]:
+    values = settings or get_governance_settings()
+    if not values.get("multi_query_enabled") or not _complex_query(query):
+        return [query], None
+    memory = get_memory_instance()
+
+    def generate() -> list[str]:
+        response = memory.llm.generate_response(
+            messages=[
+                {
+                    "role": "system",
+                    "content": (
+                        "把复杂记忆检索请求改写成 2 到 4 个互补、可独立检索的短查询。"
+                        "只输出 JSON：{\"queries\":[\"...\"]}，不要添加说明。"
+                    ),
+                },
+                {"role": "user", "content": query[:2000]},
+            ]
+        )
+        return _parse_query_plan(response, query)
+
+    executor = ThreadPoolExecutor(max_workers=1, thread_name_prefix="mem0-query-plan")
+    future = executor.submit(generate)
+    try:
+        timeout = max(0.1, min(float(values.get("query_planning_timeout_ms", 800)) / 1000.0, 2.0))
+        return future.result(timeout=timeout), None
+    except FutureTimeoutError:
+        future.cancel()
+        return [query], "timeout"
+    except Exception:
+        logging.warning("查询改写失败，已回退原始查询", exc_info=True)
+        return [query], "failed"
+    finally:
+        executor.shutdown(wait=False, cancel_futures=True)
+
+
+def _merge_query_results(result_sets: list[list[dict[str, Any]]], score_key: str) -> list[dict[str, Any]]:
+    merged: dict[str, dict[str, Any]] = {}
+    for query_index, rows in enumerate(result_sets):
+        for rank, row in enumerate(rows, start=1):
+            memory_id = str(row.get("id") or "")
+            if not memory_id:
+                continue
+            entry = merged.setdefault(memory_id, dict(row))
+            entry[score_key] = max(float(entry.get(score_key) or 0.0), float(row.get(score_key) or row.get("score") or 0.0))
+            entry.setdefault("query_matches", []).append({"query_index": query_index, "rank": rank})
+    return sorted(
+        merged.values(),
+        key=lambda item: (
+            min((match["rank"] for match in item.get("query_matches", [])), default=10**9),
+            -float(item.get(score_key) or 0.0),
+            str(item.get("id") or ""),
+        ),
+    )
+
+
+def reciprocal_rank_fusion(
+    vector_results: Iterable[dict[str, Any]],
+    keyword_results: Iterable[dict[str, Any]],
+    *,
+    vector_weight: float = 0.65,
+    rank_constant: int = 60,
+) -> list[dict[str, Any]]:
+    weight = min(max(float(vector_weight), 0.0), 1.0)
+    merged: dict[str, dict[str, Any]] = {}
+    for source, results, source_weight in (
+        ("vector", vector_results, weight),
+        ("keyword", keyword_results, 1.0 - weight),
+    ):
+        for rank, row in enumerate(results, start=1):
+            memory_id = str(row.get("id") or "")
+            if not memory_id:
+                continue
+            entry = merged.setdefault(memory_id, dict(row))
+            entry[f"{source}_rank"] = rank
+            entry[f"{source}_score"] = float(row.get("score") or 0.0)
+            entry["hybrid_score"] = float(entry.get("hybrid_score") or 0.0) + source_weight / (rank_constant + rank)
+    maximum = weight / (rank_constant + 1) + (1.0 - weight) / (rank_constant + 1)
+    for entry in merged.values():
+        entry["hybrid_score"] = round(float(entry["hybrid_score"]) / maximum, 6)
+        entry["score"] = entry["hybrid_score"]
+        entry["retrieval_mode"] = "hybrid"
+    return sorted(
+        merged.values(),
+        key=lambda item: (float(item.get("hybrid_score") or 0.0), str(item.get("id") or "")),
+        reverse=True,
+    )
+
+
+def hybrid_search(
+    query: str,
+    filters: dict[str, Any],
+    top_k: int,
+    threshold: float = 0.1,
+    *,
+    explain: bool = True,
+    show_expired: bool = False,
+    rerank: bool = True,
+    final_score_threshold: float | None = None,
+    result_limit: int | None = None,
+    filter_pushdown_fields: list[str] | None = None,
+    post_filter_fields: list[str] | None = None,
+) -> list[dict[str, Any]]:
+    memory = get_memory_instance()
+    settings = get_governance_settings()
+    candidate_limit = min(max(top_k * 5, 50), 500)
+    queries, planning_fallback = plan_search_queries(query, settings)
+    vector_rows = _merge_query_results(
+        [_pure_vector_results(value, filters, candidate_limit, threshold, show_expired=show_expired) for value in queries],
+        "semantic_score",
+    )
+    keyword_rows = _merge_query_results(
+        [_pure_keyword_results(value, filters, candidate_limit, show_expired=show_expired) for value in queries],
+        "keyword_score",
+    )
+    if not keyword_rows:
+        fused = vector_rows
+        for rank, row in enumerate(fused, start=1):
+            row["vector_rank"] = rank
+            row["retrieval_mode"] = "vector"
+            row["hybrid_score"] = float(row.get("semantic_score") or row.get("score") or 0.0)
+            row["score"] = row["hybrid_score"]
+    else:
+        fused = reciprocal_rank_fusion(
+            vector_rows,
+            keyword_rows,
+            vector_weight=float(settings["hybrid_vector_weight"]),
+        )
+    fused = fused[:candidate_limit]
+    if rerank and getattr(memory, "reranker", None) and fused:
+        before = {str(item.get("id")): item for item in fused}
+        try:
+            reranked = memory.reranker.rerank(query, fused, candidate_limit)
+            fused = []
+            for item in reranked:
+                enriched = {**before.get(str(item.get("id")), {}), **item}
+                enriched["rerank_score"] = float(item.get("score") or 0.0)
+                enriched["score"] = enriched["rerank_score"]
+                fused.append(enriched)
+        except Exception:
+            logging.warning("重排失败，已使用 RRF 结果", exc_info=True)
+    for item in fused:
+        item.setdefault("rerank_score", float(item.get("score") or 0.0))
+        item["query_plan_count"] = len(queries)
+        item["query_planning_fallback"] = planning_fallback
+        item["filter_pushdown"] = not bool(post_filter_fields)
+        item["filter_pushdown_fields"] = list(filter_pushdown_fields or filters.keys())
+        item["post_filter_fields"] = list(post_filter_fields or [])
+    fused = apply_feedback_ranking(
+        fused, factors_enabled=bool(settings.get("feedback_ranking_enabled"))
+    )
+    fused = apply_memory_decay(fused)
+    minimum = final_score_threshold
+    if minimum is None:
+        configured = settings.get("final_score_threshold")
+        minimum = float(configured) if isinstance(configured, (int, float)) else None
+    output = []
+    for item in fused:
+        final_score = float(item.get("score") or 0.0)
+        if minimum is not None and final_score < minimum:
+            continue
+        item["final_score"] = round(final_score, 6)
+        if explain:
+            item["score_details"] = {
+                "semantic_score": item.get("semantic_score"),
+                "keyword_score": item.get("keyword_score"),
+                "vector_rank": item.get("vector_rank"),
+                "keyword_rank": item.get("keyword_rank"),
+                "hybrid_score": item.get("hybrid_score"),
+                "rerank_score": item.get("rerank_score"),
+                "feedback_factor": item.get("feedback_factor", 1.0),
+                "decay_factor": item.get("decay_factor", 1.0),
+                "final_score": item["final_score"],
+                "query_plan_count": len(queries),
+                "query_planning_fallback": planning_fallback,
+                "filter_pushdown": item["filter_pushdown"],
+                "filter_pushdown_fields": item["filter_pushdown_fields"],
+                "post_filter_fields": item["post_filter_fields"],
+            }
+        output.append(item)
+        if len(output) >= (result_limit or top_k):
+            break
+    return output
+
+
+def _valid_luhn(value: str) -> bool:
+    digits = [int(character) for character in value if character.isdigit()]
+    if not 13 <= len(digits) <= 19:
+        return False
+    checksum = 0
+    parity = len(digits) % 2
+    for index, digit in enumerate(digits):
+        if index % 2 == parity:
+            digit *= 2
+            if digit > 9:
+                digit -= 9
+        checksum += digit
+    return checksum % 10 == 0
+
+
+def scan_sensitive_text(text: str, enabled_types: Iterable[str] | None = None) -> list[dict[str, Any]]:
+    allowed = set(enabled_types or SENSITIVE_PATTERNS)
+    findings: list[dict[str, Any]] = []
+    for kind, pattern in SENSITIVE_PATTERNS.items():
+        if kind not in allowed:
+            continue
+        for match in pattern.finditer(text):
+            if kind == "bank_card" and not _valid_luhn(match.group(0)):
+                continue
+            findings.append({"type": kind, "start": match.start(), "end": match.end()})
+    return sorted(findings, key=lambda item: (item["start"], -(item["end"] - item["start"])))
+
+
+def protect_sensitive_text(text: str, settings: dict[str, Any] | None = None) -> tuple[str, list[dict[str, Any]]]:
+    values = settings or get_governance_settings()
+    mode = str(values.get("sensitive_data_mode") or "warn")
+    findings = scan_sensitive_text(text, values.get("sensitive_data_types"))
+    if findings and mode == "block":
+        kinds = "、".join(sorted({str(item["type"]) for item in findings}))
+        raise HTTPException(status_code=422, detail=f"内容包含受保护的敏感信息：{kinds}")
+    if not findings or mode != "redact":
+        return text, findings
+    protected = text
+    for finding in reversed(findings):
+        protected = protected[: finding["start"]] + f"[已隐藏:{finding['type']}]" + protected[finding["end"] :]
+    return protected, findings
+
+
+def protect_sensitive_value(value: Any, settings: dict[str, Any] | None = None) -> tuple[Any, list[dict[str, Any]]]:
+    if isinstance(value, str):
+        return protect_sensitive_text(value, settings)
+    if isinstance(value, list):
+        output: list[Any] = []
+        findings: list[dict[str, Any]] = []
+        for item in value:
+            protected, nested = protect_sensitive_value(item, settings)
+            output.append(protected)
+            findings.extend(nested)
+        return output, findings
+    if isinstance(value, dict):
+        output = {}
+        findings = []
+        for key, item in value.items():
+            protected, nested = protect_sensitive_value(item, settings)
+            output[key] = protected
+            findings.extend(nested)
+        return output, findings
+    return value, []
+
+
+def detect_memory_conflicts(
+    text_value: str,
+    filters: dict[str, Any] | None = None,
+    *,
+    conflict_key: str | None = None,
+) -> list[dict[str, Any]]:
+    settings = get_governance_settings()
+    if not settings.get("conflict_detection_enabled") or not text_value.strip():
+        return []
+    threshold = float(settings.get("conflict_threshold", 0.88))
+    memory = get_memory_instance()
+    try:
+        candidates = memory._search_vector_store(text_value, filters or {}, 8, threshold, explain=False)
+    except Exception:
+        logging.warning("写入冲突检测暂时不可用")
+        return []
+    canonical = re.sub(r"[^\w\u4e00-\u9fff]+", "", text_value.casefold())
+    conflicts = []
+    seen_ids: set[str] = set()
+    for item in candidates:
+        candidate_text = str(item.get("memory") or "")
+        candidate_canonical = re.sub(r"[^\w\u4e00-\u9fff]+", "", candidate_text.casefold())
+        score = float(item.get("score") or 0.0)
+        memory_id = str(item.get("id") or "")
+        if not memory_id or memory_id in seen_ids:
+            continue
+        seen_ids.add(memory_id)
+        conflicts.append(
+            {
+                "memory_id": memory_id,
+                "type": (
+                    "duplicate" if canonical == candidate_canonical
+                    else "possible_duplicate" if not conflict_key and score >= 0.94
+                    else "potential_conflict"
+                ),
+                "score": round(score, 6),
+                "memory": candidate_text[:500],
+                "match_basis": "semantic",
+            }
+        )
+    if conflict_key:
+        with SessionLocal() as db:
+            query = select(MemoryCatalog).where(
+                MemoryCatalog.conflict_key == conflict_key,
+                MemoryCatalog.status == "active",
+            )
+            project_filter = (filters or {}).get("project_id")
+            if isinstance(project_filter, str):
+                query = query.where(MemoryCatalog.project_id == project_filter)
+            rows = db.scalars(query.limit(50)).all()
+        for row in rows:
+            if row.memory_id in seen_ids:
+                continue
+            try:
+                item = memory.get(row.memory_id)
+            except Exception:
+                continue
+            if not isinstance(item, dict):
+                continue
+            candidate_text = str(item.get("memory") or item.get("data") or "")
+            candidate_canonical = re.sub(r"[^\w\u4e00-\u9fff]+", "", candidate_text.casefold())
+            conflicts.append(
+                {
+                    "memory_id": row.memory_id,
+                    "type": "duplicate" if canonical == candidate_canonical else "potential_conflict",
+                    "score": 1.0 if canonical == candidate_canonical else None,
+                    "memory": candidate_text[:500],
+                    "match_basis": "conflict_key",
+                }
+            )
+            seen_ids.add(row.memory_id)
+    return conflicts
+
+
+def project_roles(user: User) -> dict[str, str]:
+    if user.role == "admin":
+        return {}
+    with SessionLocal() as db:
+        rows = db.scalars(select(ProjectMembership).where(ProjectMembership.user_id == user.id)).all()
+    return {row.project_id: row.role for row in rows}
