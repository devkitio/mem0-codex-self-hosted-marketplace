+import argparse
+import hashlib
+import json
+import os
+import re
+import sqlite3
+import uuid
+from pathlib import Path
+
+import psycopg
+from psycopg import sql
+
+
+TABLE_PATTERN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,62}$")
+
+
+def _secret(name: str, default: str = "") -> str:
+    path = os.environ.get(f"{name}_FILE", "").strip()
+    if path:
+        return Path(path).read_text(encoding="utf-8").strip()
+    return os.environ.get(name, default).strip()
+
+
+def _connection(database: str) -> psycopg.Connection:
+    return psycopg.connect(
+        host=os.environ.get("POSTGRES_HOST", "postgres"),
+        port=int(os.environ.get("POSTGRES_PORT", "5432")),
+        dbname=database,
+        user=os.environ.get("POSTGRES_USER", "postgres"),
+        password=_secret("POSTGRES_PASSWORD", "postgres"),
+    )
+
+
+def _payload_version(memory_id: str, payload: dict) -> str:
+    metadata = payload.get("metadata") if isinstance(payload.get("metadata"), dict) else {}
+    explicit = metadata.get("payload_version") or payload.get("payload_version")
+    if explicit:
+        return str(explicit)[:128]
+    basis = "\0".join(
+        (
+            memory_id,
+            str(payload.get("updated_at") or payload.get("created_at") or ""),
+            str(payload.get("memory") or payload.get("data") or ""),
+        )
+    )
+    return hashlib.sha256(basis.encode("utf-8")).hexdigest()
+
+
+def _ensure_history_schema(connection: sqlite3.Connection) -> None:
+    connection.execute(
+        """
+        CREATE TABLE IF NOT EXISTS history (
+            id TEXT PRIMARY KEY, memory_id TEXT, old_memory TEXT, new_memory TEXT,
+            event TEXT, created_at DATETIME, updated_at DATETIME, is_deleted INTEGER,
+            actor_id TEXT, role TEXT, before_payload TEXT, after_payload TEXT,
+            operation_id TEXT, reason TEXT, source_type TEXT, source_id TEXT,
+            source_message_id TEXT, status TEXT, payload_version TEXT
+        )
+        """
+    )
+    columns = {row[1] for row in connection.execute("PRAGMA table_info(history)")}
+    for name, value_type in {
+        "before_payload": "TEXT",
+        "after_payload": "TEXT",
+        "operation_id": "TEXT",
+        "reason": "TEXT",
+        "source_type": "TEXT",
+        "source_id": "TEXT",
+        "source_message_id": "TEXT",
+        "status": "TEXT",
+        "payload_version": "TEXT",
+    }.items():
+        if name not in columns:
+            connection.execute(f"ALTER TABLE history ADD COLUMN {name} {value_type}")
+
+
+def run(apply: bool) -> dict:
+    table = os.environ.get("POSTGRES_COLLECTION_NAME", "memories_qwen37_1024")
+    if not TABLE_PATTERN.fullmatch(table):
+        raise RuntimeError("POSTGRES_COLLECTION_NAME 不是安全的表名")
+    vector_db = os.environ.get("POSTGRES_DB", "postgres")
+    app_db = os.environ.get("APP_DB_NAME", "mem0_app")
+    history_path = Path(os.environ.get("HISTORY_DB_PATH", "/app/history/history.db"))
+    if apply:
+        history_path.parent.mkdir(parents=True, exist_ok=True)
+    summary = {
+        "vector_count": 0,
+        "catalog_inserted": 0,
+        "history_inserted": 0,
+        "missing_catalog": 0,
+        "missing_history": 0,
+        "hash_mismatch": 0,
+        "payload_version_mismatch": 0,
+        "project_mismatch": 0,
+        "orphan_catalog": 0,
+        "orphan_relations": 0,
+        "orphan_feedback": 0,
+        "legacy_feedback": 0,
+        "feedback_project_mismatch": 0,
+        "orphan_retrieval_events": 0,
+        "orphan_profile_sources": 0,
+        "orphan_entity_sources": 0,
+        "orphan_alias_sources": 0,
+        "unresolved_mutations": 0,
+    }
+    history = None
+    try:
+        if apply:
+            history = sqlite3.connect(history_path)
+            _ensure_history_schema(history)
+        elif history_path.exists():
+            history = sqlite3.connect(f"file:{history_path.as_posix()}?mode=ro", uri=True)
+        history_has_table = bool(
+            history
+            and history.execute(
+                "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'history'"
+            ).fetchone()
+        )
+        vector_ids: set[str] = set()
+        with _connection(vector_db) as vectors, _connection(app_db) as app:
+            with vectors.cursor() as source:
+                source.execute(sql.SQL("SELECT id::text, payload FROM {}").format(sql.Identifier(table)))
+                while True:
+                    rows = source.fetchmany(1000)
+                    if not rows:
+                        break
+                    summary["vector_count"] += len(rows)
+                    for memory_id, raw_payload in rows:
+                        payload = dict(raw_payload or {})
+                        metadata = payload.get("metadata") if isinstance(payload.get("metadata"), dict) else {}
+                        vector_ids.add(memory_id)
+                        data = str(payload.get("memory") or payload.get("data") or "")
+                        content_hash = hashlib.sha256(data.encode("utf-8")).hexdigest()
+                        version = _payload_version(memory_id, payload)
+                        project_id = payload.get("project_id") or metadata.get("project_id")
+                        with app.cursor() as target:
+                            target.execute(
+                                "SELECT content_hash, project_id, payload_version FROM memory_catalog WHERE memory_id = %s",
+                                (memory_id,),
+                            )
+                            existing = target.fetchone()
+                            if existing is None:
+                                summary["missing_catalog"] += 1
+                                if apply:
+                                    target.execute(
+                                        """
+                                        INSERT INTO memory_catalog (
+                                            memory_id, schema_version, status, payload_version, content_hash,
+                                            user_id, agent_id, run_id, project_id, session_id, confidence,
+                                            category, memory_type, source_type, source_id, source_message_id,
+                                            conflict_key, profile_key, supersedes_id, extra, created_at, updated_at
+                                        ) VALUES (
+                                            %s, 2, 'active', %s, %s, %s, %s, %s, %s, %s, NULL,
+                                            %s, %s, 'legacy', NULL, NULL, %s, %s, NULL, '{}'::json,
+                                            CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
+                                        ) ON CONFLICT (memory_id) DO NOTHING
+                                        """,
+                                        (
+                                            memory_id, version, content_hash,
+                                            payload.get("user_id") or metadata.get("user_id"),
+                                            payload.get("agent_id") or metadata.get("agent_id"),
+                                            payload.get("run_id") or metadata.get("run_id"),
+                                            project_id,
+                                            payload.get("session_id") or metadata.get("session_id"),
+                                            payload.get("category") or metadata.get("category"),
+                                            payload.get("memory_type") or metadata.get("memory_type")
+                                            or payload.get("memory_kind") or metadata.get("memory_kind")
+                                            or payload.get("type") or metadata.get("type"),
+                                            payload.get("conflict_key") or metadata.get("conflict_key"),
+                                            payload.get("profile_key") or metadata.get("profile_key"),
+                                        ),
+                                    )
+                                    summary["catalog_inserted"] += target.rowcount
+                            else:
+                                summary["hash_mismatch"] += int(existing[0] != content_hash)
+                                summary["project_mismatch"] += int(existing[1] != project_id)
+                                summary["payload_version_mismatch"] += int(existing[2] != version)
+                                if apply and existing != (content_hash, project_id, version):
+                                    target.execute(
+                                        """
+                                        UPDATE memory_catalog
+                                        SET content_hash = %s, project_id = %s, payload_version = %s,
+                                            updated_at = CURRENT_TIMESTAMP
+                                        WHERE memory_id = %s
+                                        """,
+                                        (content_hash, project_id, version, memory_id),
+                                    )
+                        baseline = (
+                            history.execute(
+                                "SELECT 1 FROM history WHERE memory_id = ? LIMIT 1", (memory_id,)
+                            ).fetchone()
+                            if history_has_table
+                            else None
+                        )
+                        if baseline is None:
+                            summary["missing_history"] += 1
+                        if baseline is None and apply and history is not None:
+                            history.execute(
+                                """
+                                INSERT INTO history (
+                                    id, memory_id, old_memory, new_memory, event, created_at, updated_at,
+                                    is_deleted, before_payload, after_payload, reason, source_type, status,
+                                    payload_version
+                                ) VALUES (?, ?, NULL, ?, 'MIGRATION_BASELINE', ?, ?, 0, NULL, ?, ?, ?, 'active', ?)
+                                """,
+                                (
+                                    str(uuid.uuid4()), memory_id, data,
+                                    payload.get("created_at"), payload.get("updated_at"),
+                                    json.dumps(payload, ensure_ascii=False, default=str),
+                                    "统一记忆模型迁移基线", "legacy", version,
+                                ),
+                            )
+                            summary["history_inserted"] += 1
+                    if apply:
+                        app.commit()
+                        if history is not None:
+                            history.commit()
+
+            with app.cursor() as cursor:
+                cursor.execute("SELECT memory_id, status FROM memory_catalog")
+                catalog_rows = cursor.fetchall()
+                catalog_ids = {memory_id for memory_id, _status in catalog_rows}
+                summary["orphan_catalog"] = sum(
+                    1 for memory_id, status in catalog_rows
+                    if memory_id not in vector_ids and status != "deleted"
+                )
+                cursor.execute(
+                    """
+                    SELECT COUNT(*) FROM memory_relations r
+                    LEFT JOIN memory_catalog s ON s.memory_id = r.source_memory_id
+                    LEFT JOIN memory_catalog t ON t.memory_id = r.target_memory_id
+                    WHERE s.memory_id IS NULL OR t.memory_id IS NULL
+                    """
+                )
+                summary["orphan_relations"] = cursor.fetchone()[0]
+                cursor.execute(
+                    """
+                    SELECT f.id, f.payload_version, f.project_id, c.payload_version, c.project_id
+                    FROM memory_feedback f
+                    LEFT JOIN memory_catalog c ON c.memory_id = f.memory_id
+                    """
+                )
+                feedback_rows = cursor.fetchall()
+                for feedback_id, feedback_version, feedback_project, current_version, current_project in feedback_rows:
+                    if current_version is None:
+                        summary["orphan_feedback"] += 1
+                        continue
+                    if feedback_version == "legacy":
+                        summary["legacy_feedback"] += 1
+                    if feedback_project != current_project:
+                        summary["feedback_project_mismatch"] += 1
+                    if apply and (feedback_version == "legacy" or feedback_project != current_project):
+                        with app.cursor() as updater:
+                            updater.execute(
+                                "UPDATE memory_feedback SET payload_version = %s, project_id = %s WHERE id = %s",
+                                (current_version, current_project, feedback_id),
+                            )
+                cursor.execute(
+                    """
+                    SELECT COUNT(*) FROM retrieval_events e
+                    LEFT JOIN memory_catalog c ON c.memory_id = e.memory_id
+                    WHERE c.memory_id IS NULL
+                    """
+                )
+                summary["orphan_retrieval_events"] = cursor.fetchone()[0]
+                cursor.execute("SELECT source_memory_ids FROM profile_projections")
+                summary["orphan_profile_sources"] = sum(
+                    1
+                    for (source_ids,) in cursor.fetchall()
+                    for memory_id in (source_ids or [])
+                    if memory_id not in catalog_ids
+                )
+                cursor.execute("SELECT source_memory_ids FROM entity_projections")
+                summary["orphan_entity_sources"] = sum(
+                    1
+                    for (source_ids,) in cursor.fetchall()
+                    for memory_id in (source_ids or [])
+                    if memory_id not in catalog_ids
+                )
+                cursor.execute("SELECT source_memory_ids FROM entity_alias_projections")
+                summary["orphan_alias_sources"] = sum(
+                    1
+                    for (source_ids,) in cursor.fetchall()
+                    for memory_id in (source_ids or [])
+                    if memory_id not in catalog_ids
+                )
+                cursor.execute(
+                    """
+                    SELECT COUNT(*) FROM memory_mutations
+                    WHERE status IN ('vector_applied', 'failed') AND after_payload IS NOT NULL
+                    """
+                )
+                summary["unresolved_mutations"] = cursor.fetchone()[0]
+            if apply:
+                app.commit()
+    finally:
+        if history is not None:
+            history.close()
+
+    consistency_keys = (
+        "missing_catalog", "missing_history", "hash_mismatch", "payload_version_mismatch",
+        "project_mismatch", "orphan_catalog", "orphan_relations", "orphan_feedback",
+        "legacy_feedback", "feedback_project_mismatch", "orphan_retrieval_events",
+        "orphan_profile_sources", "orphan_entity_sources", "orphan_alias_sources",
+        "unresolved_mutations",
+    )
+    if not apply and any(summary[key] for key in consistency_keys):
+        raise RuntimeError(f"记忆质量一致性检查失败：{json.dumps(summary, ensure_ascii=False)}")
+    return summary
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="回填并校验统一记忆质量模型")
+    parser.add_argument("--apply", action="store_true", help="执行缺失目录与历史基线回填")
+    args = parser.parse_args()
+    print(json.dumps(run(args.apply), ensure_ascii=False, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
