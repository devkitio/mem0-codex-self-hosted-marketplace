+def _secret(name: str, default: str = "") -> str:
+    file_path = os.environ.get(f"{name}_FILE", "").strip()
+    if file_path:
+        try:
+            value = Path(file_path).read_text(encoding="utf-8")
+        except OSError as exc:
+            raise RuntimeError(f"无法读取 {name} 的 secret 文件") from exc
+        if len(value) > 8192:
+            raise RuntimeError(f"{name} 的 secret 文件超过大小限制")
+        return value.strip()
+    return os.environ.get(name, default).strip()
+
+
+def _connection() -> psycopg.Connection:
+    return psycopg.connect(
+        host=os.environ.get("POSTGRES_HOST", "postgres"),
+        port=int(os.environ.get("POSTGRES_PORT", "5432")),
+        dbname=os.environ.get("POSTGRES_DB", "postgres"),
+        user=os.environ.get("POSTGRES_USER", "postgres"),
+        password=_secret("POSTGRES_PASSWORD", "postgres"),
+    )
+
+
+def _fetch_rows(cursor, table: str, owner: str, batch_size: int, after_id):
+    after_clause = sql.SQL("")
+    parameters = [owner]
+    if after_id is not None:
+        after_clause = sql.SQL("AND id > %s")
+        parameters.append(after_id)
+    parameters.append(batch_size)
+    cursor.execute(
+        sql.SQL(
+            """
+            SELECT id,
+                   payload->>'project_id',
+                   payload->>'scope',
+                   payload->>'user_id',
+                   payload->>'agent_id'
+            FROM {}
+            WHERE payload->>'mcp_owner' = %s
+              {}
+            ORDER BY id
+            LIMIT %s
+            FOR UPDATE
+            """
+        ).format(sql.Identifier(table), after_clause),
+        parameters,
+    )
+    return cursor.fetchall()
+
+
+def _plan_changes(rows, owner: str, user_id: str):
+    changes = []
+    conflicts = 0
+    invalid = 0
+    for memory_id, project_id, scope, row_user_id, agent_id in rows:
+        if row_user_id != user_id:
+            conflicts += 1
+            continue
+        if project_id in (None, ""):
+            project_id = None
+        elif not isinstance(project_id, str) or not PROJECT_ID_PATTERN.fullmatch(project_id):
+            invalid += 1
+            continue
+        expected_scope = "project" if project_id else "global"
+        if scope != expected_scope:
+            invalid += 1
+            continue
+        expected_agent = derive_mcp_agent_id(owner, project_id)
+        if agent_id == expected_agent:
+            continue
+        if agent_id not in (None, ""):
+            conflicts += 1
+            continue
+        changes.append((expected_agent, memory_id))
+    if conflicts or invalid:
+        raise RuntimeError("检测到身份冲突或非法作用域，已停止回填")
+    return changes
+
+
+def _acquire_migration_lock(cursor) -> None:
+    deadline = time.monotonic() + MIGRATION_LOCK_TIMEOUT_SECONDS
+    while True:
+        cursor.execute(
+            "SELECT pg_try_advisory_xact_lock(hashtextextended(%s, 0))",
+            (MIGRATION_LOCK,),
+        )
+        if cursor.fetchone()[0]:
+            return
+        if time.monotonic() >= deadline:
+            raise RuntimeError("等待 MCP 作用域迁移锁超时")
+        time.sleep(0.1)
+
+
+def _migrate_rows(cursor, table: str, owner: str, user_id: str, apply: bool, batch_size: int):
+    scanned = 0
+    planned = 0
+    updated = 0
+    after_id = None
+    while True:
+        rows = _fetch_rows(cursor, table, owner, batch_size, after_id)
+        if not rows:
+            break
+        changes = _plan_changes(rows, owner, user_id)
+        scanned += len(rows)
+        planned += len(changes)
+        if apply and changes:
+            cursor.executemany(
+                sql.SQL(
+                    """
+                    UPDATE {}
+                    SET payload = jsonb_set(payload, '{{agent_id}}', to_jsonb(%s::text), true)
+                    WHERE id = %s
+                      AND payload->>'mcp_owner' = %s
+                      AND payload->>'user_id' = %s
+                      AND COALESCE(payload->>'agent_id', '') = ''
+                    """
+                ).format(sql.Identifier(table)),
+                [(agent_id, memory_id, owner, user_id) for agent_id, memory_id in changes],
+            )
+            if cursor.rowcount != len(changes):
+                raise RuntimeError("回填目标在事务中发生变化，已回滚")
+            updated += len(changes)
+        after_id = rows[-1][0]
+        if len(rows) < batch_size:
+            break
+    return scanned, planned, updated
+
+
+def run(apply: bool) -> dict[str, int]:
+    table = os.environ.get("POSTGRES_COLLECTION_NAME", "memories")
+    if not TABLE_PATTERN.fullmatch(table):
+        raise RuntimeError("POSTGRES_COLLECTION_NAME 格式无效")
+    owner = validate_mcp_identity(
+        os.environ.get("MEM0_INTERNAL_OWNER", ""), "MEM0_INTERNAL_OWNER"
+    )
+    user_id = validate_mcp_identity(
+        os.environ.get("MEM0_INTERNAL_USER_ID", ""), "MEM0_INTERNAL_USER_ID"
+    )
+    batch_size = int(os.environ.get("MEM0_MCP_BACKFILL_BATCH_SIZE", "500"))
+    if not 1 <= batch_size <= 5000:
+        raise RuntimeError("MCP 回填批次大小未正确配置")
+
+    with _connection() as connection:
+        with connection.cursor() as cursor:
+            cursor.execute("SET TRANSACTION ISOLATION LEVEL REPEATABLE READ")
+            cursor.execute("SELECT set_config('lock_timeout', %s, true)", (ROW_LOCK_TIMEOUT,))
+            _acquire_migration_lock(cursor)
+            cursor.execute("SELECT to_regclass(%s)", (table,))
+            table_exists = cursor.fetchone()[0] is not None
+            scanned, planned, updated = (
+                _migrate_rows(cursor, table, owner, user_id, apply, batch_size)
+                if table_exists
+                else (0, 0, 0)
+            )
+
+    return {
+        "扫描数量": scanned,
+        "待回填数量": planned,
+        "已回填数量": updated,
+        "冲突数量": 0,
+        "非法项目数量": 0,
+    }
+
+
+def main_cli() -> int:
+    parser = argparse.ArgumentParser(description="为旧受管记忆回填稳定的 MCP 项目作用域")
+    parser.add_argument("--apply", action="store_true", help="执行幂等回填；省略时只检查")
+    args = parser.parse_args()
+    print(json.dumps(run(args.apply), ensure_ascii=False, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main_cli())
+    except Exception as exc:
+        print(
+            json.dumps({"状态": "失败", "错误类型": type(exc).__name__}, ensure_ascii=False),
+            file=sys.stderr,
+        )
+        raise SystemExit(1) from None
