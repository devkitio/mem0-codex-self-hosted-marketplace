+):
+    started_at = time.perf_counter()
+    scope = InternalMemoryQuery(
+        project_id=request.project_id,
+        include_global=bool(request.project_id),
+        filters=request.filters,
+        show_expired=request.show_expired,
+    )
+    try:
+        if scope.filters:
+            _validate_internal_filter(scope.filters)
+        rows = hybrid_search(
+            request.query,
+            _vector_store_filter(_internal_scope_filter(scope)),
+            request.top_k,
+            request.threshold if request.threshold is not None else 0.1,
+            explain=request.explain,
+            show_expired=request.show_expired,
+            rerank=request.rerank,
+            final_score_threshold=request.final_score_threshold,
+        )
+        rows = _validated_rows(rows, "内部混合搜索")
+        source = rows
+        rows: List[Dict[str, Any]] = []
+        seen: set[str] = set()
+        for item in source:
+            if not isinstance(item, dict) or not _matches_internal_query(item, scope, None):
+                continue
+            memory_id = item.get("id")
+            if not isinstance(memory_id, str) or not memory_id or memory_id in seen:
