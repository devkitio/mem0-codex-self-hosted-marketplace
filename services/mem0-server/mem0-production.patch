+                          {item.reason ? ` · 原因：${item.reason}` : ""}
+                        </p>
+                      )}
+                      {value && isAdmin && (
+                        <Button
+                          variant="outline"
+                          size="sm"
+                          disabled={restoringId === String(item.id)}
+                          onClick={() => setPendingRestore(item)}
+                        >
+                          <RotateCcw className="mr-1 size-3.5" />
+                          {restoringId === String(item.id)
+                            ? "恢复中…"
+                            : "恢复此版本"}
+                        </Button>
+                      )}
+                    </div>
+                  </div>
+                );
+              })}
+            </div>
+          )}
+        </DialogContent>
+      </Dialog>
+
+      <Dialog
+        open={!!pendingRestore}
+        onOpenChange={(open) => !open && setPendingRestore(null)}
+      >
+        <DialogContent>
+          <DialogHeader>
+            <DialogTitle>确认恢复历史版本</DialogTitle>
+            <DialogDescription>
+              当前记忆将恢复为所选历史正文；如果原记忆已删除，将使用原身份范围重新建立一条记忆。
+            </DialogDescription>
+          </DialogHeader>
+          <p className="max-h-48 overflow-auto rounded-lg bg-surface-default-secondary p-3 text-sm whitespace-pre-wrap">
+            {pendingRestore?.new_memory ||
+              pendingRestore?.old_memory ||
+              "此版本没有正文"}
+          </p>
+          <DialogFooter>
+            <Button variant="outline" onClick={() => setPendingRestore(null)}>
+              取消
+            </Button>
+            <Button
+              onClick={() => pendingRestore && restoreVersion(pendingRestore)}
+              disabled={
+                !!pendingRestore && restoringId === String(pendingRestore.id)
+              }
+            >
+              {pendingRestore && restoringId === String(pendingRestore.id)
+                ? "恢复中…"
+                : "确认恢复"}
+            </Button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+
+      <Dialog
+        open={!!feedbackMemory}
+        onOpenChange={(open) => !open && setFeedbackMemory(null)}
+      >
+        <DialogContent>
+          <DialogHeader>
+            <DialogTitle>标记为“{verdictLabels[verdict]}”</DialogTitle>
+            <DialogDescription>
+              审查结论会进入质量中心，便于集中处理低质量记忆。
+            </DialogDescription>
+          </DialogHeader>
+          <div className="space-y-3">
+            <div className="flex gap-2" role="group" aria-label="审查结论">
+              {(Object.keys(verdictLabels) as FeedbackVerdict[]).map(
+                (value) => (
+                  <Button
+                    key={value}
+                    type="button"
+                    size="sm"
+                    variant={verdict === value ? "default" : "outline"}
+                    onClick={() => setVerdict(value)}
+                  >
+                    {verdictLabels[value]}
+                  </Button>
+                ),
+              )}
+            </div>
+            <div className="space-y-1.5">
+              <Label htmlFor="feedback-reason">
+                原因{verdict === "correct" ? "（可选）" : ""}
+              </Label>
+              <Textarea
+                id="feedback-reason"
+                value={reason}
+                onChange={(event) => setReason(event.target.value)}
+                placeholder="说明为什么这条记忆需要保留或处理"
+                rows={4}
+              />
+            </div>
+          </div>
+          <DialogFooter>
+            <Button variant="outline" onClick={() => setFeedbackMemory(null)}>
+              取消
+            </Button>
+            <Button onClick={saveFeedback} disabled={savingFeedback}>
+              {savingFeedback ? "保存中…" : "保存审查"}
+            </Button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+    </div>
+  );
+}
