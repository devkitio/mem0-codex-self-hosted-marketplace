+class DreamScanRequest(BaseModel):
+    project_id: str | None = Field(None, max_length=64)
+    use_llm: bool = False
+
+
+def _canonical_memory(value: str) -> str:
+    return re.sub(r"[^\w\u4e00-\u9fff]+", "", value.casefold())
+
+
+def _dream_rows(project_id: str | None) -> list[dict[str, Any]]:
+    rows = [
+        row
+        for row in (_serialize_row(item) for item in _list_rows())
+        if str(_metadata(row).get("status") or "active") == "active"
+    ]
+    if project_id is not None:
+        rows = [row for row in rows if _metadata(row).get("project_id") == project_id]
+    return rows
+
+
+def _dream_protected(item: dict[str, Any]) -> bool:
+    metadata = _metadata(item)
+    protected_types = {"medical", "safety", "credential", "credentials", "permission", "permissions"}
+    values = {
+        str(metadata.get("memory_type") or "").casefold(),
+        str(metadata.get("category") or "").casefold(),
+    }
+    sensitive = scan_sensitive_text(
+        str(item.get("memory") or item.get("data") or ""),
+        get_governance_settings().get("sensitive_data_types"),
+    )
+    return bool(metadata.get("pinned")) or bool(values & protected_types) or bool(sensitive)
+
+
+def _choose_keeper(ids: list[str], access_by_id: dict[str, int], rows: dict[str, dict[str, Any]]) -> str:
+    return max(
+        ids,
+        key=lambda memory_id: (
+            access_by_id.get(memory_id, 0),
+            _memory_version(rows[memory_id]),
+            memory_id,
+        ),
+    )
+
+
+def _llm_dream_proposals(rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    sample = [
+        {"id": row["id"], "memory": row["memory"]}
+        for row in rows
+        if not _dream_protected(row)
+    ][:100]
+    if len(sample) < 2:
+        return []
+    prompt = (
+        "你是记忆治理审查器。仅依据给定记忆，找出语义重复、明确冲突，以及可合并的稳定偏好。"
+        "返回 JSON 对象，字段 proposals 是数组；每项必须包含 type（duplicate/conflict/profile）、"
+        "memory_ids、keep_id、reason、suggested_text。不得编造 ID，不确定时不要提案。\n"
+        + json.dumps(sample, ensure_ascii=False)
+    )
+    response = get_memory_instance().llm.generate_response(
+        messages=[{"role": "user", "content": prompt}], response_format={"type": "json_object"}
+    )
+    decoded = json.loads(response)
+    proposals = decoded.get("proposals", []) if isinstance(decoded, dict) else []
+    allowed_ids = {row["id"] for row in rows}
+    valid = []
+    used_ids: set[str] = set()
+    for proposal in proposals[:50]:
+        ids = proposal.get("memory_ids") if isinstance(proposal, dict) else None
+        keep_id = proposal.get("keep_id") if isinstance(proposal, dict) else None
+        proposal_type = proposal.get("type") if isinstance(proposal, dict) else None
+        if not isinstance(ids, list) or any(not isinstance(item, str) for item in ids):
+            continue
+        normalized_ids = list(dict.fromkeys(ids))
+        if (
+            proposal_type not in {"duplicate", "conflict", "profile"}
+            or len(normalized_ids) < 2
+            or len(normalized_ids) > 20
+            or any(item not in allowed_ids for item in normalized_ids)
+            or keep_id not in normalized_ids
+            or bool(set(normalized_ids) & used_ids)
+        ):
+            continue
+        used_ids.update(normalized_ids)
+        valid.append(
+            {
+                "type": proposal_type,
+                "memory_ids": normalized_ids,
+                "keep_id": keep_id,
+                "reason": str(proposal.get("reason") or "模型识别的治理提案")[:1000],
+                "suggested_text": str(proposal.get("suggested_text") or "")[:50000],
+                "resolution": "pending" if proposal_type == "conflict" else (
+                    "coexist" if proposal_type == "profile" else "supersede"
+                ),
+            }
+        )
+    return valid
+
+
+def _create_dream_scan(body: DreamScanRequest, user: User, db: Session) -> dict[str, Any]:
+    rows = _dream_rows(body.project_id)
+    rows_by_id = {row["id"]: row for row in rows}
+    ids = list(rows_by_id)
+    access_rows = db.scalars(select(MemoryAccess).where(MemoryAccess.memory_id.in_(ids))).all() if ids else []
+    access_by_id = {row.memory_id: row.effective_access_count for row in access_rows}
+    proposals: list[dict[str, Any]] = []
+
+    duplicate_groups: dict[str, list[str]] = defaultdict(list)
+    conflict_groups: dict[str, list[str]] = defaultdict(list)
+    profile_groups: dict[str, list[str]] = defaultdict(list)
+    for row in rows:
+        if _dream_protected(row):
+            continue
+        canonical = _canonical_memory(str(row.get("memory") or ""))
+        if canonical:
+            duplicate_groups[canonical].append(row["id"])
+        metadata = _metadata(row)
+        if metadata.get("conflict_key"):
+            conflict_groups[str(metadata["conflict_key"])].append(row["id"])
+        if metadata.get("profile_key"):
+            profile_groups[str(metadata["profile_key"])].append(row["id"])
+
+    touched: set[str] = set()
+    for group in duplicate_groups.values():
+        if len(group) < 2:
+            continue
+        keep_id = _choose_keeper(group, access_by_id, rows_by_id)
+        proposals.append(
+            {
+                "type": "duplicate",
+                "memory_ids": group,
+                "keep_id": keep_id,
+                "reason": "正文归一化后完全重复，保留访问频率和更新时间更高的版本",
+                "suggested_text": rows_by_id[keep_id]["memory"],
+                "resolution": "supersede",
+            }
+        )
+        touched.update(group)
+
+    for key, group in conflict_groups.items():
+        unique_texts = {_canonical_memory(rows_by_id[item]["memory"]) for item in group}
+        if len(group) < 2 or len(unique_texts) < 2 or any(item in touched for item in group):
+            continue
+        keep_id = _choose_keeper(group, access_by_id, rows_by_id)
+        proposals.append(
+            {
+                "type": "conflict",
+                "memory_ids": group,
+                "keep_id": keep_id,
+                "reason": f"同一冲突键“{key}”存在不同结论，建议保留较新且使用更多的版本",
+                "suggested_text": rows_by_id[keep_id]["memory"],
+                "resolution": "pending",
+            }
+        )
+        touched.update(group)
+
+    for key, group in profile_groups.items():
+        unique = list(dict.fromkeys(rows_by_id[item]["memory"] for item in group))
+        if len(group) < 2 or len(unique) < 2 or any(item in touched for item in group):
+            continue
+        keep_id = _choose_keeper(group, access_by_id, rows_by_id)
+        proposals.append(
+            {
+                "type": "profile",
+                "memory_ids": group,
+                "keep_id": keep_id,
+                "reason": f"同一画像键“{key}”包含多条稳定信息，可合并为一条画像记忆",
+                "suggested_text": "；".join(unique)[:50000],
+                "resolution": "coexist",
+            }
+        )
+        touched.update(group)
+
+    if body.use_llm:
+        try:
+            proposals.extend(_llm_dream_proposals([row for row in rows if row["id"] not in touched]))
+        except Exception:
+            logging.warning("Dream 模型分析失败，已保留确定性扫描结果")
+
+    versions = {
+        memory_id: _memory_version(rows_by_id[memory_id])
+        for proposal in proposals
+        for memory_id in proposal["memory_ids"]
+    }
+    preview_hash = memory_versions_hash(versions)
+    operation = MemoryOperation(
+        kind="dream",
+        status="preview",
+        request_data={"project_id": body.project_id, "use_llm": body.use_llm, "proposals": proposals},
+        targets={"versions": versions},
+        preview_hash=preview_hash,
+        created_by=_actor_id(user),
+        expires_at=_utcnow() + timedelta(minutes=OPERATION_TTL_MINUTES),
+    )
+    db.add(operation)
+    settings = get_governance_settings(db)
+    settings["dream_last_run_at"] = _utcnow().isoformat()
+    row = db.get(Settings, "memory_governance")
+    serialized = json.dumps(settings, ensure_ascii=False, allow_nan=False)
+    if row is None:
+        db.add(Settings(key="memory_governance", value=serialized))
+    else:
+        row.value = serialized
+    db.commit()
+    db.refresh(operation)
+    log_memory_activity(
+        "dream_preview",
+        user=user,
+        source="dream",
+        details={"扫描数量": len(rows), "提案数量": len(proposals), "使用模型": body.use_llm},
+    )
+    return {
+        "operation_id": str(operation.id),
+        "preview_hash": preview_hash,
+        "expires_at": operation.expires_at,
+        "scanned": len(rows),
+        "count": len(proposals),
+        "proposals": proposals,
+    }
+
+
+def _run_due_dream_if_due(user: User, db: Session) -> dict[str, Any]:
+    acquired = bool(
+        db.scalar(
+            text("SELECT pg_try_advisory_lock(hashtextextended(:lock_name, 0))"),
+            {"lock_name": DREAM_SCHEDULER_LOCK},
+        )
+    )
+    if not acquired:
+        return {"due": False, "reason": "另一个实例正在执行 Dream 周期检查"}
+    try:
+        settings = get_governance_settings(db)
+        if not settings["dream_enabled"]:
+            return {"due": False, "reason": "Dream 定期整理未启用"}
+        last_run = _parse_datetime(settings.get("dream_last_run_at"))
+        due_at = (last_run or datetime.min.replace(tzinfo=timezone.utc)) + timedelta(
+            days=int(settings["dream_interval_days"])
+        )
+        if due_at > _utcnow():
+            return {"due": False, "next_run_at": due_at}
+        result = _create_dream_scan(DreamScanRequest(), user, db)
+        return {"due": True, **result}
+    finally:
+        db.execute(
+            text("SELECT pg_advisory_unlock(hashtextextended(:lock_name, 0))"),
+            {"lock_name": DREAM_SCHEDULER_LOCK},
+        )
+        db.commit()
+
+
+def _run_due_dream_in_background() -> None:
+    from db import SessionLocal
+
+    system_user = User(
+        id=uuid.UUID(int=0),
+        name="系统",
+        email="system@local",
+        password_hash="",
+    )
+    with SessionLocal() as db:
+        _run_due_dream_if_due(system_user, db)
+
+
+async def _dream_scheduler_loop() -> None:
+    while True:
+        await asyncio.sleep(DREAM_POLL_SECONDS)
+        try:
+            await asyncio.to_thread(archive_expired_candidates)
+            await asyncio.to_thread(retry_pending_mutations)
+            await asyncio.to_thread(_run_due_dream_in_background)
+        except asyncio.CancelledError:
+            raise
+        except Exception:
+            logging.exception("Dream 后台周期检查失败")
+
+
+async def start_dream_scheduler() -> None:
+    global DREAM_SCHEDULER_TASK
+    if DREAM_SCHEDULER_TASK is None or DREAM_SCHEDULER_TASK.done():
+        await asyncio.to_thread(archive_expired_candidates)
+        await asyncio.to_thread(retry_pending_mutations)
+        DREAM_SCHEDULER_TASK = asyncio.create_task(_dream_scheduler_loop())
+
+
+async def stop_dream_scheduler() -> None:
+    global DREAM_SCHEDULER_TASK
+    if DREAM_SCHEDULER_TASK is None:
+        return
+    DREAM_SCHEDULER_TASK.cancel()
+    with suppress(asyncio.CancelledError):
+        await DREAM_SCHEDULER_TASK
+    DREAM_SCHEDULER_TASK = None
+
