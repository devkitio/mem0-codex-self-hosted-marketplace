+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from memory_quality_service import retry_pending_mutations
+
+
+def run(max_rounds: int, batch_size: int) -> dict[str, int]:
+    totals = {"claimed": 0, "completed": 0, "failed": 0, "rounds": 0}
+    for _index in range(max_rounds):
+        result = retry_pending_mutations(limit=batch_size, force=True)
+        totals["rounds"] += 1
+        for key in ("claimed", "completed", "failed"):
+            totals[key] += int(result[key])
+        if result["failed"]:
+            raise RuntimeError(f"记忆目录重试仍有失败：{json.dumps(totals, ensure_ascii=False)}")
+        if result["claimed"] == 0:
+            return totals
+    raise RuntimeError(f"记忆目录重试超过最大轮数：{json.dumps(totals, ensure_ascii=False)}")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="在 API 启动前收敛记忆目录同步事件")
+    parser.add_argument("--max-rounds", type=int, default=200)
+    parser.add_argument("--batch-size", type=int, default=500)
+    args = parser.parse_args()
+    if args.max_rounds < 1 or args.batch_size < 1 or args.batch_size > 500:
+        raise RuntimeError("重试轮数和批次大小无效")
+    print(json.dumps(run(args.max_rounds, args.batch_size), ensure_ascii=False, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
