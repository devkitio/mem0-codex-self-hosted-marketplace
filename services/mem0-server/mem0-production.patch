diff --git a/server/governance_service.py b/server/governance_service.py
new file mode 100644
index 0000000000000000000000000000000000000000..7b8b3e9a7b0b83fe156c0bd732109cf0afdd308b
--- /dev/null
+++ b/server/governance_service.py
@@ -0,0 +1,192 @@
+import hashlib
+import json
+import logging
+import math
+import uuid
+from datetime import datetime, timezone
+from typing import Any, Iterable
+
+from db import SessionLocal
+from models import MemoryAccess, MemoryActivity, Settings, User
+from sqlalchemy import select
+
+GOVERNANCE_SETTINGS_KEY = "memory_governance"
+DEFAULT_GOVERNANCE_SETTINGS: dict[str, Any] = {
+    "quality_gate_enabled": True,
+    "feedback_ranking_enabled": True,
+    "multi_query_enabled": True,
+    "query_planning_timeout_ms": 800,
+    "final_score_threshold": None,
+    "decay_enabled": True,
+    "decay_half_life_days": 30,
+    "decay_weight": 0.25,
+    "decay_minimum_factor": 0.55,
+    "decay_frequency_cap": 20,
+    "dream_enabled": True,
+    "dream_interval_days": 7,
+    "dream_last_run_at": None,
+    "hybrid_search_enabled": True,
+    "hybrid_vector_weight": 0.65,
+    "sensitive_data_mode": "warn",
+    "sensitive_data_types": ["email", "phone", "id_card", "bank_card"],
+    "conflict_detection_enabled": True,
+    "conflict_action": "warn",
+    "conflict_threshold": 0.88,
+    "backup_enabled": True,
+    "backup_interval_hours": 24,
+    "backup_retention": 14,
+    "backup_last_run_at": None,
+}
+
+
+def _utcnow() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def _actor(user: User | None) -> tuple[uuid.UUID | None, str]:
+    if user is None:
+        return None, "系统"
+    user_id = getattr(user, "id", None)
+    if isinstance(user_id, uuid.UUID) and user_id.int == 0:
+        user_id = None
+    return user_id, getattr(user, "name", None) or "管理员"
+
+
+def get_governance_settings(session=None) -> dict[str, Any]:
+    own_session = session is None
+    db = session or SessionLocal()
+    try:
+        row = db.get(Settings, GOVERNANCE_SETTINGS_KEY)
+        if row is None:
+            return dict(DEFAULT_GOVERNANCE_SETTINGS)
+        decoded = json.loads(row.value)
+        if not isinstance(decoded, dict):
+            raise ValueError("治理设置格式无效")
+        return {**DEFAULT_GOVERNANCE_SETTINGS, **decoded}
+    except (TypeError, ValueError, json.JSONDecodeError):
+        logging.warning("治理设置格式无效，已使用默认值")
+        return dict(DEFAULT_GOVERNANCE_SETTINGS)
+    finally:
+        if own_session:
+            db.close()
+
+
+def save_governance_settings(values: dict[str, Any], session) -> dict[str, Any]:
+    settings = {**get_governance_settings(session), **values}
+    serialized = json.dumps(settings, ensure_ascii=False, allow_nan=False)
+    row = session.get(Settings, GOVERNANCE_SETTINGS_KEY)
+    if row is None:
+        session.add(Settings(key=GOVERNANCE_SETTINGS_KEY, value=serialized))
+    else:
+        row.value = serialized
+    session.commit()
+    return settings
+
+
+def log_memory_activity(
+    action: str,
+    *,
+    user: User | None = None,
+    memory_id: str | None = None,
+    source: str = "rest",
+    success: bool = True,
+    details: dict[str, Any] | None = None,
+) -> None:
+    actor_id, actor_name = _actor(user)
+    safe_details = details if isinstance(details, dict) else {}
+    try:
+        encoded = json.dumps(safe_details, ensure_ascii=False, allow_nan=False)
+        safe_details = json.loads(encoded)
+        if len(encoded.encode("utf-8")) > 16384:
+            safe_details = {"提示": "活动详情超过大小限制，已省略"}
+    except (TypeError, ValueError):
+        safe_details = {"提示": "活动详情包含不可序列化字段，已省略"}
+
+    with SessionLocal() as db:
+        try:
+            db.add(
+                MemoryActivity(
+                    action=action[:32],
+                    memory_id=memory_id[:128] if memory_id else None,
+                    actor_id=actor_id,
+                    actor_name=actor_name[:255],
+                    source=source[:32],
+                    success=success,
+                    details=safe_details,
+                )
+            )
+            db.commit()
+        except Exception:
+            db.rollback()
+            logging.warning("记忆活动记录写入失败")
+
+
+def record_memory_access(memory_ids: Iterable[str]) -> None:
+    """兼容旧调用；详情打开属于有效访问，搜索曝光必须使用检索事件接口。"""
+    from memory_quality_service import record_effective_access
+
+    record_effective_access(memory_ids, event_type="open")
+
+
+def _as_utc(value: datetime | None) -> datetime | None:
+    if value is None:
+        return None
+    if value.tzinfo is None:
+        return value.replace(tzinfo=timezone.utc)
+    return value.astimezone(timezone.utc)
+
+
+def apply_memory_decay(results: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    if not results:
+        return results
+    settings = get_governance_settings()
+    if not settings["decay_enabled"]:
+        return results
+
+    memory_ids = [str(item.get("id")) for item in results if item.get("id")]
+    with SessionLocal() as db:
+        rows = db.scalars(select(MemoryAccess).where(MemoryAccess.memory_id.in_(memory_ids))).all()
+    access_by_id = {row.memory_id: row for row in rows}
+
+    now = _utcnow()
+    half_life_days = max(float(settings["decay_half_life_days"]), 1.0)
+    weight = min(max(float(settings["decay_weight"]), 0.0), 0.8)
+    minimum = min(max(float(settings["decay_minimum_factor"]), 0.1), 1.0)
+    frequency_cap = max(int(settings["decay_frequency_cap"]), 1)
+
+    adjusted: list[dict[str, Any]] = []
+    for item in results:
+        enriched = dict(item)
+        raw_score = float(item.get("score") or 0.0)
+        access = access_by_id.get(str(item.get("id")))
+        count = access.effective_access_count if access else 0
+        last_accessed = _as_utc(access.last_effective_accessed_at) if access else None
+        reference = last_accessed
+        if reference is None:
+            raw_reference = item.get("updated_at") or item.get("created_at")
+            if isinstance(raw_reference, str):
+                try:
+                    reference = datetime.fromisoformat(raw_reference.replace("Z", "+00:00"))
+                    reference = _as_utc(reference)
+                except ValueError:
+                    reference = None
+        age_days = max((now - reference).total_seconds() / 86400.0, 0.0) if reference else half_life_days * 4
+        freshness = math.pow(0.5, age_days / half_life_days)
+        frequency = math.log1p(min(count, frequency_cap)) / math.log1p(frequency_cap)
+        heat = 0.7 * freshness + 0.3 * frequency
+        factor = max(minimum, (1.0 - weight) + weight * heat)
+        enriched["raw_score"] = round(raw_score, 6)
+        enriched["decay_score"] = round(raw_score * factor, 6)
+        enriched["decay_factor"] = round(factor, 6)
+        enriched["effective_access_count"] = count
+        enriched["last_effective_accessed_at"] = last_accessed.isoformat() if last_accessed else None
+        enriched["exposure_count"] = access.exposure_count if access else 0
+        enriched["score"] = enriched["decay_score"]
+        adjusted.append(enriched)
+    adjusted.sort(key=lambda item: (float(item.get("score") or 0), str(item.get("id") or "")), reverse=True)
+    return adjusted
+
+
+def memory_versions_hash(versions: dict[str, str]) -> str:
+    payload = "\n".join(f"{key}\0{versions[key]}" for key in sorted(versions))
+    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
