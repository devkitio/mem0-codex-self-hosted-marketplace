+def _backup_root() -> Path:
+    root = Path(os.environ.get("MEM0_BACKUP_ROOT", "/app/backups")).resolve()
+    root.mkdir(parents=True, exist_ok=True)
+    return root
+
+
+def _write_private_json(path: Path, payload: dict[str, Any]) -> tuple[int, str]:
+    encoded = json.dumps(payload, ensure_ascii=False, indent=2, default=str, allow_nan=False).encode("utf-8")
+    temporary = path.with_suffix(".tmp")
+    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    try:
+        with os.fdopen(descriptor, "wb") as stream:
+            stream.write(encoded)
+            stream.flush()
+            os.fsync(stream.fileno())
+        temporary.replace(path)
+    finally:
+        if temporary.exists():
+            temporary.unlink()
+    return len(encoded), hashlib.sha256(encoded).hexdigest()
+
+
+def _execute_backup(job_id: uuid.UUID) -> dict[str, Any]:
+    memories = list_memory_items(MAX_BACKUP_ITEMS + 1)
+    if len(memories) > MAX_BACKUP_ITEMS:
+        raise RuntimeError(f"记忆数量超过 {MAX_BACKUP_ITEMS} 条，无法生成完整备份。")
+    _update_job(job_id, progress=45)
+    with SessionLocal() as db:
+        categories = [row.name for row in db.scalars(select(Category).order_by(Category.name)).all()]
+        settings = {}
+        governance = db.get(Settings, "memory_governance")
+        if governance is not None:
+            settings["memory_governance"] = json.loads(governance.value)
+    payload = {
+        "schema_version": BACKUP_SCHEMA,
+        "created_at": _utcnow().isoformat(),
+        "memories": memories,
+        "categories": categories,
+        "settings": settings,
+    }
+    timestamp = _utcnow().strftime("%Y%m%dT%H%M%SZ")
+    filename = f"mem0-backup-{timestamp}-{job_id.hex[:8]}.json"
+    size, digest = _write_private_json(_backup_root() / filename, payload)
+    _update_job(job_id, progress=90)
+    settings_values = get_governance_settings()
+    retention = max(1, min(int(settings_values.get("backup_retention", 14)), 100))
+    backups = sorted(_backup_root().glob("mem0-backup-*.json"), key=lambda item: item.stat().st_mtime, reverse=True)
+    for stale in backups[retention:]:
+        if stale.is_file() and not stale.is_symlink():
+            stale.unlink()
+    with SessionLocal() as db:
+        save_governance_settings({"backup_last_run_at": _utcnow().isoformat()}, db)
+    return {"filename": filename, "memories": len(memories), "size": size, "sha256": digest}
+
+
+def list_backups() -> list[dict[str, Any]]:
+    output = []
+    for path in sorted(_backup_root().glob("mem0-backup-*.json"), key=lambda item: item.stat().st_mtime, reverse=True):
+        if not path.is_file() or path.is_symlink() or not BACKUP_FILE_PATTERN.fullmatch(path.name):
+            continue
+        stat = path.stat()
+        output.append(
+            {
+                "filename": path.name,
+                "size": stat.st_size,
+                "created_at": datetime.fromtimestamp(stat.st_mtime, timezone.utc).isoformat(),
+            }
+        )
+    return output
+
+
+def load_backup(filename: str) -> dict[str, Any]:
+    if not BACKUP_FILE_PATTERN.fullmatch(filename):
+        raise HTTPException(status_code=400, detail="备份文件名无效。")
+    path = (_backup_root() / filename).resolve()
+    if path.parent != _backup_root() or not path.is_file() or path.is_symlink():
+        raise HTTPException(status_code=404, detail="备份文件不存在。")
+    if path.stat().st_size > MAX_BACKUP_BYTES:
+        raise HTTPException(status_code=413, detail="备份文件超过恢复大小限制。")
+    payload = json.loads(path.read_text(encoding="utf-8"))
+    if payload.get("schema_version") != BACKUP_SCHEMA or not isinstance(payload.get("memories"), list):
+        raise HTTPException(status_code=422, detail="备份文件格式无效。")
+    if len(payload["memories"]) > MAX_BACKUP_ITEMS:
+        raise HTTPException(status_code=422, detail=f"备份最多允许包含 {MAX_BACKUP_ITEMS} 条记忆。")
+    return payload
+
