+class WorkbenchSearch(BaseModel):
+    query: str = Field(..., min_length=1, max_length=10000)
+    user_id: str | None = Field(None, max_length=128)
+    agent_id: str | None = Field(None, max_length=128)
+    run_id: str | None = Field(None, max_length=128)
+    project_id: str | None = Field(None, max_length=64)
+    memory_type: str | None = Field(None, max_length=64)
+    category: str | None = Field(None, max_length=80)
+    metadata: dict[str, Any] = Field(default_factory=dict)
+    created_from: datetime | None = None
+    created_to: datetime | None = None
+    top_k: int = Field(20, ge=1, le=100)
+    threshold: float = Field(0.1, ge=0, le=1)
+    rerank: bool = False
+    explain: bool = True
+    show_expired: bool = False
+    search_mode: Literal["hybrid", "vector"] = "hybrid"
+    final_score_threshold: float | None = Field(None, ge=0, le=1)
