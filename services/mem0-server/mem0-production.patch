+    counts = dict(db.execute(select(MemoryFeedback.verdict, func.count()).group_by(MemoryFeedback.verdict)).all())
+    total = sum(counts.values())
+    return {
+        "results": items,
+        "summary": {
+            "total": total,
+            "correct": counts.get("correct", 0),
+            "useless": counts.get("useless", 0),
+            "critical_error": counts.get("critical_error", 0),
+            "needs_review": counts.get("useless", 0) + counts.get("critical_error", 0),
