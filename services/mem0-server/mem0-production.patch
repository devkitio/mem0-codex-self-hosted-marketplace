+@router.post("/batch/{operation_id}/execute")
+def execute_batch(
+    operation_id: uuid.UUID,
+    body: ExecuteOperationRequest,
+    user: User = Depends(require_admin),
+    db: Session = Depends(get_db),
+):
+    operation = db.scalar(
+        select(MemoryOperation).where(MemoryOperation.id == operation_id).with_for_update()
+    )
+    if operation is None or operation.kind != "batch":
+        raise HTTPException(status_code=404, detail="批量操作不存在")
+    if operation.status == "executing" and operation.expires_at < _utcnow():
+        operation.status = "partial"
+        operation.result = operation.result or {"执行中断": True}
+        db.commit()
+        raise HTTPException(status_code=409, detail="上次批量执行已中断，请重新生成预览并核对实际结果")
+    if operation.status != "preview":
+        raise HTTPException(status_code=409, detail="该批量操作已处理")
+    if operation.expires_at < _utcnow():
+        operation.status = "expired"
+        db.commit()
+        raise HTTPException(status_code=409, detail="批量操作预览已过期")
+    if operation.preview_hash != body.preview_hash:
+        raise HTTPException(status_code=409, detail="预览校验码不匹配")
+    versions = dict(operation.targets.get("versions") or {})
+    current_items: dict[str, dict[str, Any]] = {}
+    for memory_id, version in versions.items():
+        item = _get_memory(memory_id)
+        if item is None or _memory_version(item) != version:
+            operation.status = "cancelled"
+            operation.result = {"冲突记忆": memory_id}
+            db.commit()
+            raise HTTPException(status_code=409, detail="记忆在预览后已变化，请重新生成预览")
+        current_items[memory_id] = item
+    operation.status = "executing"
+    db.commit()
+
+    succeeded: list[str] = []
+    failed: list[dict[str, str]] = []
+    changes = dict(operation.request_data)
+    for memory_id, item in current_items.items():
+        try:
+            with _memory_lock(memory_id):
+                locked_item = _get_memory(memory_id)
+                if locked_item is None or _memory_version(locked_item) != versions[memory_id]:
+                    raise RuntimeError("记忆在执行前发生变化")
+                params: dict[str, Any] = {"memory_id": memory_id}
+                if changes.get("text_find") is not None:
+                    params["data"] = str(locked_item.get("memory") or "").replace(
+                        str(changes["text_find"]), str(changes.get("text_replace") or "")
+                    )
+                metadata = _metadata_for_update(locked_item, changes)
+                if metadata is not None:
+                    params["metadata"] = metadata
+                if changes.get("expiration_date_set"):
+                    params["expiration_date"] = changes.get("expiration_date")
+                get_memory_instance().update(**params)
+            succeeded.append(memory_id)
+            log_memory_activity(
+                "batch_update",
+                user=user,
+                memory_id=memory_id,
+                details={"修改字段": _preview_change(item, changes)["changed_fields"]},
+            )
+        except Exception as exc:
+            failed.append({"memory_id": memory_id, "error_type": type(exc).__name__})
+            log_memory_activity(
+                "batch_update",
+                user=user,
+                memory_id=memory_id,
+                success=False,
+                details={"错误类型": type(exc).__name__},
+            )
+    operation = db.get(MemoryOperation, operation_id)
+    operation.status = "partial" if failed else "completed"
+    operation.result = {"succeeded": succeeded, "failed": failed}
+    db.commit()
+    return {"status": operation.status, **operation.result}
+
