+@app.post("/internal/mcp/query", include_in_schema=False)
+def internal_mcp_query(
+    query: InternalMemoryQuery,
+    _internal=Depends(_verify_internal_request),
+):
+    try:
+        rows, partial = _query_internal_rows(query)
+        reverse = query.sort_order == "desc"
+        rows.sort(key=lambda item: (item.get(query.sort_by) is not None, item.get(query.sort_by) or "", item.get("id") or ""), reverse=reverse)
+        count = len(rows)
+        start = (query.page - 1) * query.page_size
+        end = start + query.page_size
+        return {
+            "results": rows[start:end],
+            "count": count,
+            "next": query.page + 1 if end < count else None,
+            "previous": query.page - 1 if query.page > 1 and start < count else None,
+            "partial": partial,
+            "result_hash": _result_hash(rows),
+            "scanned": query.scan_limit if partial else None,
+        }
+    except HTTPException:
+        raise
+    except (ValueError, Mem0ValidationError) as exc:
+        raise _client_error(exc)
+    except Exception:
+        raise upstream_error()
+
