@@ -183,0 +184,52 @@ function validateSearchParams(threshold?: number, topK?: number): void {
+const CANONICAL_ALIASES: Record<string, string> = {
+  schemaVersion: "schema_version",
+  memoryType: "memory_type",
+  projectId: "project_id",
+  sessionId: "session_id",
+  runId: "run_id",
+  observedAt: "observed_at",
+  validFrom: "valid_from",
+  validTo: "valid_to",
+  sourceType: "source_type",
+  sourceId: "source_id",
+  sourceMessageId: "source_message_id",
+  conflictKey: "conflict_key",
+  profileKey: "profile_key",
+  supersedesId: "supersedes_id",
+};
+
+export function canonicalMemoryPayload(
+  metadata: Record<string, any>,
+  data: string,
+  createdAt?: string,
+  updatedAt?: string,
+  memoryId = "",
+): Record<string, any> {
+  const payload = { ...metadata };
+  for (const [camel, snake] of Object.entries(CANONICAL_ALIASES)) {
+    if (payload[snake] === undefined && payload[camel] !== undefined) {
+      payload[snake] = payload[camel];
+    }
+    delete payload[camel];
+  }
+  const created = createdAt ?? payload.created_at ?? new Date().toISOString();
+  const updated = updatedAt ?? payload.updated_at ?? created;
+  delete payload.createdAt;
+  delete payload.updatedAt;
+  delete payload.textLemmatized;
+  delete payload.attributedTo;
+  payload.data = data;
+  payload.schema_version = Number(payload.schema_version ?? 2);
+  payload.status = String(payload.status ?? "active");
+  payload.confidence = payload.confidence ?? null;
+  payload.source_type = payload.source_type ?? payload.source ?? "legacy";
+  payload.created_at = created;
+  payload.updated_at = updated;
+  payload.text_lemmatized = lemmatizeForBm25(data);
+  payload.content_hash = createHash("sha256").update(data).digest("hex");
+  payload.payload_version = createHash("sha256")
+    .update(`${memoryId}\0${updated}\0${data}`)
+    .digest("hex");
+  return payload;
+}
+
