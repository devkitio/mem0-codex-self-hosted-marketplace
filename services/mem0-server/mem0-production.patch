+@app.post("/internal/mcp/entities", include_in_schema=False)
+def internal_mcp_entities(
+    entity_query: InternalEntityQuery,
+    _internal=Depends(_verify_internal_request),
+):
+    query = InternalMemoryQuery(
+        project_id=entity_query.project_id,
+        include_global=False,
+        all_projects=entity_query.project_id is None,
+        show_expired=entity_query.show_expired,
+        scan_limit=entity_query.scan_limit,
+        page=1,
+        page_size=1,
+    )
+    try:
+        rows, partial = _query_internal_rows(query)
+        entities: Dict[tuple[str, str, Optional[str]], Dict[str, Any]] = {}
+        for item in rows:
+            metadata = _internal_metadata(item)
+            item_project = metadata.get("project_id")
+            updated_at = item.get("updated_at") or item.get("created_at")
+            if isinstance(item_project, str) and item_project and entity_query.entity_type in (None, "project"):
+                key = ("project", item_project, None)
+                entity = entities.setdefault(
+                    key,
+                    {"type": "project", "id": item_project, "memory_count": 0, "updated_at": None},
+                )
+                entity["memory_count"] += 1
+                if isinstance(updated_at, str) and (entity["updated_at"] is None or updated_at > entity["updated_at"]):
+                    entity["updated_at"] = updated_at
+            run_id = item.get("run_id")
+            if isinstance(run_id, str) and run_id and entity_query.entity_type in (None, "run"):
+                run_project = item_project if isinstance(item_project, str) else None
+                key = ("run", run_id, run_project)
+                entity = entities.setdefault(
+                    key,
+                    {
+                        "type": "run",
+                        "id": run_id,
+                        "project_id": run_project,
+                        "memory_count": 0,
+                        "updated_at": None,
+                    },
+                )
+                entity["memory_count"] += 1
+                if isinstance(updated_at, str) and (entity["updated_at"] is None or updated_at > entity["updated_at"]):
+                    entity["updated_at"] = updated_at
+        results = sorted(
+            entities.values(),
+            key=lambda item: (item["type"], item.get("project_id") or "", item["id"]),
+        )
+        return {"results": results, "count": len(results), "partial": partial}
+    except HTTPException:
+        raise
+    except (ValueError, Mem0ValidationError) as exc:
+        raise _client_error(exc)
+    except Exception:
+        raise upstream_error()
+
+
+@app.post("/internal/mcp/memory", include_in_schema=False)
+def internal_mcp_memory(
+    request: InternalMemoryAction,
+    _internal=Depends(_verify_internal_request),
+):
+    memory_id = str(request.memory_id)
+    try:
+        with _memory_operation_lock(memory_id):
+            current = get_memory_instance().get(memory_id)
+            if not isinstance(current, dict) or not _matches_managed_scope(current, request.project_id):
+                raise HTTPException(status_code=404, detail="受管记忆不存在")
+            if request.action == "get":
+                record_memory_access([memory_id])
+                log_memory_activity("read", memory_id=memory_id, source="mcp")
+                return {"memory": current}
+            if request.action == "history":
+                log_memory_activity("history", memory_id=memory_id, source="mcp")
+                return {"results": _clean_history(get_memory_instance().history(memory_id=memory_id))}
+            if request.action == "delete":
+                operation_id = begin_mutation(
+                    "delete", memory_id=memory_id, before_payload=current, reason="MCP 删除"
+                )
+                get_memory_instance().delete(memory_id=memory_id)
+                try:
+                    complete_mutation(operation_id, {**current, "id": memory_id}, status="deleted")
+                except Exception as sync_error:
+                    fail_mutation(operation_id, sync_error)
+                    raise HTTPException(
+                        status_code=503,
+                        detail={"status": "partial", "message": "向量记忆已删除，治理目录同步失败"},
+                    ) from sync_error
+                log_memory_activity("delete", memory_id=memory_id, source="mcp")
+                return {"deleted": True, "memory_id": memory_id}
+
+            fields_set = request.model_fields_set
+            if not fields_set.intersection({"text", "metadata", "expiration_date"}):
+                raise HTTPException(status_code=400, detail="未提供更新字段")
+            params: Dict[str, Any] = {"memory_id": memory_id}
+            settings = get_governance_settings()
+            if "text" in fields_set:
+                if not isinstance(request.text, str) or not request.text.strip() or len(request.text) > 50000:
+                    raise HTTPException(status_code=400, detail="记忆正文无效")
+                protected_text, _findings = protect_sensitive_value(request.text.strip(), settings)
+                conflicts = detect_memory_conflicts(
+                    str(protected_text),
+                    {"project_id": request.project_id} if request.project_id else {},
+                )
+                conflicts = [item for item in conflicts if item.get("memory_id") != memory_id]
+                if conflicts and settings.get("conflict_action") == "block":
+                    raise HTTPException(
+                        status_code=409,
+                        detail={"message": "修改内容与现有记忆可能冲突。", "conflicts": conflicts},
+                    )
+                params["data"] = protected_text
+            if "metadata" in fields_set:
+                changes = _validate_internal_metadata_changes(request.metadata)
+                changes, _metadata_findings = protect_sensitive_value(changes, settings)
+                params["metadata"] = _merge_managed_metadata(current, request.project_id, changes)
+            if "expiration_date" in fields_set:
+                params["expiration_date"] = request.expiration_date
+            operation_id = begin_mutation(
+                "update", memory_id=memory_id, before_payload=current, reason="MCP 更新"
+            )
+            try:
+                get_memory_instance().update(**params)
+            except Exception as update_error:
+                fail_mutation(operation_id, update_error)
+                raise
+            updated = get_memory_instance().get(memory_id)
+            if not isinstance(updated, dict) or not _matches_managed_scope(updated, request.project_id):
+                raise RuntimeError("Mem0 更新记忆后返回无效响应")
+            try:
+                complete_mutation(operation_id, updated)
+            except Exception as sync_error:
+                fail_mutation(operation_id, sync_error)
+                raise HTTPException(
+                    status_code=503,
+                    detail={"status": "partial", "message": "记忆已更新，治理目录同步失败"},
+                ) from sync_error
+            log_memory_activity(
+                "update",
+                memory_id=memory_id,
+                source="mcp",
+                details={"修改字段": sorted(fields_set.intersection({"text", "metadata", "expiration_date"}))},
+            )
+            return {"memory": updated}
+    except HTTPException:
+        raise
+    except (ValueError, Mem0ValidationError) as exc:
+        raise _client_error(exc)
+    except Exception as exc:
+        log_memory_activity(
+            request.action,
+            memory_id=memory_id,
+            source="mcp",
+            success=False,
+            details={"错误类型": type(exc).__name__},
+        )
+        raise upstream_error()
+
