+@router.put("/memories/{memory_id}/feedback")
+def save_feedback(
+    memory_id: str,
+    body: FeedbackRequest,
+    user: User = Depends(require_editor),
+    db: Session = Depends(get_db),
+):
+    current = _get_memory(memory_id)
+    if current is None:
+        raise HTTPException(status_code=404, detail="记忆不存在")
+    metadata = _metadata(current)
+    project_id = metadata.get("project_id")
+    assert_project_access(user, str(project_id) if project_id else None, write=True)
+    catalog = db.get(MemoryCatalog, memory_id)
+    current_version = catalog.payload_version if catalog else memory_payload_version(current)
+    if body.payload_version and body.payload_version != current_version:
+        raise HTTPException(status_code=409, detail="记忆版本已变化，请重新查看后再反馈")
+    actor_key = str(_actor_id(user) or "system")
+    row = db.scalar(
+        select(MemoryFeedback).where(
+            MemoryFeedback.memory_id == memory_id,
+            MemoryFeedback.payload_version == current_version,
+            MemoryFeedback.actor_key == actor_key,
+        )
+    )
+    if row is None:
+        row = MemoryFeedback(
+            memory_id=memory_id,
+            payload_version=current_version,
+            actor_key=actor_key,
+            project_id=str(project_id) if project_id else None,
+            created_by=_actor_id(user),
+        )
+        db.add(row)
+    row.verdict = body.verdict
+    row.reason = body.reason
+    db.commit()
+    db.refresh(row)
+    record_effective_access(
+        [memory_id],
+        event_type="feedback",
+        retrieval_id=body.retrieval_id,
+        project_id=str(project_id) if project_id else None,
+        source="dashboard",
+        actor_id=_actor_id(user),
+    )
+    log_memory_activity(
+        "feedback",
+        user=user,
+        memory_id=memory_id,
+        details={"审查结论": body.verdict, "已填写原因": bool(body.reason)},
+    )
+    return _feedback_item(row)
